\",\"data\":[{\"id\":\"1570856853\",\"type\":\"apps\",\"href\":\"/v1/catalog/us/apps/1570856853?l=en-US\",\"attributes\":{\"distributionKind\":\"APP_STORE\",\"supportsArcade\":false,\"isFirstPartyHideableApp\":false,\"privacy\":{\"privacyTypes\":[{\"privacyType\":\"Data Not Collected\",\"identifier\":\"DATA_NOT_COLLECTED\",\"description\":\"The developer does not collect any data from this app.\",\"dataCategories\":[]}]},\"contentRatingsBySystem\":{\"appsApple\":{\"name\":\"4+\",\"value\":100,\"rank\":1}},\"deviceFamilies\":[\"iphone\",\"ipad\"],\"supportsStreamlinedBuy\":false,\"url\":\"https://apps.apple.com/us/app/blank-spaces-app/id1570856853\",\"userRating\":{\"value\":3.5,\"ratingCount\":206,\"ratingCountList\":[54,14,15,17,106],\"ariaLabelForRatings\":\"3.5 stars\"},\"firstVersionSupportingInAppPurchaseApi\":\"1.0\",\"name\":\"Blank Spaces App\",\"genreDisplayName\":\"Productivity\",\"isPreorder\":false,\"artistName\":\"Jeffrey Waters\",\"isIOSBinaryMacOSCompatible\":false,\"reviewsRestricted\":false,\"requirementsByDeviceFamily\":{\"ipad\":{\"deviceFamily\":\"iPad\",\"requirementString\":\"Requires iPadOS 16.0 or later.\"},\"iphone\":{\"deviceFamily\":\"iPhone\",\"requirementString\":\"Requires iOS 16.0 or later.\"},\"realityDevice\":{\"deviceFamily\":\"Apple Vision\",\"requirementString\":\"Requires visionOS 1.0 or later.\"}},\"platformAttributes\":{\"ios\":{\"minimumMacOSVersion\":\"13.0\",\"description\":{\"standard\":\"Blank Spaces is a minimal home screen launcher that eliminates distraction from your phone.  We believe that technology should empower us, not take away our attention.\\n\\n• Simplify your home screen\\nThis small, beautiful widget lives on your home screen and gives you access to your most important apps without the clutter.\\n\\n• Take back your focus\\nBlank Spaces mutes all sources of distraction, including badges and app icons.  Get back to using your phone as a tool and focusing on what matters in life.\\n\\n• Easy to use\\nThe app is designed to be completely intuitive, and the widget can be installed in 60 seconds.\\n\\n• Completely secure\\nWe believe in openness, privacy, and 100% data ownership.  See our privacy policy at blankspaces.app/privacy.\\n\\n\\nBLANK SPACES SUBSCRIPTION\\n\\nBlank Spaces comes with a 7-day free trial.  After the free trial period ends you will need to subscribe.\\n\\nYou can subscribe to Blank Spaces, choosing from the following plans:\\n\\n• 1 month\\n\\n• 1 year\\n\\n• Lifetime\\n\\nThe subscription automatically renews unless auto-renewal is turned off at least 24 hours before the end of the current period.\\n\\nPayment will be charged to your iTunes account at confirmation of purchase.\\n\\nAccount will be charged for renewal within 24 hours of the end of the current period, and the cost of renewal will be provided.\\n\\n\\nFor more information:\\n\\nTerms of Use - www.blankspaces.app/terms\\n\\nPrivacy Policy - www.blankspaces.app/privacy\\n\\nJoin Us - www.blankspaces.app/cult\"},\"isStandaloneWithCompanionForWatchOS\":false,\"isAppleWatchSupported\":false,\"requiredCapabilitiesForRealityDevice\":\"arm64 \",\"versionHistory\":[{\"versionDisplay\":\"1.104\",\"releaseNotes\":\"Hi new friends.  We're making small changes to improve your detox experience:\\n\\n• Turned on 'family sharing' :)\\n• Weather and calendar widgets launch the apps directly\\n• Fixes to search functionality in the app\",\"releaseDate\":\"2024-02-19\",\"releaseTimestamp\":\"2024-02-19T15:23:59Z\"},{\"versionDisplay\":\"1.103.2\",\"releaseNotes\":\"Hi new friends.  We're making small changes to improve your detox experience:\\n\\n• Ability to use custom fonts\\n• New analog clock top widget\\n• Option for widget colors to adapt between light and dark modes\\n• Weather and calendar widgets launch the apps directly\\n• Weather widget location fix\\n• Shortcuts tool fix\",\"releaseDate\":\"2024-01-26\",\"releaseTimestamp\":\"2024-01-26T14:18:27Z\"},{\"versionDisplay\":\"1.103\",\"releaseNote