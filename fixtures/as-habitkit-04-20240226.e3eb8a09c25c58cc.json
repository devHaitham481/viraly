ionKind\":\"APP_STORE\",\"supportsArcade\":false,\"familyShareEnabledDate\":\"0001-04-23T00:00:00Z\",\"isFirstPartyHideableApp\":false,\"privacy\":{\"privacyTypes\":[{\"privacyType\":\"Data Linked to You\",\"identifier\":\"DATA_LINKED_TO_YOU\",\"description\":\"The following data may be collected and linked to your identity:\",\"dataCategories\":[{\"dataCategory\":\"Purchases\",\"identifier\":\"PURCHASES\"}]},{\"privacyType\":\"Data Not Linked to You\",\"identifier\":\"DATA_NOT_LINKED_TO_YOU\",\"description\":\"The following data may be collected but it is not linked to your identity:\",\"dataCategories\":[{\"dataCategory\":\"Diagnostics\",\"identifier\":\"DIAGNOSTICS\"}]}]},\"contentRatingsBySystem\":{\"appsApple\":{\"name\":\"4+\",\"value\":100,\"rank\":1}},\"deviceFamilies\":[\"iphone\",\"ipod\"],\"supportsStreamlinedBuy\":false,\"url\":\"https://apps.apple.com/us/app/habit-tracker-habitkit/id6443918070\",\"usesLocationBackgroundMode\":false,\"userRating\":{\"value\":4.9,\"ratingCount\":184,\"ratingCountList\":[2,1,2,7,172],\"ariaLabelForRatings\":\"4.9 stars\"},\"firstVersionSupportingInAppPurchaseApi\":\"1.0\",\"name\":\"Habit Tracker - HabitKit\",\"genreDisplayName\":\"Productivity\",\"isPreorder\":false,\"isIOSBinaryMacOSCompatible\":true,\"artistName\":\"Sebastian Roehl\",\"reviewsRestricted\":false,\"sellerLabel\":\"Seller\",\"requirementsByDeviceFamily\":{\"ipod\":{\"deviceFamily\":\"iPod touch\",\"requirementString\":\"Requires iOS 14.0 or later.\"},\"iphone\":{\"deviceFamily\":\"iPhone\",\"requirementString\":\"Requires iOS 14.0 or later.\"},\"mac\":{\"deviceFamily\":\"Mac\",\"requirementString\":\"Requires macOS 11.0 or later and a Mac with Apple M1 chip or later.\"},\"realityDevice\":{\"deviceFamily\":\"Apple Vision\",\"requirementString\":\"Requires visionOS 1.0 or later.\"}},\"hasEula\":false,\"platformAttributes\":{\"ios\":{\"seller\":\"Sebastian Roehl\",\"copyright\":\"© 2023 Sebastian Röhl\",\"minimumMacOSVersion\":\"11.0\",\"description\":{\"standard\":\"HabitKit is the perfect app for anyone looking to form new habits or break old ones. With HabitKit, you can track your progress with beautiful tile-based grid charts. Whether you're trying to quit smoking, eat healthier, or exercise more, HabitKit can help you achieve your goals. You can customize your dashboard by adjusting colors, icons and descriptions. Draw motivation from growing the amount of colored tiles on your habit dashboard.\\n\\n---\\n\\nCREATE HABITS\\nAdd your habits you want to track in a fast and easy way. Provide a name, description, icon and color and you're good to go.\\n\\nDASHBOARD\\nAll your habits are displayed on your dashboard represented by a cool looking grid chart. Every filled out square show a day where you kept up with your habit.\\n\\nCALENDAR\\nThe calendar provides a fast and easy way to manage past completions. Simply tap a day to remove or add a completion.\\n\\nARCHIVE\\nDo you need a break from a habit and don't want to clutter your dashboard with it? Just archive it and restore it at a later point from the menu.\\n\\nIMPORT AND EXPORT\\nSwitching phones and don't want to lose your data? Export your data to a file, save it wherever you want and restore it at a later point of time.\\n\\nPRIVACY FOCUSED\\nAll your data belongs to you and stays on your phone. No sign-in. No servers. No cloud.\\n\\n---\\n\\nTerms of Use: https://www.habitkit.app/tos/\\nPrivacy Policy: https://www.habitkit.app/privacy/\"},\"isStandaloneWithCompanionForWatchOS\":false,\"isAppleWatchSupported\":false,\"is32bitOnly\":false,\"requiredCapabilitiesForRealityDevice\":\"arm64 \",\"websiteUrl\":\"https://www.habitkit.app\",\"versionHistory\":[{\"versionDisplay\":\"1.6.8\",\"releaseNotes\":\"This version includes important bugfixes and performance improvements.\",\"releaseDate\":\"2024-01-07\",\"releaseTimestamp\":\"2024-01-07T15:04:15Z\"},{\"versionDisplay\":\"1.6.7\",\"releaseNotes\":\"This version includes important bugfixes and performance improvements.\",\"releaseDate\":\"2024-01-04\",\"releaseTimestamp\":\"2024-01-04T14:45:11Z\"},{\"versionDisplay\":\"1.6.6\",\"releaseNotes\":\"This version includes important bugfixes and performance improvements.\",\"releaseDate\":\"2024-01-01\",\"releaseTimestamp\":\"2024-01-01T11:02:04Z\"},{\"versionDisplay\":\"1.6.5\",\"releaseNotes\":\"This version includes important bugfixes and performance improvements.\",\"releaseDate\":\"2023-12-30\",\"releaseTimestamp\":\"2023-12-30T21:48:49Z\"},{\"versionDisplay\":\"1.6.4\",\"releaseNotes\":\"Introducing the new Annual Recap feature: Look back on your year with \\\"HabitKit Wrapped\\\" and get inspired by your progress.\",\"releaseDate\":\"2023-12-15\",\"releaseTimestamp\":\"2023-12-15T07:11:05Z\"},{\"versionDisplay\":\"1.6.3\",\"releaseNotes\":\"This version includes important bugfixes and performance improvements.\",\"releaseDate\":\"2023-12-05\",\"releaseTimestamp\":\"2023-12-05T19:37:10Z\"},{\"versionDisplay\":\"1.6.2\",\"releaseNotes\":\"This version includes important bugfixes and performance improvements.\",\"releaseDate\":\"2023-12-02\",\"releaseTimestamp\":\"2023-12-02T10:19:21Z\"},{\"versionDisplay\":\"1.6.1\",\"releaseNotes\":\"This version includes important bugfixes and performance improvements.\",\"releaseDate\":\"2023-11-25\",\"releaseTimestamp\":\"2023-11-25T16:36:27Z\"},{\"versionDisplay\":\"1.6.0\",\"releaseNotes\":\"This update includes multiple new features:\\n\\n- Multiple Completions Per Day: You can set a daily completion goal (e.g. 3 per day) for your habits.\\n- Widget Pure Black Dark Mode: The pure black dark mode applies to your widgets now.\\n- Overhauled Calendar: The calendar view was overhauled to accommodate all new changes.\\n- Charts Addition: The charts page will display information about the selected habit.\",\"releaseDate\":\"2023-11-24\",\"releaseTimestamp\":\"2023-11-24T05:28:44Z\"},{\"versionDisplay\":\"1.5.9\",\"releaseNotes\":\"This version includes important bugfixes and performance improvements.\",\"releaseDate\":\"2023-08-25\",\"releaseTimestamp\":\"2023-08-25T06:16:58Z\"},{\"versionDisplay\":\"1.5.8\",\"releaseNotes\":\"This version includes important bugfixes and performance improvements.\",\"releaseDate\":\"2023-07-22\",\"releaseTimestamp\":\"2023-07-22T14:06:11Z\"},{\"versionDisplay\":\"1.5.7\",\"releaseNotes\":\"This version includes important bugfixes and performance improvements.\",\"releaseDate\":\"2023-07-14\",\"releaseTimestamp\":\"2023-07-14T05:34:44Z\"},{\"versionDisplay\":\"1.5.6\",\"releaseNotes\":\"This version includes important bugfixes and performance improvements.\\n\",\"releaseDate\":\"2023-07-12\",\"releaseTimestamp\":\"2023-07-12T13:47:42Z\"},{\"versionDisplay\":\"1.5.5\",\"releaseNotes\":\"This version includes important bugfixes and performance improvements.\",\"releaseDate\":\"2023-06-23\",\"releaseTimestamp\":\"2023-06-23T19:23:53Z\"},{\"versionDisplay\":\"1.5.4\",\"releaseNotes\":\"This version includes important bugfixes and performance improvements.\",\"releaseDate\":\"2023-06-23\",\"releaseTimestamp\":\"2023-06-23T06:40:48Z\"},{\"versionDisplay\":\"1.5.3\",\"releaseNotes\":\"This version includes important bugfixes and performance improvements.\",\"releaseDate\":\"2023-06-17\",\"releaseTimestamp\":\"2023-06-17T05:03:02Z\"},{\"versionDisplay\":\"1.5.2\",\"releaseNotes\":\"This version includes important bugfixes and performance improvements.\",\"releaseDate\":\"2023-06-09\",\"releaseTimestamp\":\"2023-06-09T19:52:35Z\"},{\"versionDisplay\":\"1.5.1\",\"releaseNotes\":\"This version includes important bugfixes and performance improvements.\",\"releaseDate\":\"2023-06-02\",\"releaseTimestamp\":\"2023-06-02T16:09:04Z\"},{\"versionDisplay\":\"1.5.0\",\"releaseNotes\":\"This release includes a new statistics page and an optional pure black dark mode.\",\"releaseDate\":\"2023-06-02\",\"releaseTimestamp\":\"2023-06-02T06:13:49Z\"},{\"versionDisplay\":\"1.4.5\",\"releaseNotes\":\"This release includes several bug fixes and p