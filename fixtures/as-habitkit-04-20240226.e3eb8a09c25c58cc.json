y\":\"Location\",\"identifier\":\"LOCATION\"},{\"dataCategory\":\"Identifiers\",\"identifier\":\"IDENTIFIERS\"},{\"dataCategory\":\"Usage Data\",\"identifier\":\"USAGE_DATA\"},{\"dataCategory\":\"Diagnostics\",\"identifier\":\"DIAGNOSTICS\"}]},{\"privacyType\":\"Data Linked to You\",\"identifier\":\"DATA_LINKED_TO_YOU\",\"description\":\"The following data may be collected and linked to your identity:\",\"dataCategories\":[{\"dataCategory\":\"Location\",\"identifier\":\"LOCATION\"},{\"dataCategory\":\"Identifiers\",\"identifier\":\"IDENTIFIERS\"},{\"dataCategory\":\"Usage Data\",\"identifier\":\"USAGE_DATA\"},{\"dataCategory\":\"Diagnostics\",\"identifier\":\"DIAGNOSTICS\"}]},{\"privacyType\":\"Data Not Linked to You\",\"identifier\":\"DATA_NOT_LINKED_TO_YOU\",\"description\":\"The following data may be collected but it is not linked to your identity:\",\"dataCategories\":[{\"dataCategory\":\"Diagnostics\",\"identifier\":\"DIAGNOSTICS\"}]}]},\"contentRatingsBySystem\":{\"appsApple\":{\"name\":\"4+\",\"value\":100,\"rank\":1}},\"deviceFamilies\":[\"iphone\",\"ipod\"],\"supportsStreamlinedBuy\":false,\"url\":\"https://apps.apple.com/us/app/habit-tracker-your-goals/id1471303896\",\"userRating\":{\"value\":4.3,\"ratingCount\":102,\"ratingCountList\":[9,3,6,18,66],\"ariaLabelForRatings\":\"4.3 stars\"},\"name\":\"Habit Tracker - Your Goals\",\"genreDisplayName\":\"Productivity\",\"isPreorder\":false,\"isIOSBinaryMacOSCompatible\":false,\"artistName\":\"Robin DREUX\",\"reviewsRestricted\":false,\"requirementsByDeviceFamily\":{\"iphone\":{\"deviceFamily\":\"iPhone\",\"requirementString\":\"Requires iOS 12.0 or later.\"},\"ipod\":{\"deviceFamily\":\"iPod touch\",\"requirementString\":\"Requires iOS 12.0 or later.\"},\"realityDevice\":{\"deviceFamily\":\"Apple Vision\",\"requirementString\":\"Requires visionOS 1.0 or later.\"}},\"platformAttributes\":{\"ios\":{\"minimumMacOSVersion\":\"11.0\",\"description\":{\"standard\":\"Habits helps you keeping track and achieving your goals, by allowing you to customize them the most while keeping a simple and intuitive UI and user experience. \\nSeveral graphs and statistics will help you understanding and analyzing your results!\\n\\n== Handling simple habits ==\\n\\nPracticing every three days, playing the guitar four times a week, read a book every week end or revising your exams every day : create and save these habits in a matter of seconds, and update them with a simple tap.\\n\\n== Handling progressive habits ==\\n\\nHave you drunk your daily liter and a half of water? \\nAchieve your goals progressively by indicating your daily target, and fill your progress gradually to remember what you have already done. \\n\\n== Statistics ==\\n\\nFor every habit, you can access a statistics page containing essential data to help you understanding and improving it :\\n- The main evolution, day after day, by day, week, month, trimester or year.\\n- An immediate visual of your daily results,\\n- Your best uninterrupted streaks,\\n- And lastly, your best week days for every month.\\n\\n== Notifications ==\\n\\nYou can setup notifications for every habit as a reminder. \\n\\n== Your personal data ==\\n\\nAbsolutely none of your personal data created with this application will be sent to any server, it will stay stored in your phone only. \\nHowever, we grant you the ability to export it and keep a backup of your data, to re-import it if needed.  \\n\\n\\nThank you for using Habits! Don’t hesitate contacting us to report a problem or proposing new ideas in order to constantly improve the app, at habitude-support@robbeyroad.com\"},\"isStandaloneWithCompanionForWatchOS\":false,\"isAppleWatchSupported\":false,\"requiredCapabilitiesForRealityDevice\":\"arm64 \",\"websiteUrl\":\"https://www.robbeyroad.com\",\"versionHistory\":[{\"versionDisplay\":\"1.7.2\",\"releaseNotes\":\"Bug fixes \u0026 improvements\",\"releaseDate\":\"2023-03-08\",\"releaseTimestamp\":\"2023-03-08T17:59:23Z\"},{\"versionDisplay\":\"1.7.1\