":12926976,\"iPhone11,8\":12926976,\"iPhone15,3\":13103104,\"iPad14,4-A\":12926976,\"iPad5,4\":12926976,\"iPad13,10\":12926976,\"iPad5,3\":12926976,\"iPad5,2\":12926976,\"iPad5,1\":12926976,\"iPad6,11\":12926976,\"iPad6,12\":12926976,\"MacFamily20,1\":12926976,\"iPad12,1\":12926976,\"iPad12,2\":12926976,\"iPhone10,3\":13103104,\"iPhone10,2\":13103104,\"iPhone10,1\":12922880,\"iPhone14,3\":13103104,\"iPhone10,6\":13103104,\"iPhone14,2\":13103104,\"iPhone10,5\":13103104,\"iPhone10,4\":12922880,\"iPad13,19\":12926976,\"iPhone14,7\":13103104,\"iPad14,5-A\":12926976,\"iPhone14,6\":12922880,\"iPad14,5-B\":12926976,\"iPhone14,5\":13103104,\"iPad13,11\":12926976,\"iPhone14,4\":13103104,\"iPad13,17\":12926976,\"iPad13,18\":12926976,\"universal\":13522944,\"iPod9,1\":12922880,\"iPhone14,8\":13103104,\"iPad13,16\":12926976,\"iPad6,7\":12926976,\"iPad6,4\":12926976,\"iPad6,3\":12926976,\"iPad6,8\":12926976,\"iPad13,8\":12926976,\"iPad13,9\":12926976,\"iPad13,4\":12926976,\"iPad13,5\":12926976,\"iPad13,6\":12926976,\"iPad13,7\":12926976,\"iPad13,1\":12926976,\"iPad13,2\":12926976}},\"relationships\":{\"developer\":{\"href\":\"/v1/catalog/us/apps/1659811306/developer?l=en-US\",\"data\":[{\"id\":\"1636190558\",\"type\":\"developers\",\"href\":\"/v1/catalog/us/developers/1636190558?l=en-US\",\"attributes\":{\"genreNames\":[],\"editorialArtwork\":{},\"name\":\"Aidar Nugmanov\",\"mediaType\":\"Mobile Software Applications\",\"url\":\"https://apps.apple.com/us/developer/aidar-nugmanov/id1636190558\"}}]},\"genres\":{\"href\":\"/v1/catalog/us/apps/1659811306/genres?l=en-US\",\"data\":[{\"id\":\"6007\",\"type\":\"genres\",\"href\":\"/v1/catalog/us/genres/6007?l=en-US\",\"attributes\":{\"parentName\":\"App Store\",\"name\":\"Productivity\",\"parentId\":\"36\",\"url\":\"https://itunes.apple.com/us/genre/id6007\"}},{\"id\":\"6012\",\"type\":\"genres\",\"href\":\"/v1/catalog/us/genres/6012?l=en-US\",\"attributes\":{\"parentName\":\"App Store\",\"name\":\"Lifestyle\",\"parentId\":\"36\",\"url\":\"https://itunes.apple.com/us/genre/id6012\"}}]}}},{\"id\":\"1661833753\",\"type\":\"apps\",\"href\":\"/v1/catalog/us/apps/1661833753?l=en-US\",\"attributes\":{\"distributionKind\":\"APP_STORE\",\"supportsArcade\":false,\"isFirstPartyHideableApp\":false,\"privacy\":{\"privacyTypes\":[{\"privacyType\":\"Data Not Collected\",\"identifier\":\"DATA_NOT_COLLECTED\",\"description\":\"The developer does not collect any data from this app.\",\"dataCategories\":[]}]},\"contentRatingsBySystem\":{\"appsApple\":{\"name\":\"4+\",\"value\":100,\"rank\":1}},\"deviceFamilies\":[\"watch\",\"iphone\",\"ipod\"],\"url\":\"https://apps.apple.com/us/app/gola-goal-tracker/id1661833753\",\"userRating\":{\"value\":5,\"ratingCount\":5,\"ratingCountList\":[0,0,0,0,5],\"ariaLabelForRatings\":\"5.0 stars\"},\"watchBundleId\":\"com.modumhq.Hazi.watchkitapp\",\"firstVersionSupportingInAppPurchaseApi\":\"1.1.3\",\"name\":\"Gola - Goal Tracker\",\"genreDisplayName\":\"Productivity\",\"isPreorder\":false,\"isIOSBinaryMacOSCompatible\":false,\"artistName\":\"Modum B.V.\",\"reviewsRestricted\":false,\"requirementsByDeviceFamily\":{\"iphone\":{\"deviceFamily\":\"iPhone\",\"requirementString\":\"Requires iOS 16.0 or later.\"},\"ipod\":{\"deviceFamily\":\"iPod touch\",\"requirementString\":\"Requires iOS 16.0 or later.\"},\"watch\":{\"deviceFamily\":\"Apple Watch\",\"requirementString\":\"Requires watchOS 9.0 or later.\"}},\"minimumWatchOSVersion\":\"9.0\",\"platformAttributes\":{\"ios\":{\"minimumMacOSVersion\":\"13.0\",\"description\":{\"standard\":\"Elevate your goal-setting game with Gola! Our app lets you create and track six different types of goals, with customizable widgets and reminders to keep you on track. Plus, our AI provides expert advice to help you reach your goals faster. Download Gola now and take control of your success!\\n\\n■ Pick one of 6 different goal types\\nWith Gola, you can select from six different types of goals to suit your needs. Whether you want to save up for a dream vacation, hit a fitness milestone, or learn a new skill, Gola has got you covered.\\n\\nSINGLE GOAL → This is the generic single-task goal (e.g. Learn a new skill)\\nSUB-GOALS → You need to finish multiple goals to complete this.\\nPROGRESS GOAL → A goal on which you will make progress as the year passes (e.g. Run 43KM)\\nVALUE GOAL → Same as progress, but you need to give each input a title and date (e.g. Read 12 books)\\nOPEN PROGRESS → This progress goal completes when the year is finished (e.g. Swim as much as possible)\\nCOUNTDOWN → Set a start and end date and let this goal count down till it’s completed (e.g. Don't drink alcohol for one month)\\n\\n■ Get help achieving your goals with the power of AI\\nOne of the best things about Gola is that it harnesses the power of AI to help you achieve your goals. With personalised recommendations and targeted support, the app can help you stay on track and make meaningful progress towards your goals. Whether you need a little extra motivation or some practical advice on getting started, Gola is the app for you.\\n\\n■ Customise the app to your own taste with themes and icons\\nBut that's not all - Gola is also highly customisable, so you can make the app your own. With a range of themes and icons to choose from, you can customise the look and feel of the app to suit your style and preferences. And with widgets that you can set up to remind you of your goals or track your progress, you'll never forget what you're working towards or how far you've come.\\n\\nIn summary, if you're looking for a powerful, flexible and easy-to-use goal-setting app, look no further than Gola. With a range of features and tools designed to help you achieve your goals, it's the perfect app for anyone looking to make meaningful progress and positive changes in their lives. So why wait? Download Gola today and start making your goals a reality!\\n\\n\\n■ More Features\\n- Create different types of goals\\n- Get reminded via notifications whenever you want\\n- Add icons or Emoji to your goals for more joy\\n- Use shortcuts or ask Siri to check in on your goals\\n- See how far the year progresses as we go\\n- Add widgets to your Home Screen \u0026 Lock Screen to see the year's progress, to open Gola quickly or to show a random goal\\n- Select one of the many available themes to use the app in a colour that you like.\\n- Sort your goals by Creation Date or Last Updated\\n- Hear fun little sounds as you make progress and create goals\\n- Confetti when you complete a goal!\\n- Accessible to everyone\\n- Control if you like haptics or not\\n- Have goals that you only want visible to your own eyes? now you can set them up as private.\\n\\nAnd this is just the beginning... There are a lot of fun new features planned to be added really soon!\\n\\n---\\n\\nThe free version of Gola is free forever and contains no ads. If you’re looking for the best way to track a few of your bigger goals, downloading this app is a great place to start.\\nWith an in-app subscription to Gola Pro or a one-time purchase, you’ll get the following things: unlimited goals, more types of goals, advanced settings and access to all future features.\\n\\n---\\n\\nTerms \u0026 Conditions: https://www.craft.do/s/IQv3Opu45bg39i\\nPrivacy policy: https://www.craft.do/s/g7sQraD8OQUEQx\"},\"isStandaloneWithCompanionForWatchOS\":true,\"isAppleWatchSupported\":true,\"websiteUrl\":\"https://www.craft.do/s/HHf7Y3fLrhOMXF\",\"versionHistory\":[{\"versionDisplay\":\"2023.21\",\"releaseNotes\":\"- Improved the Green theme\\n- Bug fixes\\n- Added new App Icon\\n- Preparation for an In-App event\",\"releaseDate\":\"2023-03-28\",\"releaseTimestamp\":\"2023-03-28T23:36:36Z\"},{\"versionDisplay\":\"2023.20\",\"releaseNotes\":\"- You can now share your goal's progress with the press of a button\\n- The AI advice generator now uses GPT-4\\n- Bug fixes for value goals\\n- Visual bug fix that caused a black spot to show on screenshots\",\"releaseDate\":\"2023-03-21\",\"releaseTimestamp\":\"2023-03-21T20:54:10Z\"},{\"versionDisplay\":\"2023.19\",\"releaseNotes\":\"- Bug fixes\\n- Improved explanation of Gola Pro\",\"releaseDate\":\"2023-03-08\",\"releaseTimestamp\":\"2023-03-08T19:42:04Z\"},{\"versionDisplay\":\"2023.18\",\"releaseNotes\":\"Bug fixes\",\"releaseDate\":\"2023-03-07\",\"releaseTimestamp\":\"2023-03-07T09:56:45Z\"},{\"versionDisplay\":\"2023.17\",\"releaseNotes\":\"- Bug fixes for AI Advice in Japanese and Chinese\",\"releaseDate\":\"2023-03-04\",\"releaseTimestamp\":\"2023-03-04T10:33:00Z\"},{\"versionDisplay\":\"2023.16\",\"releaseNotes\":\"This update includes a lot of improvements for the Sub-Goal type\\n\\n- The progress of sub-goals now counts towards the progress of their main goal\\n- Drag and drop goals onto each other to change it to a sub-goal and merge them\\n- You can turn any sub-goal into a regular goal\\n- It's now possible to add sub-goals directly in the creation page\\n\\n+ some smaller improvements and bug fixes\",\"releaseDate\":\"2023-03-03\",\"releaseTimestamp\":\"2023-03-03T00:30:01Z\"},{\"versionDisplay\":\"2023.15\",\"releaseNotes\":\"- Fixes a big bug that wouldn't let you type to update a progress sub-goal\\n- Tweaked the AI advice\\n- Visual bug fix for open goals widget\\n- Bug fix where the icon was sometimes cut off on widgets\",\"releaseDate\":\"2023-02-26\",\"releaseTimestamp\":\"2023-02-26T17:14:56Z\"},{\"versionDisplay\":\"2023.14\",\"releaseNotes\":\"- Completed goals are now hidden behind a different view (well done for completing them! I'll add more fun for this later)\\n- Goal widgets now update more frequently\\n- Two fun new themes are added (Lightyear \u0026 Classroom)\\n- Performance improvements\",\"releaseDate\":\"2023-02-24\",\"releaseTimestamp\":\"2023-02-24T23:01:23Z\"},{\"versionDisplay\":\"2023.13\",\"releaseNotes\":\"- Widgets now update color directly with the change of theme\\n- Review button in Settings was broken\\n- Green and Red color tweaks for better contrast\\n- Portuguese translation improvements (Thanks Jorge!)\\n- Performance bug fix\\n\",\"releaseDate\":\"2023-02-23\",\"releaseTimestamp\":\"2023-02-23T15:50:24Z\"},{\"versionDisplay\":\"2023.12\",\"releaseNotes\":\"- Help decide what to build next: You can now view the public roadmap and vote or request new features\\n- Reminders are added to the onboarding in a fun way so you’re more likely to hit your goals\\n- Have the ability to check your iCloud status and see if everything should work as expected\\n- Fixed a bug where you had to drag the cursor back if you want to update the progress with keyboard\",\"releaseDate\":\"2023-02-22\",\"releaseTimestamp\":\"2023-02-22T15:44:09Z\"},{\"versionDisplay\":\"2023.11\",\"releaseNotes\":\"- You can now view the public roadmap and request new features\\n- Reminders are added to the onboarding\\n- Have the ability to check your iCloud status and see if everything should work as expected\",\"releaseDate\":\"2023-02-21\",\"releaseTimestamp\":\"2023-02-21T23:32:51Z\"},{\"versionDisplay\":\"1.1.4\",\"releaseNotes\":\"- You can now search for goals if you have more than 5 of them\\n- Smaller bug fixes and improvements\",\"releaseDate\":\"2023-02-19\",\"releaseTimestamp\":\"2023-02-19T11:36:13Z\"},{\"versionDisplay\":\"1.1.3\",\"releaseNotes\":\"- NEW: Countdown goal type\\n- IMPROVEMENT: Progress goals show start value (when not 0)\\n- IMPROVEMENT: Progress goals show how much you still have to go\",\"releaseDate\":\"2023-02-15\",\"releaseTimestamp\":\"2023-02-15T20:29:16Z\"},{\"versionDisplay\":\"1.1.2\",\"releaseNotes\":\"- You can now edit a sub-goal\\n- You can now find your Goals in Spotlight search\\n- Translation fixes\\n- Performance improvements\",\"releaseDate\":\"2023-01-26\",\"releaseTimestamp\":\"2023-01-26T18:22:08Z\"},{\"versionDisplay\":\"1.1.1\",\"releaseNotes\":\"Introducing motivation \u0026 advice!\\n\\nWith the power of AI (using GPT3) you can now get advice on how to achieve your goal with the press of a single button. \\nThis modern day technology will help you achieve your goals even easier and better \",\"releaseDate\":\"2023-01-25\",\"releaseTimestamp\":\"2023-01-25T23:00:56Z\"},{\"versionDisplay\":\"1.1\",\"releaseNotes\":\"I am excited to announce the release of Gola for watchOS! With this update, you can now track and update your goals directly from your Apple Watch. This means you can quickly check your progress and make adjustments to your goals on the go.\\n\\n■ watchOS Features\\n- Track and update all your goals from your wrist\\n- Check your progress and make adjustments to your goals on the go\\n- Set complications to always be in the loop\\n\\nI hope you enjoy the convenience of tracking and updating your goals from your wrist with Gola for watchOS. \\nPlease let me know if you have any feedback or questions about this update.\\n\\n■ Other improvements and fixes\\n- You can now mark goals as private and unlock them with Face ID, Touch ID or a passcode\\n- New widget that shows you one of your uncompleted goals randomly\\n- New widget that opens Gola (so basically just a shortcut) \\n- Added Danish translations\\n- Added a little hint that you can tap on the counter to update more quickly\\n- Added an accessory circular widget\\n- Added a black-and-white theme\\n- New widget to just quickly open Gola\\n- New custom checkmark icon\\n- You will now get a warning before deleting a Goal\\n- Performance bug fixes\\n\",\"releaseDate\":\"2023-01-21\",\"releaseTimestamp\":\"2023-01-21T13:58:49Z\"},{\"versionDisplay\":\"1.0.4\",\"releaseNotes\":\"- Need some inspiration? Gola now shows you a few possibilities for you to get started with goal settings\\n- New goal type: Open progress. This progress goal completes when the year is finished (e.g. Swim as much as possible)\\n- Don't fancy one of the icons? You can now set two letters (or an emoji) as the icon for your goals\\n- Bug fixes and design improvements\",\"releaseDate\":\"2023-01-12\",\"releaseTimestamp\":\"2023-01-12T23:53:25Z\"},{\"versionDisplay\":\"1.0.3\",\"releaseNotes\":\"- Fixed some missing translations\\n- You can now swipe a single goal from the overview page to complete it directly\\n- New icons on the main page\\n- Some more minor performance improvements\\n- Default theme in China is now red\\n- Fixed a bug where app icons looked like they're locked\\n- Added option to share the app to get an extra goal for free\",\"releaseDate\":\"2023-01-11\",\"releaseTimestamp\":\"2023-01-11T22:21:10Z\"},{\"versionDisplay\":\"1.0.2\",\"releaseNotes\":\"- Bug fix for the widget that would only show up in iOS 16.2\\n- Sub-Goal improvements\\n- Added some missing translations\",\"releaseDate\":\"2023-01-09\",\"releaseTimestamp\":\"2023-01-09T21:03:28Z\"},{\"versionDisplay\":\"1.0.1\",\"releaseNotes\":\"- Widget improvements\\n- Bug fixes\",\"releaseDate\":\"2023-01-09\",\"releaseTimestamp\":\"2023-01-09T10:08:37Z\"},{\"versionDisplay\":\"1.0\",\"releaseNotes\":null,\"releaseDate\":\"2023-01-09\",\"releaseTimestamp\":\"2023-01-09T00:15:37Z\"}],\"messagesScreenshots\":{},\"hasSafariExtension\":false,\"requiresGameController\":false,\"offers\":[{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=1661833753\u0026pricingParameters=STDQ\u0026pg=default\u0026appExtVrsId=855861445\",\"type\":\"get\",\"priceFormatted\":\"$0.00\",\"price\":0,\"currencyCode\":\"USD\",\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":42074112}]},{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=1661833753\u0026pricingParameters=SWUPD\u0026pg=default\u0026appExtVrsId=855861445\",\"type\":\"update\",\"priceFormatted\":\"$0.00\",\"price\":0,\"currencyCode\":\"USD\",\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":42074112}]}],\"requires32bit\":false,\"releaseDate\":\"2023-01-08\",\"hasInAppPurchases\":true,\"bundleId\":\"com.modumhq.Hazi\",\"hasMessagesExtension\":false,\"artwork\":{\"width\":1024,\"height\":1024,\"url\":\"https://is5-ssl.mzstatic.com/image/thumb/Purple116/v4/a