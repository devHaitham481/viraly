,\"bgColor\":\"191919\",\"textColor1\":\"ebebeb\",\"textColor2\":\"cccccc\",\"textColor3\":\"c1c1c1\",\"textColor4\":\"a8a8a8\"}]}}}}},\"ios\":{\"offers\":[{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=1511343960\u0026pricingParameters=STDQ\u0026pg=default\u0026appExtVrsId=844256286\",\"type\":\"get\",\"priceFormatted\":\"$0.00\",\"price\":0,\"currencyCode\":\"USD\",\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":9363456}]},{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=1511343960\u0026pricingParameters=SWUPD\u0026pg=default\u0026appExtVrsId=844256286\",\"type\":\"update\",\"priceFormatted\":\"$0.00\",\"price\":0,\"currencyCode\":\"USD\",\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":9363456}]}],\"requires32bit\":false,\"releaseDate\":\"2020-06-08\",\"hasInAppPurchases\":true,\"bundleId\":\"com.alejandrocrosa.aleph.ios\",\"description\":{\"standard\":\"Upload your thoughts.\\nThe simplest, and most powerful note-taking blogging platform ever made.\\n\\nCreate private notes, share them publicly and create your blog with a custom domain.\\n\\n■ Markdown with live preview\\nLive Markdown previews allow you to see the final result in real-time as you type.\\n\\n■ Simplicity\\nEvery app out there eventually tries to do more than they should. We believe in doing less, but better.\\n\\n■ Native experience\\nThe iPhone app allows for a fast native-first experience. Just open the app and go right into writing mode.\\n\\n■ No nonsense\\n No ads.\\n No feature creep.\\n No tracking.\\n No annoying emails.\\n No data sold.\\n No comments.\\n No vanity metrics.\\n No proprietary formats.\\nYou'll never see popups, clutter, subscription up-sells, or anything that interferes with the reading experience. Collected Notes is a reading-first experience.\\n\\nYour attention matters.\\n\"},\"isStandaloneWithCompanionForWatchOS\":false,\"hasMessagesExtension\":false,\"artwork\":{\"width\":1024,\"height\":1024,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Purple125/v4/8a/e7/d3/8ae7d3c8-ace1-8004-f927-201aa96206cd/AppIcon-0-1x_U007emarketing-0-7-0-85-220.jpeg/{w}x{h}{c}.{f}\",\"bgColor\":\"ffffff\",\"textColor1\":\"131517\",\"textColor2\":\"222425\",\"textColor3\":\"424345\",\"textColor4\":\"4e4f50\"},\"privacyPolicyUrl\":\"https://collectednotes.com/privacy\",\"videoPreviewsByType\":{},\"isAppleWatchSupported\":false,\"supportURLForLanguage\":\"https://collectednotes.com/support\",\"isStandaloneForWatchOS\":false,\"isHiddenFromSpringboard\":false,\"isDeliveredInIOSAppForWatchOS\":false,\"versionHistory\":[{\"versionDisplay\":\"1.4.21\",\"releaseNotes\":\"Bugfixes and improvements\",\"releaseDate\":\"2021-09-23\",\"releaseTimestamp\":\"2021-09-23T19:02:58Z\"},{\"versionDisplay\":\"1.4.19\",\"releaseNotes\":\"NEW! Multiple sites. One account.\\nQuickly switch between multiple sites effortlessly.\\n\\nLots of improvements and bugfixes.\",\"releaseDate\":\"2020-12-02\",\"releaseTimestamp\":\"2020-12-02T02:16:26Z\"},{\"versionDisplay\":\"1.4.12\",\"releaseNotes\":\"NEW bi-directional linking!\\nCreate notes on the fly, navigate through existing ones and see history of all the notes you opened.\\nReferences, links and more.\\n\\nBug fixes \u0026 speed improvements\\nUpdated for Big Sur\",\"releaseDate\":\"2020-11-15\",\"releaseTimestamp\":\"2020-11-15T17:20:08Z\"},{\"versionDisplay\":\"1.4.11\",\"releaseNotes\":\"- Dictate your notes!\\n- Improvements to formatting toolbar\\n- Cursor support for iPad\\n- New title bar with easy access\\n- More speed and bug fixes\\n\",\"releaseDate\":\"2020-09-19\",\"releaseTimestamp\":\"2020-09-19T15:29:05Z\"},{\"versionDisplay\":\"1.4.10\",\"releaseNotes\":\"Changed settings design for notes.\\nFixed an issue on about page.\\nBugfixes and improvements. \",\"releaseDate\":\"2020-09-10\",\"releaseTimestamp\":\"2020-09-10T18:40:17Z\"},{\"versionDisplay\":\"1.4.7\",\"releaseNotes\":\"New format toolbar\\nBug fixes and improvements\",\"releaseDate\":\"2020-09-08\",\"releaseTimestamp\":\"2020-09-08T16:30:54Z\"},{\"versionDisplay\":\"1.4.6\",\"releaseNotes\":\"Adds domain setting for static websites\",\"releaseDate\":\"2020-09-02\",\"releaseTimestamp\":\"2020-09-02T20:23:58Z\"},{\"versionDisplay\":\"1.4.4\",\"releaseNotes\":\"- Support for front matter \\n- Bugfixes \u0026 speed improvements\",\"releaseDate\":\"2020-08-17\",\"releaseTimestamp\":\"2020-08-17T11:28:18Z\"},{\"versionDisplay\":\"1.4.3\",\"releaseNotes\":\"- Drag \u0026 drop images\\n- Better site settings\\n- Bugfixes and improvements\",\"releaseDate\":\"2020-07-12\",\"releaseTimestamp\":\"2020-07-12T16:56:31Z\"},{\"versionDisplay\":\"1.4.2\",\"releaseNotes\":\"Fixes an issue when setting the visibility of posts.\\n\",\"releaseDate\":\"2020-07-07\",\"releaseTimestamp\":\"2020-07-07T21:11:49Z\"},{\"versionDisplay\":\"1.4.1\",\"releaseNotes\":\"Reorder your notes.\\nBetter sharing.\\nBug fixes and improvements.\",\"releaseDate\":\"2020-07-06\",\"releaseTimestamp\":\"2020-07-06T22:03:24Z\"},{\"versionDisplay\":\"1.3.1\",\"releaseNotes\":\"We've made the app even faster \u0026 cleaner.\\n\\nAdded “preview” button for easy access while editing. Swipe will continue to work in order to see the preview.\\n- In addition to “public” and “private” you can now create notes and publish them as “unlisted”.\\n- Swipe \u0026 long press context menus on notes.\\n- Infinite scrolling support to notes list.\\n- Better upload images UI.\\n- Improved add link option.\\n- Scroll is now respected when dealing with long notes.\\n- Improved slider over and split view on iPad.\\n- FaceID fixes. Also, FaceID \u0026 TouchID are now detected and shown accordingly in settings.\\n- Smart quotes are now disabled. This is important if you are writing code blocks.\\n- Bug fixes and improvements.\",\"releaseDate\":\"2020-06-29\",\"releaseTimestamp\":\"2020-06-29T01:52:46Z\"},{\"versionDisplay\":\"1.2\",\"releaseNotes\":\"New and update split view for iPad, more speed, quick actions, bug fixes and more\",\"releaseDate\":\"2020-06-20\",\"releaseTimestamp\":\"2020-06-20T15:36:37Z\"},{\"versionDisplay\":\"1.1\",\"releaseNotes\":\"Apple Pencil support! in addition to images, you can now attach drawings to your notes.\\nBug fixes and improvements.\",\"releaseDate\":\"2020-06-13\",\"releaseTimestamp\":\"2020-06-13T20:20:11Z\"},{\"versionDisplay\":\"1.0\",\"releaseNotes\":null,\"releaseDate\":\"2020-06-08\",\"releaseTimestamp\":\"2020-06-08T06:03:55Z\"}],\"editorialArtwork\":{\"brandLogo\":{\"width\":1080,\"height\":1080,\"url\":\"https://is3-ssl.mzstatic.com/image/thumb/Features114/v4/0d/d9/6c/0dd96cca-2fb0-2ff7-eeb4-204c1dd54bcc/pr_source.png/{w}x{h}{c}.{f}\",\"bgColor\":\"000000\",\"textColor1\":\"f2f2f2\",\"textColor2\":\"e5e5e5\",\"textColor3\":\"c1c1c1\",\"textColor4\":\"b7b7b7\"}},\"subtitle\":\"Simply your thoughts.\",\"messagesScreenshots\":{},\"hasSafariExtension\":false,\"requiresGameController\":false,\"customAttributes\":{\"default\":{\"default\":{\"customScreenshotsByType\":{\"iphone_6_5\":[{\"width\":1242,\"height\":2688,\"url\":\"https://is3-ssl.mzstatic.com/image/thumb/Purple123/v4/17/cb/6f/17cb6f3c-913e-7c4d-fbca-3e28b96e2cc8/pr_source.png/{w}x{h}{c}.{f}\",\"bgColor\":\"141414\",\"textColor1\":\"ffffff\",\"textColor2\":\"cacaca\",\"textColor3\":\"cfcfcf\",\"textColor4\":\"a5a5a5\"},{\"width\":1242,\"height\":2688,\"url\":\"https://is3-ssl.mzstatic.com/image/thumb/Purple113/v4/53/90/91/539091bc-4e18-8a56-69c6-c9175195e821/pr_source.png/{w}x{h}{c}.{f}\",\"bgColor\":\"141414\",\"textColor1\":\"f3f3f3\",\"textColor2\":\"cacaca\",\"textColor3\":\"c6c6c6\",\"textColor4\":\"a5a5a5\"},{\"width\":1242,\"height\":2688,\"url\":\"https://is3-ssl.mzstatic.com/image/thumb/Purple123/v4/37/01/04/3701040d-bcf2-dab8-569c-a62655cb91b5/pr_source.png/{w}x{h}{c}.{f}\",\"bgColor\":\"141414\",\"textColor1\":\"f3f3f3\",\"textColor2\":\"cacaca\",\"textColor3\":\"c6c6c6\",\"textColor4\":\"a5a5a5\"},{\"width\":1242,\"height\":2688,\"url\":\"https://is5-ssl.mzstatic.com/image/thumb/Purple113/v4/6c/