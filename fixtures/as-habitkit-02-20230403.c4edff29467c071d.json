,\"universal\":9363456,\"iPod9,1\":8011776,\"iPhone14,8\":8138752,\"iPad13,16\":8015872,\"iPad6,7\":8015872,\"iPad6,4\":8015872,\"iPad6,3\":8015872,\"iPad6,8\":8015872,\"iPad13,8\":8015872,\"iPad13,9\":8015872,\"iPad13,4\":8015872,\"iPad13,5\":8015872,\"iPad13,6\":8015872,\"iPad13,7\":8015872,\"iPad13,1\":8015872,\"iPad13,2\":8015872}},\"relationships\":{\"developer\":{\"href\":\"/v1/catalog/us/apps/1511343960/developer?l=en-US\",\"data\":[{\"id\":\"925210528\",\"type\":\"developers\",\"href\":\"/v1/catalog/us/developers/925210528?l=en-US\",\"attributes\":{\"genreNames\":[],\"editorialArtwork\":{},\"name\":\"Alejandro Crosa\",\"mediaType\":\"Mobile Software Applications\",\"url\":\"https://apps.apple.com/us/developer/alejandro-crosa/id925210528\"}}]},\"genres\":{\"href\":\"/v1/catalog/us/apps/1511343960/genres?l=en-US\",\"data\":[{\"id\":\"6007\",\"type\":\"genres\",\"href\":\"/v1/catalog/us/genres/6007?l=en-US\",\"attributes\":{\"parentName\":\"App Store\",\"name\":\"Productivity\",\"parentId\":\"36\",\"url\":\"https://itunes.apple.com/us/genre/id6007\"}},{\"id\":\"6002\",\"type\":\"genres\",\"href\":\"/v1/catalog/us/genres/6002?l=en-US\",\"attributes\":{\"parentName\":\"App Store\",\"name\":\"Utilities\",\"parentId\":\"36\",\"url\":\"https://itunes.apple.com/us/genre/id6002\"}}]}}},{\"id\":\"1584335419\",\"type\":\"apps\",\"href\":\"/v1/catalog/us/apps/1584335419?l=en-US\",\"attributes\":{\"distributionKind\":\"APP_STORE\",\"supportsArcade\":false,\"isFirstPartyHideableApp\":false,\"privacy\":{\"privacyTypes\":[{\"privacyType\":\"Data Not Linked to You\",\"identifier\":\"DATA_NOT_LINKED_TO_YOU\",\"description\":\"The following data may be collected but it is not linked to your identity:\",\"dataCategories\":[{\"dataCategory\":\"Purchases\",\"identifier\":\"PURCHASES\"}]}]},\"contentRatingsBySystem\":{\"appsApple\":{\"name\":\"4+\",\"value\":100,\"rank\":1}},\"deviceFamilies\":[\"mac\",\"iphone\",\"ipad\",\"ipod\"],\"url\":\"https://apps.apple.com/us/app/linkbin/id1584335419\",\"userRating\":{\"value\":4,\"ratingCount\":2,\"ratingCountList\":[0,0,0,2,0],\"ariaLabelForRatings\":\"4.0 stars\"},\"firstVersionSupportingInAppPurchaseApi\":\"1.0.0\",\"name\":\"LinkBin\",\"genreDisplayName\":\"Productivity\",\"isPreorder\":false,\"isIOSBinaryMacOSCompatible\":false,\"artistName\":\"David Haydl\",\"reviewsRestricted\":false,\"requirementsByDeviceFamily\":{\"iphone\":{\"deviceFamily\":\"iPhone\",\"requirementString\":\"Requires iOS 14.0 or later.\"},\"mac\":{\"deviceFamily\":\"Mac\",\"requirementString\":\"Requires macOS 11.0 or later.\"},\"ipod\":{\"deviceFamily\":\"iPod touch\",\"requirementString\":\"Requires iOS 14.0 or later.\"},\"ipad\":{\"deviceFamily\":\"iPad\",\"requirementString\":\"Requires iPadOS 14.0 or later.\"}},\"platformAttributes\":{\"osx\":{\"description\":{\"standard\":\"Ever wanted to save links for later, but other apps that do a similar things are too clunky? Enter LinkBin. Save links in a few seconds and get back to them at any time - just that, nothing more.\\n\\nFEATURES\\n\\n- Save links by pasting them into the app, by using the share sheet, or via the brand-new Safari extension on iOS and macOS\\n- Organize them using labels\\n- When you do not need a link anymore, you can archive it\\n- Works on iOS, iPadOS and macOS, and everything is in sync via iCloud\\n- Automate LinkBin using the preinstalled Shortcuts app\\n- See your links through widgets on the homescreen\\n- Add notes to a link with Apple's Quick Note feature\\n- Copy links in formats like HTML with just a few clicks\"},\"isStandaloneWithCompanionForWatchOS\":false,\"isAppleWatchSupported\":false,\"versionHistory\":[{\"versionDisplay\":\"1.2.1\",\"releaseNotes\":\"This update fixes an issue where the new Safari extension would not show up in the Safari's settings on iOS, iPadOS and macOS.\",\"releaseDate\":\"2022-08-22\",\"releaseTimestamp\":\"2022-08-22T20:54:48Z\"},{\"versionDisplay\":\"1.2.0\",\"releaseNotes\":\"LinkBin is back! After a short break, this app will receive updates on a regular basis again. With this version, some exciting new features and stability improvements were implemented.\\n\\n- There is a new Safari extension on iOS and macOS. Save the currently opened web page as a link in LinkBin with just a few clicks. You can optionally attach a label as well. iOS 15 is required for this.\\n- On iOS, LinkBin now has an \\\"Add to LinkBin\\\" action extension which can be found in the share sheet. This allows you to add a label before saving, compared to the already existing Share extension.\\n- Do you like LinkBin? You can now post a rating on the App Store via the settings screens.\\n- The manuals are now placed on the start page on iOS and in the Help entry of the menu bar on macOS. Also, some of them have been rewritten and received some screenshots for additional clarity.\\n- There is a new default view: Favorites. Star a link via the context menu and it will land in this separate area.\\n- The link lists received quite a performance boost under the hood. Especially on macOS, scrolling should be faster, thanks to the improvements that were made.\\n- The context menu is now able to handle all selected links. Previously, only one link at a time could be processed through the context menu.\\n- On iOS, the share extension should operate a bit faster with this update.\\n\\nI really hope that you like these changes! Please file any feedback and bug reports via the app's settings.\",\"releaseDate\":\"2022-08-14\",\"releaseTimestamp\":\"2022-08-14T10:19:03Z\"},{\"versionDisplay\":\"1.1.3\",\"releaseNotes\":\"- Restructured some source code in order to allow me to implement new feature more easily.\\n- Deactived the context menu when multiple links are selected since the actions only support one link for now.\\n- The button to reset the formatting of links in the copy view is now working.\\n- You can now choose a label for a link from the context menu.\\n- The view for editing a link or copying links does not crash anymore on macOS.\\n- Fixed a bug where pasting a link from the pasteboard would result in a crash on macOS.\\n- Added a Shortcuts action to open a saved link in LinkBin's browser view.\\n- Added a Shortcuts action to create a label.\",\"releaseDate\":\"2021-12-20\",\"releaseTimestamp\":\"2021-12-20T13:59:55Z\"},{\"versionDisplay\":\"1.1.2\",\"releaseNotes\":\"- Fixed a bug where saving a link through the Safari extension on macOS would result in a crash.\\n- Fixed a German translation in an info pop-up.\\n- Added the ability to save a link or a label by pressing the return key on the keyboard.\\n- The in-app browser is macOS is now scalable.\\n- Added the possibility to edit a link's URL after it has been saved.\",\"releaseDate\":\"2021-12-06\",\"releaseTimestamp\":\"2021-12-06T14:56:36Z\"},{\"versionDisplay\":\"1.1.1\",\"releaseNotes\":\"- You now have the ability to open a link in the device's default browser via the context menu.\\n- Shortcuts actions and widgets can now be configured to query archived links and all links. The latter was added so that you don't have to recreate a widget or an action when you want to deselect a chosen label.\\n- The list with all labels that appears when you configure a Shortcuts action or a widget now comes with icons for a better visual appearance.\\n- LinkBin now supports Siri Suggestions.\",\"releaseDate\":\"2021-11-29\",\"releaseTimestamp\":\"2021-11-29T17:45:49Z\"},{\"versionDisplay\":\"1.1.0\",\"releaseNotes\":\"Okay, this is a big one. Thank you for your patience until this update, I really appreciate it.\\n\\n- LinkBin now supports Apple's Quick Note feature. Open a link with the built-in browser and you'll be able to deeplink to that website and add notes. Requires iOS 15, iPadOS 15 or macOS 12 Monterey or later.\\n- Handoff support is here. Visit a link with the built-in browser and continue on another device where you left off.\\n- The macOS version also has an in-app browser now. This can be optionally deactivated from the app's settings.\\n- New Shortcuts action: Copy the newest link into the system clipboard.\\n- This update also comes with quite a few widgets. Place them on your homescreen and interact with your links even quicker.\\n- Need to copy a link in HTML or a similar format, for example for WordPress? No problem, you can now do this in LinkBin with just a few clicks.\\n- A confirmation dialog does not appear anymore when you swipe to delete a link or a label.\\n- All Shortcuts actions from iOS and iPadOS are now available on your Mac as well. Requires macOS 12 Monterey or later.\\n- You now have the ability to edit a link's title. This is especially useful when they all have the same generated title, like Google Drive links.\\n- Ever wanted to explore more of LinkBin's features? I got you! There is now a section in settings with some help articles which should give you a better idea about the features the app has to offer.\\n- Added a new alternate app icon. Requires a LinkBin Club purchase.\\n\\nAs always, please leave bug reports and feature requests!\",\"releaseDate\":\"2021-11-19\",\"releaseTimestamp\":\"2021-11-19T21:19:53Z\"},{\"versionDisplay\":\"1.0.4\",\"releaseNotes\":\"- Implemented a lot of under the hood improvements for iCloud sync. For example, the app don't crashes anymore when you agree to new terms and conditions.\\n- You can now display archived items in the main lists via a new toggle in settings. Archived links show up with an archivebox icon, so that they are visually separated from other entries.\",\"releaseDate\":\"2021-10-06\",\"releaseTimestamp\":\"2021-10-06T14:38:23Z\"},{\"versionDisplay\":\"1.0.3\",\"releaseNotes\":\"- Newly created labels that are attached to a link afterwards did not get synced to iCloud in some cases. This is now fixed.\\n- The iCloud account status is now determined at every startup to avoid unwanted behaviour.\\n- Textfields are now immediately focused when they appear.\\n- On macOS, you were not able to create a new label when you wanted to assign it to a link. This is now possible.\\n- On iOS and iPadOS, there is now a new button that allows to save a link from the clipboard. This is similar to the CMD+V feature that was introduced in the last version.\\n- Editing and deleting labels on macOS was not possible due to a bug introduced in the last version. This is now elliminated.\",\"releaseDate\":\"2021-10-05\",\"releaseTimestamp\":\"2021-10-05T03:18:29Z\"},{\"versionDisplay\":\"1.0.2\",\"releaseNotes\":\"This new version also comes with some bug fixes, as well as some improvements and two new features.\\n\\n- The share extension on iOS now displays a little feedback that indicates if the shared link is saved successfully.\\n- You can now rename labels and change their color.\\n- On macOS, the button for the privacy policy pointed to a wrong URL. This is now fixed.\\n- Save links from the clipboard by pressing CMD + V on an iPad or a Mac. When you have a label open, it will get attached automatically.\\n- It is now possible to create a new label from the view where you can assign one to a link.\\n- Adjusted the appearance of the buttons for creating a label.\",\"releaseDate\":\"2021-10-01\",\"releaseTimestamp\":\"2021-10-01T22:42:24Z\"},{\"versionDisplay\":\"1.0.1\",\"releaseNotes\":\"Thank you for using LinkBin and giving feedback. I really appreciate your support. This version contains bug fixes and some minor improvements and additions.\\n\\n- LinkBin's share extension now supports text. This means that you can share a text from a text editing app and LinkBin parses all links in it.\\n- Added a share sheet on iOS and a share menu on macOS.\\n- If you select black or a dark color for a label's color, the font color automatically turns to white.\\n- Added a link to LinkBin's Twitter account in settings.\\n- Corrected a typo in the App Store description.\\n- Adjusted the size of the screenshots on the App Store page so that their content is more readable.\",\"releaseDate\":\"2021-09-29\",\"releaseTimestamp\":\"2021-09-29T13:02:26Z\"},{\"versionDisplay\":\"1.0.0\",\"releaseNotes\":null,\"releaseDate\":\"2021-09-26\",\"releaseTimestamp\":\"2021-09-26T17:46:05Z\"}],\"messagesScreenshots\":{},\"hasSafariExtension\":true,\"requiresGameController\":false,\"offers\":[{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=1584335419\u0026pricingParameters=STDQ\u0026pg=default\u0026appExtVrsId=851692798\",\"type\":\"get\",\"priceFormatted\":\"$0.00\",\"price\":0,\"currencyCode\":\"USD\",\"assets\":[{\"flavor\":\"macSoftware\",\"size\":23657353}]},{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=1584335419\u0026pricingParameters=SWUPD\u0026pg=default\u0026appExtVrsId=851692798\",\"type\":\"update\",\"priceFormatted\":\"$0.00\",\"price\":0,\"currencyCode\":\"USD\",\"assets\":[{\"flavor\":\"macSoftware\",\"size\":23657353}]}],\"requires32bit\":false,\"releaseDate\":\"2021-09-26\",\"hasInAppPurchases\":true,\"bundleId\":\"at.davidhaydl.Really-Dumb-Link-List\",\"hasMessagesExtension\":false,\"artwork\":{\"width\":1024,\"height\":1024,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Purple122/v4/e0/fa/16/e0fa16a0-851b-286e-ba30-3f5bb2e76620/AppIcon-85-220-4-2x-sRGB.png/{w}x{h}{c}.{f}\",\"bgColor\":\"000000\",\"textColor1\":\"ffffff\",\"textColor2\":\"c9c9c9\",\"textColor3\":\"cbcbcb\",\"textColor4\":\"a1a1a1\"},\"privacyPolicyUrl\":\"https://dhaydl.github.io/LinkBinWebsite/privacypolicy/\",\"videoPreviewsByType\":{},\"isHiddenFromSpringboard\":false,\"supportURLForLanguage\":\"https://dhaydl.github.io/LinkBinWebsite/\",\"isStandaloneForWatchOS\":false,\"isDeliveredInIOSAppForWatchOS\":false,\"requiresRosetta\":false,\"editorialArtwork\":{\"brandLogo\":{\"width\":1080,\"height\":1080,\"url\":\"https://is3-ssl.mzstatic.com/image/thumb/Features114/v4/0d/d9/6c/0dd96cca-2fb0-2ff7-eeb4-204c1dd54bcc/pr_source.png/{w}x{h}{c}.{f}\",\"bgColor\":\"000000\",\"textColor1\":\"f2f2f2\",\"textColor2\":\"e5e5e5\",\"textColor3\":\"c1c1c1\",\"textColor4\":\"b7b7b7\"}},\"runsOnAppleSilicon\":true,\"subtitle\":\"Save links for later\",\"preflightPackageUrl\":\"https://osxapps.itunes.apple.com/itunes-assets/Purple112/v4/d3/74/29/d374291e-d9df-1d99-f847-338975230da0/encrypted4156823710754959528.pfpkg\",\"runsOnIntel\":true,\"customAttributes\":{\"default\":{\"default\":{\"customPromotionalText\":\"Save links for later in just a few seconds and reference them later. They are synced across all of your devices, thanks to iCloud.\",\"customScreenshotsByType\":{\"mac\":[{\"width\":2560,\"height\":1600,\"url\":\"https://is5-ssl.mzstatic.com/image/thumb/Purple122/v4/83/1e/c1/831ec12e-cc6e-8ace-7c32-2bbd5f7a0d2d/c50da145-9853-4fae-abcd-8076b2d904d5_Mac__U00281_U0029_English.png/{w}x{h}{c}.{f}\",\"bgColor\":\"ffffff\",\"textColor1\":\"000000\",\"textColor2\":\"230939\",\"textColor3\":\"333333\",\"textColor4\":\"4f3a60\"},{\"width\":2560,\"height\":1600,\"url\":\"https://is5-ssl.mzstatic.com/image/thumb/PurpleSource122/v4/1e/eb/91/1eeb91e7-fae7-0347-8095-227f41c0e897/e640cc16-a0d4-48a6-9815-07cbf70672b7_Mac__U00282_U0029_English.png/{w}x{h}{c}.{f}\",\"bgColor\":\"ffffff\",\"textColor1\":\"000000\",\"textColor2\":\"230939\",\"textColor3\":\"333333\",\"textColor4\":\"4f3a60\"},{\"width\":2560,\"height\":1600,\"url\":\"https://is5-ssl.mzstatic.com/image/thumb/Purple122/v4/91/ae/1e/91ae1eb8-7eb8-8d76-3e6d-1ad0d5513df0/34f4935b-bb29-447f-b978-b02e5d2f9d70_Mac__U00283_U0029_English.png/{w}x{h}{c}.{f}\",\"bgColor\":\"ffffff\",\"textColor1\":\"000000\",\"textColor2\":\"230939\",\"textColor3\":\"333333\",\"textColor4\":\"4f3a60\"},{\"width\":2560,\"height\":1600,\"url\":\"https://is3-ssl.mzstatic.com/image/thumb/Purple112/v4/66/37/d3/6637d3ca-7bc0-69f1-f6f9-d395e0b2a992/8f7188b9-a8d1-4cef-8722-3a367f8778fa_Mac__U00284_U0029_English.png/{w}x{h}{c}.{f}\",\"bgColor\":\"ffffff\",\"textColor1\":\"000000\",\"textColor2\":\"230939\",\"textColor3\":\"333333\",\"textColor4\":\"4f3a60\"},{\"width\":2560,\"height\":1600,\"url\":\"https://is4-ssl.mzstatic.com/image/thumb/PurpleSource112/v4/99/0b/5d/990b5d0e-42a8-3335-8034-13fe02a42394/580753a8-47a3-41e1-bb7e-89af47326ae4_Mac__U00285_U0029_English.png/{w}x{h}{c}.{f}\",\"bgColor\":\"ffffff\",\"textColor1\":\"000000\",\"textColor2\":\"230939\",\"textColor3\":\"333333\",\"textColor4\":\"4f3a60\"}]}}}}},\"ios\":{\"offers\":[{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=1584335419\u0026pricingParameters=STDQ\u0026pg=default\u0026appExtVrsId=851692780\",\"type\":\"get\",\"priceFormatted\":\"$0.00\",\"price\":0,\"currencyCode\":\"USD\",\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":35861504}]},{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=1584335419\u0026pricingParameters=SWUPD\u0026pg=default\u0026appExtVrsId=851692780\",\"type\":\"update\",\"priceFormatted\":\"$0.00\",\"price\":0,\"currencyCode\":\"USD\",\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":35861504}]}],\"requires32bit\":false,\"releaseDate\":\"2021-09-26\",\"hasInAppPurchases\":true,\"bundleId\":\"at.davidhaydl.Really-Dumb-Link-List\",\"description\":{\"standard\":\"Ever wanted to save links for later, but other apps that do a similar things are too clunky? Enter LinkBin. Save links in a few seconds and get back to them at any time - just that, nothing more.\\n\\nFEATURES\\n\\n- Save links by pasting them into the app, by using the share sheet, or via the brand-new Safari extension on iOS and macOS\\n- Organize them using labels\\n- When you do not need a link anymore, you can archive it\\n- Works on iOS, iPadOS and macOS, and everything is in sync via iCloud\\n- Automate LinkBin using the preinstalled Shortcuts app\\n- See your links through widgets on the homescreen\\n- Add notes to a link with Apple's Quick Note feature\\n- Copy links in formats like HTML with just a few clicks\"},\"isStandaloneWithCompanionForWatchOS\":false,\"hasMessagesExtension\":false,\"artwork\":{\"width\":1024,\"height\":1024,\"url\":\"https://is4-ssl.mzstatic.com/image/thumb/Purple122/v4/32/0f/e2/320fe2b8-f575-0242-3008-3105f8ef286d/AppIcon-1x_U007emarketing-0-10-0-sRGB-85-220.png/{w}x{h}{c}.{f}\",\"bgColor\":\"ffffff\",\"textColor1\":\"111111\",\"textColor2\":\"2e2e2e\",\"textColor3\":\"404040\",\"textColor4\":\"585858\"},\"privacyPolicyUrl\":\"https://dhaydl.github.io/LinkBinWebsite/privacypolicy/\",\"videoPreviewsByType\":{},\"isAppleWatchSupported\":false,\"isHiddenFromSpringboard\":false,\"supportURLForLanguage\":\"https://dhaydl.github.io/LinkBinWebsite/\",\"isStandaloneForWatchOS\":false,\"isDeliveredInIOSAppForWatchOS\":false,\"versionHistory\":[{\"versionDisplay\":\"1.2.1\",\"releaseNotes\":\"This update fixes an issue where the new Safari extension would not show up in the Safari's settings on iOS, iPadOS and macOS.\",\"releaseDate\":\"2022-08-22\",\"releaseTimestamp\":\"2022-08-22T20:54:28Z\"},{\"versionDisplay\":\"1.2.0\",\"releaseNotes\":\"LinkBin is back! After a short break, this app will receive updates on a regular basis again. With this version, some exciting new features and stability improvements were implemented.\\n\\n- There is a new Safari extension on iOS and macOS. Save the currently opened web page as a link in LinkBin with just a few clicks. You can optionally attach a label as well. iOS 15 is required for this.\\n- On iOS, LinkBin now has an \\\"Add to LinkBin\\\" action extension which can be found in the share sheet. This allows you to add a label before saving, compared to the already existing Share extension.\\n- Do you like LinkBin? You can now post a rating on the App Store via the settings screens.\\n- The manuals are now placed on the start page on iOS and in the Help entry of the menu bar on macOS. Also, some of them have been rewritten and received some screenshots for additional clarity.\\n- There is a new default view: Favorites. Star a link via the context menu and it will land in this separate area.\\n- The link lists received quite a performance boost under the hood. Especially on macOS, scrolling should be faster, thanks to the improvements that were made.\\n- The context menu is now able to handle all selected links. Previously, only one link at a time could be processed through the context menu.\\n- On iOS, the share extension should operate a bit faster with this update.\\n\\nI really hope that you like these changes! Please file any feedback and bug reports via the app's settings.\",\"releaseDate\":\"2022-08-14\",\"releaseTimestamp\":\"2022-08-14T10:19:15Z\"},{\"versionDisplay\":\"1.1.3\",\"releaseNotes\":\"- Restructured some source code in order to allow me to implement new feature more easily.\\n- Deactived the context menu when multiple links are selected since the actions only support one link for now.\\n- The button to reset the formatting of links in the copy view is now working.\\n- You can now choose a label for a link from the context menu.\\n- The view for editing a link or copying links does not crash anymore on macOS.\\n- Fixed a bug where pasting a link from the pasteboard would result in a crash on macOS.\\n- Added a Shortcuts action to open a saved link in LinkBin's browser view.\\n- Added a Shortcuts action to create a label.\",\"releaseDate\":\"2021-12-20\",\"releaseTimestamp\":\"2021-12-20T13:59:13Z\"},{\"versionDisplay\":\"1.1.2\",\"releaseNotes\":\"- Fixed a bug where saving a link through the Safari extension on macOS would result in a crash.\\n- Fixed a German translation in an info pop-up.\\n- Added the ability to save a link or a label by pressing the return key on the keyboard.\\n- The in-app browser is macOS is now scalable.\\n- Added the possibility to edit a link's URL after it has been saved.\",\"releaseDate\":\"2021-12-06\",\"releaseTimestamp\":\"2021-12-06T14:56:43Z\"},{\"versionDisplay\":\"1.1.1\",\"releaseNotes\":\"- You now have the ability to open a link in the device's default browser via the context menu.\\n- Shortcuts actions and widgets can now be configured to query archived links and all links. The latter was added so that you don't have to recreate a widget or an action when you want to deselect a chosen label.\\n- The list with all labels that appears when you configure a Shortcuts action or a widget now comes with icons for a better visual appearance.\\n- LinkBin now supports Siri Suggestions.\",\"releaseDate\":\"2021-11-29\",\"releaseTimestamp\":\"2021-11-29T17:45:07Z\"},{\"versionDisplay\":\"1.1.0\",\"releaseNotes\":\"Okay, this is a big one. Thank you for your patience until this update, I really appreciate it.\\n\\n- LinkBin now supports Apple's Quick Note feature. Open a link with the built-in browser and you'll be able to deeplink to that website and add notes. Requires iOS 15, iPadOS 15 or macOS 12 Monterey or later.\\n- Handoff support is here. Visit a link with the built-in browser and continue on another device where you left off.\\n- The macOS version also has an in-app browser now. This can be optionally deactivated from the app's settings.\\n- New Shortcuts action: Copy the newest link into the system clipboard.\\n- This update also comes with quite a few widgets. Place them on your homescreen and interact with your links even quicker.\\n- Need to copy a link in HTML or a similar format, for example for WordPress? No problem, you can now do this in LinkBin with just a few clicks.\\n- A confirmation dialog does not appear anymore when you swipe to delete a link or a label.\\n- All Shortcuts actions from iOS and iPadOS are now available on your Mac as well. Requires macOS 12 Monterey or later.\\n- You now have the ability to edit a link's title. This is especially useful when they all have the same generated title, like Google Drive links.\\n- Ever wanted to explore more of LinkBin's features? I got you! There is now a section in settings with some help articles which should give you a better idea about the features the app has to offer.\\n- Added a new alternate app icon. Requires a LinkBin Club purchase.\\n\\nAs always, please leave bug reports and feature requests!\",\"releaseDate\":\"2021-11-19\",\"releaseTimestamp\":\"2021-11-19T21:19:30Z\"},{\"versionDisplay\":\"1.0.4\",\"releaseNotes\":\"- Implemented a lot of under the hood improvements for iCloud sync. For example, the app don't crashes anymore when you agree to new terms and conditions.\\n- You can now display archived items in the main lists via a new toggle in settings. Archived links show up with an archivebox icon, so that they are visually separated from other entries.\",\"releaseDate\":\"2021-10-06\",\"releaseTimestamp\":\"2021-10-06T14:38:05Z\"},{\"versionDisplay\":\"1.0.3\",\"releaseNotes\":\"- Newly created labels that are attached to a link afterwards did not get synced to iCloud in some cases. This is now fixed.\\n- The iCloud account status is now determined at every startup to avoid unwanted behaviour.\\n- Textfields are now immediately focused when they appear.\\n- On macOS, you were not able to create a new label when you wanted to assign it to a link. This is now possible.\\n- On iOS and iPadOS, there is now a new button that allows to save a link from the clipboard. This is similar to the CMD+V feature that was introduced in the last version.\\n- Editing and deleting labels on macOS was not possible due to a bug introduced in the last version. This is now elliminated.\",\"releaseDate\":\"2021-10-05\",\"releaseTimestamp\":\"2021-10-05T03:17:39Z\"},{\"versionDisplay\":\"1.0.2\",\"releaseNotes\":\"This new version also comes with some bug fixes, as well as some improvements and two new features.\\n\\n- The share extension on iOS now displays a little feedback that indicates if the shared link is saved successfully.\\n- You can now rename labels and change their color.\\n- On macOS, the button for the privacy policy pointed to a wrong URL. This is now fixed.\\n- Save links from the clipboard by pressing CMD + V on an iPad or a Mac. When you have a label open, it will get attached automatically.\\n- It is now possible to create a new label from the view where you can assign one to a link.\\n- Adjusted the appearance of the buttons for creating a label.\",\"releaseDate\":\"2021-10-01\",\"releaseTimestamp\":\"2021-10-01T22:41:52Z\"},{\"versionDisplay\":\"1.0.1\",\"releaseNotes\":\"Thank you for using LinkBin and giving feedback. I really appreciate your support. This version contains bug fixes and some minor improvements and additions.\\n\\n- LinkBin's share extension now supports text. This means that you can share a text from a text editing app and LinkBin parses all links in it.\\n- Added a share sheet on iOS and a share menu on macOS.\\n- If you select black or a dark color for a label's color, the font color automatically turns to white.\\n- Added a link to LinkBin's Twitter account in settings.\\n- Corrected a typo in the App Store description.\\n- Adjusted the size of the screenshots on the App Store page so that their content is more readable.\",\"releaseDate\":\"2021-09-29\",\"releaseTimestamp\":\"2021-09-29T13:02:03Z\"},{\"versionDisplay\":\"1.0.0\",\"releaseNotes\":null,\"releaseDate\":\"2021-09-26\",\"releaseTimestamp\":\"2021-09-26T17:45:25Z\"}],\"editorialArtwork\":{\"brandLogo\":{\"width\":1080,\"height\":1080,\"url\":\"https://is3-ssl.mzstatic.com/image/thumb/Features114/v4/0d/d9/6c/0dd96cca-2fb0-2ff7-eeb4-204c1dd54bcc/pr_source.png/{w}x{h}{c}.{f}\",\"bgColor\":\"000000\",\"textColor1\":\"f2f2f2\",\"textColor2\":\"e5e5e5\",\"textColor3\":\"c1c1c1\",\"textColor4\":\"b7b7b7\"}},\"subtitle\":\"Save links for later\",\"messagesScreenshots\":{},\"hasSafariExtension\":true,\"requiresGameController\":false,\"customAttributes\":{\"default\":{\"default\":{\"customPromotionalText\":\"Save links for later in just a few seconds and reference them later. They are synced across all of your devices, thanks to iCloud.\",\"customScreenshotsByType\":{\"iphone_6_5\":[{\"width\":1242,\"height\":2688,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Purple122/v4/33/ae/4a/33ae4ae6-1f59-5f9b-cffa-8140777