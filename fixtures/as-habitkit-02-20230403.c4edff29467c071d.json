ntsByDeviceFamily\":{\"iphone\":{\"deviceFamily\":\"iPhone\",\"requirementString\":\"Requires iOS 14.0 or later.\"},\"mac\":{\"deviceFamily\":\"Mac\",\"requirementString\":\"Requires macOS 11.0 or later.\"},\"ipod\":{\"deviceFamily\":\"iPod touch\",\"requirementString\":\"Requires iOS 14.0 or later.\"},\"ipad\":{\"deviceFamily\":\"iPad\",\"requirementString\":\"Requires iPadOS 14.0 or later.\"}},\"platformAttributes\":{\"osx\":{\"description\":{\"standard\":\"Pinstachio is a simple and modern Pinboard app for your Mac, iPhone, and iPad. Read and manage all of your saved bookmarks with ease!\\n\\nAs a free app, Pinstachio will allow you to easily see your existing bookmarks and even filter unread ones. Try using it for your read-later lists!\\n\\nIf you choose to upgrade to Pinstachio+, you will unlock all of its features on Mac, iPhone, and iPad:\\n\\n+ Adding new bookmarks, including via the share extension\\n+ Editing and managing all of your bookmarks\\n+ More filtering options, including by tags\\n\\nAlso has other features you've come to expect from the Mac like:\\n\\n+ Dark mode support\\n+ Link previews\\n+ Widgets for showing random unread articles from your collection\\n\\nIf you are a Pinboard user, please consider trying Pinstachio out today!\\n\\n---\\n\\nQuestions? Email support@pinstachio.com\\n\\npinstach.io/privacy\\npinstach.io/terms\\n\\n---\\n\\n* Please note that Pinstachio requires a Pinboard account to work.\"},\"isStandaloneWithCompanionForWatchOS\":false,\"isAppleWatchSupported\":false,\"versionHistory\":[{\"versionDisplay\":\"1.7.4\",\"releaseNotes\":\"+ Bug fixes, including one with the tag view\",\"releaseDate\":\"2023-01-14\",\"releaseTimestamp\":\"2023-01-14T10:55:00Z\"},{\"versionDisplay\":\"1.7.3\",\"releaseNotes\":\"+ Fixes some bugs, including some with \\\"Mark As Read\\\" settings\",\"releaseDate\":\"2022-12-02\",\"releaseTimestamp\":\"2022-12-02T10:50:02Z\"},{\"versionDisplay\":\"1.7.2\",\"releaseNotes\":\"+ Fixes a crash for a small number of users in 1.7.1\",\"releaseDate\":\"2022-11-13\",\"releaseTimestamp\":\"2022-11-13T21:39:29Z\"},{\"versionDisplay\":\"1.7.1\",\"releaseNotes\":\"+ Updated for macOS 13 Ventura\\n+ Added an option to show preview images for bookmarks on the main screen\\n+ Added an advanced option for stripping UTM tracking from URLs fetched by the share extension\\n+ The bookmark visibility icon now only shows up as a lock on the bookmark's details label if it's set as private\\n+ Bug fixes and other small improvements\",\"releaseDate\":\"2022-10-27\",\"releaseTimestamp\":\"2022-10-27T15:20:29Z\"},{\"versionDisplay\":\"1.5.0\",\"releaseNotes\":\"+ Added support for multiple windows of the app in macOS\\n+ Added a shortcut for saving bookmarks into a Pinboard account using Pinstachio\\n+ Organized the settings screen into Behavior and Appearance sections for a cleaner look\\n+ Other minor bug fixes\",\"releaseDate\":\"2022-07-02\",\"releaseTimestamp\":\"2022-07-02T16:07:07Z\"},{\"versionDisplay\":\"1.4.1\",\"releaseNotes\":\"+ Added a preference to enable viewing bookmarks inside the app via a custom web view\\n+ Other bug fixes and improvements\",\"releaseDate\":\"2022-05-09\",\"releaseTimestamp\":\"2022-05-09T20:23:57Z\"},{\"versionDisplay\":\"1.4.0\",\"releaseNotes\":\"+ Added option to hide visibility icon from list (public or private)\\n+ Added option to fit preview image within its constraints instead of filling\\n+ Search now also tries to match any query with bookmarks' tags\\n+ Usual line of bug fixes and improvements\",\"releaseDate\":\"2022-04-10\",\"releaseTimestamp\":\"2022-04-10T15:20:58Z\"},{\"versionDisplay\":\"1.3.0\",\"releaseNotes\":\"+ Added setting to show last-used tags in the tags view for easy access if you use them consecutively\\n+ Added setting to pick whether to show a bookmark's details or the website when accessing from the widget\\n+ Other minor improvements and bug fixes\",\"releaseDate\":\"2022-01-13\",\"releaseTimestamp\":\"2022-01-13T18:40:15Z\"},{\"versionDisplay\":\"1.2.1\",\"releaseNotes\":\"+ Adds support for macOS Monterey and Quick Notes\",\"releaseDate\":\"2021-10-28\",\"releaseTimestamp\":\"2021-10-28T18:09:47Z\"},{\"versionDisplay\":\"1.1.1\",\"releaseNotes\":\"+ Added setting to show unread bookmarks on launch\\n+ Added setting to choose new larger image preview options\\n+ Image preview now hides if there is none available\\n+ Search now also returns results from inside bookmarks' description text\\n+ Other minor improvements and bug fixes\",\"releaseDate\":\"2021-08-13\",\"releaseTimestamp\":\"2021-08-13T22:55:31Z\"},{\"versionDisplay\":\"1.1.0\",\"releaseNotes\":null,\"releaseDate\":\"2021-07-30\",\"releaseTimestamp\":\"2021-07-30T19:40:37Z\"}],\"websiteUrl\":\"https://pinstachio.com\",\"hasSafariExtension\":false,\"messagesScreenshots\":{},\"requiresGameController\":false,\"offers\":[{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=1535386074\u0026pricingParameters=STDQ\u0026pg=default\u0026appExtVrsId=854371844\",\"type\":\"get\",\"priceFormatted\":\"$0.00\",\"price\":0,\"currencyCode\":\"USD\",\"assets\":[{\"flavor\":\"macSoftware\",\"size\":3319104}]},{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=1535386074\u0026pricingParameters=SWUPD\u0026pg=default\u0026appExtVrsId=854371844\",\"type\":\"update\",\"priceFormatted\":\"$0.00\",\"price\":0,\"currencyCode\":\"USD\",\"assets\":[{\"flavor\":\"macSoftware\",\"size\":3319104}]}],\"requires32bit\":false,\"releaseDate\":\"2020-11-24\",\"hasInAppPurchases\":true,\"bundleId\":\"com.fracbits.Pinstachio\",\"hasMessagesExtension\":false,\"artwork\":{\"width\":1024,\"height\":1024,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Purple113/v4/b0/9e/10/b09e1022-3f73-e875-4138-dbf2131b852c/AppIcon-0-2x-4-0-85-220.png/{w}x{h}{c}.{f}\",\"bgColor\":\"000000\",\"textColor1\":\"ffffff\",\"textColor2\":\"4998fa\",\"textColor3\":\"cbcbcb\",\"textColor4\":\"3b7ac8\"},\"videoPreviewsByType\":{},\"privacyPolicyUrl\":\"https