4,\"iPad14,4-A\":16308224,\"iPhone9,4\":16312320,\"iPad8,11\":16308224,\"universal\":16406528,\"iPad6,4\":16308224,\"iPad7,5\":16308224,\"iPad13,19\":16308224,\"iPhone10,5\":16312320,\"iPhone9,1\":16304128,\"iPhone14,6\":16304128,\"iPhone11,2\":16312320,\"iPad8,8\":16308224,\"iPad7,3\":16308224,\"iPhone14,3\":16312320,\"iPhone14,7\":16312320,\"iPad13,11\":16308224,\"iPhone15,2\":16312320,\"iPad6,12\":16308224,\"iPad14,2\":16308224,\"iPad8,1\":16308224,\"iPad14,5-B\":16308224,\"MacFamily20,1\":16308224,\"iPad13,7\":16308224,\"iPhone13,4\":16312320,\"iPhone12,5\":16312320,\"iPhone8,4\":16304128,\"iPad14,5-A\":16308224,\"iPhone15,5\":16308224,\"iPhone10,1\":16304128,\"iPad11,1\":16308224,\"iPad14,6-B\":16308224,\"iPad13,4\":16308224,\"iPad8,4\":16308224,\"iPad13,6\":16308224}},\"relationships\":{\"developer\":{\"href\":\"/v1/catalog/us/apps/1547137474/developer?l=en-US\",\"data\":[{\"id\":\"983733173\",\"type\":\"developers\",\"href\":\"/v1/catalog/us/developers/983733173?l=en-US\",\"attributes\":{\"genreNames\":[],\"editorialArtwork\":{},\"name\":\"Maximilian Munker\",\"mediaType\":\"Mobile Software Applications\",\"url\":\"https://apps.apple.com/us/developer/maximilian-munker/id983733173\"}}]},\"genres\":{\"href\":\"/v1/catalog/us/apps/1547137474/genres?l=en-US\",\"data\":[{\"id\":\"6007\",\"type\":\"genres\",\"href\":\"/v1/catalog/us/genres/6007?l=en-US\",\"attributes\":{\"parentName\":\"App Store\",\"name\":\"Productivity\",\"parentId\":\"36\",\"url\":\"https://itunes.apple.com/us/genre/id6007\"}},{\"id\":\"6013\",\"type\":\"genres\",\"href\":\"/v1/catalog/us/genres/6013?l=en-US\",\"attributes\":{\"parentName\":\"App Store\",\"name\":\"Health \u0026 Fitness\",\"parentId\":\"36\",\"url\":\"https://itunes.apple.com/us/genre/id6013\"}}]}},\"meta\":{\"contentVersion\":{\"RTCI\":1731378608631,\"MZ_INDEXER\":1731712183373}}},{\"id\":\"6443657745\",\"type\":\"apps\",\"href\":\"/v1/catalog/us/apps/6443657745?l=en-US\",\"attributes\":{\"distributionKind\":\"APP_STORE\",\"supportsArcade\":false,\"isFirstPartyHideableApp\":false,\"privacy\":{\"privacyTypes\":[{\"privacyType\":\"Data Not Collected\",\"identifier\":\"DATA_NOT_COLLECTED\",\"description\":\"The developer does not collect any data from this app.\",\"dataCategories\":[]}]},\"contentRatingsBySystem\":{\"appsApple\":{\"name\":\"4+\",\"value\":100,\"rank\":1}},\"deviceFamilies\":[\"iphone\",\"ipad\"],\"supportsStreamlinedBuy\":true,\"url\":\"https://apps.apple.com/us/app/bb-screen-time-app-blocker/id6443657745\",\"userRating\":{\"value\":4.9,\"ratingCount\":247,\"ratingCountList\":[3,1,0,16,227],\"ariaLabelForRatings\":\"4.9 stars\"},\"firstVersionSupportingInAppPurchaseApi\":\"1.2.9\",\"genreDisplayName\":\"Productivity\",\"name\":\"BB - Screen Time \u0026 App Blocker\",\"isPreorder\":false,\"artistName\":\"Bruno da Rocha e Silva\",\"reviewsRestricted\":false,\"isIOSBinaryMacOSCompatible\":false,\"requirementsByDeviceFamily\":{\"iphone\":{\"deviceFamily\":\"iPhone\",\"requirementString\":\"Requires iOS 16.0 or later.\"},\"ipad\":{\"deviceFamily\":\"iPad\",\"requirementString\":\"Requires iPadOS 16.0 or later.\"},\"realityDevice\":{\"deviceFamily\":\"Apple Vision\",\"requirementString\":\"Requires visionOS 1.0 or later.\"}},\"platformAttributes\":{\"ios\":{\"minimumMacOSVersion\":\"13.0\",\"description\":{\"standard\":\"Apps like social media use powerful psychological tricks to make you unable to stay away from them for too long. Burnout Buddy blocks these apps when you don't want to use them to help you break free and heal their impact on your mental health.\\n\\n* Fight social media addiction\\n* Reduce screen time and improve your focus\\n* Multiple blocking mechanisms\\n* Completely free for most use cases\\n* No account creation or shady VPNs\\n\\nBurnout Buddy is stronger than your iPhone's native Screen Time controls. Designed specifically with social media addiction and unhealthy work habits in mind, it offers a wider variety of blocking mechanisms and allows you to be extremely specific regarding how access to a specific group of apps and websites should be restricted. If you already use Burnout Buddy, keep an eye out for updates that add even more blocking mechanisms and customization points!\\n\\nMAIN FEATURES\\n\\n* Block indefinitely\\n* Schedule-based blocking\\n* Usage-based blocking\\n* Location-based blocking (via Siri)\\n* Focus Mode-based blocking (via Siri)\\n* Siri-based Blocking: Build your own custom blocking conditions by integrating BB with Siri and the Shortcuts app!\\n* Multiple Conditions: Configure multiple blocking conditions for a single group of content for maximum control of your habits.\\n* Multiple Configurations: Want to block a certain group of apps under certain conditions but also another group under other conditions? No problem!\\n* Strict Mode: Have the bad habit of \\\"cheating\\\" app blockers by snoozing them? Strict Mode bans you from updating/deleting schemas when they're active.\\n* Starter Schemas: Plug-and-play configurations that cover the most common reasons people use Burnout Buddy for.\\n* Widgets\\n• Custom App Icons\\n* Block Uninstall\\n* Block Screen Customization\\n• Push Notifications\\n\\n• • •\\n\\nTry Burnout Buddy for free and start taking control of your digital habits today.\\n\\nWant to know more and see what's coming next? Check out BB at https://burnoutbuddy.io!\\nQuestions or feedback? You can reach out to us on Twitter at @BurnoutBuddy.\"},\"isStandaloneWithCompanionForWatchOS\":false,\"isAppleWatchSupported\":false,\"requiredCapabilitiesForRealityDevice\":\"arm64 \",\"versionHistory\":[{\"versionDisplay\":\"1.3.1\",\"releaseNotes\":\"- You can now prevent apps from being uninstalled when a schema with Strict Mode is active. Check it out in the Settings tab!\\n- You can now personalize Strict Mode! If you think the default Strict Mode is too easy / too hard, you can now tweak it via the Settings tab.\\n- Added two new Siri Shortcuts for Custom Conditions: Set Custom Condition and Toggle Custom Condition.\\n- The Daily Usage Limit condition can now be configured to take into account all device usage, not just the schema's selected content.\",\"releaseDate\":\"2024-10-07\",\"releaseTimestamp\":\"2024-10-07T05:35:18Z\"},{\"versionDisplay\":\"1.3.0\",\"releaseNotes\":\"- You can now personalize Strict Mode! If you think the default Strict Mode is too easy / too hard, you can now tweak it via the Settings tab.\\n- Added two new Siri Shortcuts for Custom Conditions: Set Custom Condition and Toggle Custom Condition.\\n- The Daily Usage Limit condition can now be configured to take into account all device usage, not just the schema's selected content.\",\"releaseDate\":\"2024-09-30\",\"releaseTimestamp\":\"2024-09-30T16:32:05Z\"},{\"versionDisplay\":\"1.2.24\",\"releaseNotes\":\"- The Daily Usage Limit condition can now be configured to take into account _all_ device usage, not just the schema's selected content.\\n- Improved how schema processing works. This means schemas should hopefully now always be processed instantly, meaning you won't be seeing the \\\"schema hasn't been processed yet\\\" warning again!\",\"releaseDate\":\"2024-09-17\",\"releaseTimestamp\":\"2024-09-17T20:30:08Z\"},{\"versionDisplay\":\"1.2.23\",\"releaseNotes\":\"Fixed a bug where a schema would never finish processing depending on certain OS versions.\",\"releaseDate\":\"2024-09-16\",\"releaseTimestamp\":\"2024-09-16T21:46:20Z\"},{\"versionDisplay\":\"1.2.22\",\"releaseNotes\":\"Small improvement to the alternate icons feature, further reducing BB's (already small) app size!\",\"releaseDate\":\"2024-08-26\",\"releaseTimestamp\":\"2024-08-26T09:17:18Z\"},{\"versionDisplay\":\"1.2.21\",\"releaseNotes\":\"Fixed a small bug where custom block screen images were showing up smaller and blurrier than intended.\",\"releaseDate\":\"2024-08-08\",\"releaseTimestamp\":\"2024-08-08T13:58:26Z\"},{\"versionDisplay\":\"1.2.20\",\"releaseNotes\":\"- Fixed a case where BB would allow you to go over iOS's limit for how many apps/websites a screen time app like BB can track at once, resulting in a bug where the home screen would claim that a schema was successfully published when in reality it would cause iOS to ignore all apps/websites going over said limit. Attempting to publish a schema will now show a warning in such cases with tips on preventing it.\\n- Fixed a case where BB's schema Widget would not show up correctly in certain iOS versions.\\n- When an entire category is selected, the Edit Schema screen will now warn you that certain apps are ignored from the selection depending on your phone's Screen Time settings.\",\"releaseDate\":\"2024-07-21\",\"releaseTimestamp\":\"2024-07-21T10:11:16Z\"},{\"versionDisplay\":\"1.2.19\",\"releaseNotes\":\"Fixes a small bug where tapping the empty area of cells including multiple buttons, such as the usage limit condition's configuration box, would result in the cell's buttons believing they were pressed when in reality they were not.\",\"releaseDate\":\"2024-07-14\",\"releaseTimestamp\":\"2024-07-14T10:14:21Z\"},{\"versionDisplay\":\"1.2.18\",\"releaseNotes\":\"- Fixed usage limit conditions not working correctly for users in iOS 17.4. Before 17.4 iOS considered past usage when calculating if the limit was reached, but iOS 17.4 changed how that works. This BB update fixes that, so usage limit conditions should now be working properly again. You can apply the fix by simply re-publishing one of your schemas after updating to this version.\\n- The Home screen will now more accurately reflect the status of schemas containing usage limit conditions. Before this update, the app would sometimes tell you that a schema finished processing when that was actually not the case, leading to confusing/misleading statuses.\",\"releaseDate\":\"2024-06-16\",\"releaseTimestamp\":\"2024-06-16T10:56:55Z\"},{\"versionDisplay\":\"1.2.17\",\"releaseNotes\":\"Fixed a case where BB would incorrectly claim that the schemas failed to be published in cases where the device simply happened to need a bit more time to process them. The message has been replaced and will now better describe this scenario.\",\"releaseDate\":\"2024-05-14\",\"releaseTimestamp\":\"2024-05-14T01:39:11Z\"},{\"versionDisplay\":\"1.2.16\",\"releaseNotes\":\"BB went to a couple of anxiety therapy sessions and has now learned that it should wait a couple of seconds before assuming that a schema failed to be published. This fixes a bug where an error view would incorrectly be displayed (and quickly disappear shortly after) in cases where iOS would take slightly longer than expected to process a schema.\",\"releaseDate\":\"2024-04-07\",\"releaseTimestamp\":\"2024-04-07T11:09:55Z\"},{\"versionDisplay\":\"1.2.15\",\"releaseNotes\":\"No new functionality; this update just adds the privacy manifests that Apple now requires apps to provide. Which was very easy to do, since BB doesn't track any information whatsoever :)\",\"releaseDate\":\"2024-03-05\",\"releaseTimestamp\":\"2024-03-05T16:05:42Z\"},{\"versionDisplay\":\"1.2.14\",\"releaseNotes\":\"- You can now customize BB's block screen by changing its icon, title, and message! You can find this feature in the Settings tab under \\\"Block Screen\\\".\",\"releaseDate\":\"2023-04-25\",\"releaseTimestamp\":\"2023-04-25T05:59:30Z\"},{\"versionDisplay\":\"1.2.13\",\"releaseNotes\":\"- Fixed a bug where updating to the previous version would cause the app's Shortcuts to vanish. Sorry for that! If it still doesn't show up for you, let us know!\",\"releaseDate\":\"2023-04-20\",\"releaseTimestamp\":\"2023-04-20T18:18:26Z\"},{\"versionDisplay\":\"1.2.12\",\"releaseNotes\":\"Improved the error message in a rare scenario where iOS fails to grant BB access to Screen Time if your phone happens to not have Face ID enabled.\",\"releaseDate\":\"2023-04-15\",\"releaseTimestamp\":\"2023-04-15T14:32:31Z\"},{\"versionDisplay\":\"1.2.11\",\"releaseNotes\":\"- Added support for Widgets! You can now add a widget in your home screen that shows which of your schemas are currently active.\\n- Schemas now clarify how website blocking works.\\n\",\"releaseDate\":\"2023-03-04\",\"releaseTimestamp\":\"2023-03-04T13:49:11Z\"},{\"versionDisplay\":\"1.2.10\",\"releaseNotes\":\"- When attempting to open a blocked app or website, you'll now be told exactly which schema / condition is keeping it blocked!\\n- Schemas that are active and in strict mode will now be displayed slightly differently on your home screen.\\n- Added a new starter schema: \\\"Quick Block\\\".\\n- The Custom Condition section now contains instructions on how to use the Siri Shortcuts integration!\\n- Adding a schedule condition now requires one less tap.\\n- Many minor UI improvements to different features.\\n- Improved how certain features look on iPads.\",\"releaseDate\":\"2023-02-18\",\"releaseTimestamp\":\"2023-02-18T23:48:17Z\"},{\"versionDisplay\":\"1.2.9\",\"releaseNotes\":\"- When attempting to open a blocked app or website, you'll now be told exactly which schema / condition is keeping it blocked!\\n- Schemas that are active and in strict mode will now be displayed slightly differently on your home screen.\\n- The Custom Condition section now contains instructions on how to use the Siri Shortcuts integration!\\n- Adding a schedule condition now requires one less tap.\\n- A couple of minor UI improvements to different features.\\n- Slightly improved how certain features look on iPads.\",\"releaseDate\":\"2023-02-02\",\"releaseTimestamp\":\"2023-02-02T16:43:00Z\"},{\"versionDisplay\":\"1.2.8\",\"releaseNotes\":\"- You can now configure push notifications to also play a sound! You can find this setting in the Push Notifications view alongside the other existing settings.\\n- This will not affect you who have already been using Burnout Buddy for a while, but small adjustments have been made to some texts that show up the first couple of times you use Burnout Buddy.\",\"releaseDate\":\"2023-01-11\",\"releaseTimestamp\":\"2023-01-11T22:21:20Z\"},{\"versionDisplay\":\"1.2.7\",\"releaseNotes\":\"We thought you were probably bored of seeing a lengthy explanation of what a Custom Condition is every time you modified a schema, so the explanation is now hidden behind a special button.\",\"releaseDate\":\"2023-01-05\",\"releaseTimestamp\":\"2023-01-05T20:31:01Z\"},{\"versionDisplay\":\"1.2.6\",\"releaseNotes\":\"- Schedules will now follow your phone's configured time format! If your phone is configured to display hours in the 12-hour format, your schedules will now reflect that.\",\"releaseDate\":\"2022-12-27\",\"releaseTimestamp\":\"2022-12-27T19:58:25Z\"},{\"versionDisplay\":\"1.2.5\",\"releaseNotes\":\"This version brings UI improvements to some of the recently added features!\\n\\n- Haptic feedback has been added to the action of deleting schemas as well.\\n- Actions that require you to wait a little bit will now look slightly different than they used to.\\n- Strict Mode has had its UI revamped.\\n- Fixed an embarrassing typo on push notifications involving Siri Shortcuts.\\n\",\"releaseDate\":\"2022-12-20\",\"releaseTimestamp\":\"2022-12-20T07:54:05Z\"},{\"versionDisplay\":\"1.2.4\",\"releaseNotes\":\"- Added support for Siri Shortcuts: You can now activate schemas via Siri and actions in the Shortcuts app. See \\\"Custom Condition\\\" within a schema for more details!\\n- You can now configure push notifications for more than just entered schemas and limit warnings. Check the new Push Notifications screen in the Settings tab!\\n- You can now configure exactly what you want to receive push notifications for.\\n- \\\"Block Indefinitely\\\" is now part of the new \\\"Custom Condition\\\".\\n- Fixed push notifications not respecting the toggle in the Settings tab.\\n- Fixed Strict Mode being strict even when the schema was not active.\\n- Small UI/UX improvements to different features, including an updated design to the screen that shows up when you try to use something that's being actively blocked!\\n\\n(The way schemas are handled by the app had to be slightly modified in order to support the new features. If you see any strange behavior, don't hesitate to send us feedback via the Settings tab!)\",\"releaseDate\":\"2022-12-15\",\"releaseTimestamp\":\"2022-12-15T07:52:47Z\"},{\"versionDisplay\":\"1.2.3\",\"releaseNotes\":\"- Added support for Siri Shortcuts: You can now activate schemas via Siri and actions in the Shortcuts app. See \\\"Custom Condition\\\" within a schema for more details!\\n- You can now configure push notifications for more than just entered schemas and limit warnings. Check the new Push Notifications screen in the Settings tab!\\n- You can now configure exactly what you want to receive push notifications for.\\n- \\\"Block Indefinitely\\\" is now part of the new \\\"Custom Condition\\\".\\n- Fixed push notifications not respecting the toggle in the Settings tab.\\n- Fixed Strict Mode being strict even when the schema was not active.\\n- Small UI/UX improvements to different features, including an updated design to the screen that shows up when you try to use something that's being actively blocked!\\n\\n(The way schemas are handled by the app had to be slightly modified in order to support the new features. If you see any strange behavior, don't hesitate to send us feedback via the Settings tab!)\",\"releaseDate\":\"2022-12-13\",\"releaseTimestamp\":\"2022-12-13T08:11:09Z\"},{\"versionDisplay\":\"1.2.2\",\"releaseNotes\":\"- Added support for Siri Shortcuts: You can now activate schemas via Siri and actions in the Shortcuts app. See \\\"Custom Condition\\\" within a schema for more details!\\n- \\\"Block Indefinitely\\\" is now part of the new \\\"Custom Condition\\\".\\n- Fixed push notifications not respecting the toggle in the Settings tab.\\n- Fixed Strict Mode being strict even when the schema was not active.\\n- Small UI/UX improvements to different features, including an updated design to the \\\"block\\\" screen!\",\"releaseDate\":\"2022-12-09\",\"releaseTimestamp\":\"2022-12-09T08:57:47Z\"}],\"websiteUrl\":\"https://burnoutbuddy.io\",\"isXROSCompatible\":true,\"minimumXROSVersion\":\"1.0\",\"hasSafariExtension\":false,\"messagesScreenshots\":{},\"requiresGameController\":false,\"offers\":[{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=6443657745\u0026pricingParameters=STDQ\u0026pg=default\u0026appExtVrsId=869515104\",\"type\":\"get\",\"priceFormatted\":\"$0.00\",\"price\":0,\"currencyCode\":\"USD\",\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":5001216}]},{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=6443657745\u0026pricingParameters=SWUPD\u0026pg=default\u0026appExtVrsId=869515104\",\"type\":\"update\",\"priceFormatted\":\"$0.00\",\"price\":0,\"currencyCode\":\"USD\",\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":5001216}]}],\"requires32bit\":false,\"releaseDate\":\"2022-10-13\",\"hasInAppPurchases\":true,\"bundleId\":\"com.rockbruno.ios.BurnoutBuddy\",\"hasMessagesExtension\":false,\"artwork\":{\"width\":1024,\"height\":1024,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Purple221/v4/8a/35/40/8a354070-6396-5d64-e007-c3c2545fd8d7/AppIcon-0-0-1x_U007emarketing-0-8-0-85-220.png/{w}x{h}{c}.{f}\",\"bgColor\":\"5c9fed\",\"textColor1\":\"011128\",\"textColor2\":\"13203c\",\"textColor3\":\"132e50\",\"textColor4\":\"22395f\"},\"privacyPolicyUrl\":\"https://burnoutbuddy.rockbruno.com/privacy.html\",\"videoPreviewsByType\":{},\"isStandaloneForWatchOS\":false,\"isHiddenFromSpringboard\":false,\"supportURLForLanguage\":\"https://twitter.com/burnoutbuddy\",\"isDeliveredInIOSAppForWatchOS\":false,\"editorialArtwork\":{\"contentIconTrimmedMonochrome\":{\"width\":1048,\"height\":1080,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Features116/v4/6e/e2/e7/6ee2e7db-bf98-0d30-7adf-15aa80debeb5/721e011e-109f-4227-8978-1f8c6071c48f.png/{w}x{h}{c}.{f}\",\"bgColor\":\"000000\",\"textColor1\":\"f2f2f2\",\"textColor2\":\"e5e5e5\",\