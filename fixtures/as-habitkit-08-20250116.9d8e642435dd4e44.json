identifier\":\"DIAGNOSTICS\"}]}]},\"contentRatingsBySystem\":{\"appsApple\":{\"name\":\"4+\",\"value\":100,\"rank\":1}},\"deviceFamilies\":[\"iphone\",\"ipad\",\"ipod\"],\"supportsStreamlinedBuy\":true,\"url\":\"https://apps.apple.com/us/app/habit-tracker-thefor/id1671322093\",\"userRating\":{\"value\":4.9,\"ratingCount\":49,\"ratingCountList\":[0,0,0,5,44],\"ariaLabelForRatings\":\"4.9 stars\"},\"firstVersionSupportingInAppPurchaseApi\":\"1.0.1\",\"genreDisplayName\":\"Productivity\",\"name\":\"Habit Tracker: TheFor\",\"isPreorder\":false,\"artistName\":\"Siraj Hasanov\",\"reviewsRestricted\":false,\"isIOSBinaryMacOSCompatible\":true,\"requirementsByDeviceFamily\":{\"ipod\":{\"deviceFamily\":\"iPod touch\",\"requirementString\":\"Requires iOS 12.0 or later.\"},\"ipad\":{\"deviceFamily\":\"iPad\",\"requirementString\":\"Requires iPadOS 12.0 or later.\"},\"iphone\":{\"deviceFamily\":\"iPhone\",\"requirementString\":\"Requires iOS 12.0 or later.\"},\"mac\":{\"deviceFamily\":\"Mac\",\"requirementString\":\"Requires macOS 11.0 or later and a Mac with Apple M1 chip or later.\"},\"realityDevice\":{\"deviceFamily\":\"Apple Vision\",\"requirementString\":\"Requires visionOS 1.0 or later.\"}},\"platformAttributes\":{\"ios\":{\"minimumMacOSVersion\":\"11.0\",\"description\":{\"standard\":\"Transform Your Life with Our Powerful Habit Tracking App!\\n\\nAre you ready to take control of your life and become the best version of yourself? Look no further! Our app is your ultimate companion on your journey to forming and maintaining healthy habits, boosting productivity, and achieving self-improvement goals.\\n\\nHere's what sets our app apart:\\n\\nEffortless Habit Tracking:\\nEasily monitor your daily habits on the main screen, ensuring you stay focused on what matters most today. With a simple swipe, you can mark each habit as complete, making tracking a breeze.\\n\\nComprehensive Weekly Overview:\\nGet a bird's-eye view of all your habits and their weekly progress. Our app helps you visualize your achievements and areas that need improvement, keeping you on track for long-term success.\\n\\nTrack Your Habit History:\\nGain valuable insights into your habit journey by reviewing your historical data. Watch as you make progress and transform into a better version of yourself over time.\\n\\nUnlimited Habit Creation:\\nUnlike many habit trackers, our app allows you to create an unlimited number of habits. Whether you want to focus on fitness, mindfulness, or personal growth, we've got you covered.\\n\\nStunning New Widgets:\\nExciting news! We've introduced four beautiful widgets to make sticking to your habits even more enjoyable and convenient. These widgets keep your habits front and center, ensuring you never lose sight of your goals.\\n\\nOur app is optimized for those seeking habit trackers, routines, and self-help tools. Start your journey towards a healthier, more productive, and improved self today. Download now and watch your habits transform your life!\\nhttps://thefor.xyz/terms\"},\"isStandaloneWithCompanionForWatchOS\":false,\"isAppleWatchSupported\":false,\"requiredCapabilitiesForRealityDevice\":\"arm64 \",\"versionHistory\":[{\"versionDisplay\":\"1.4.1\",\"releaseNotes\":\"Now you can choose a colour for habits from the colour picker\",\"releaseDate\":\"2024-08-08\",\"releaseTimestamp\":\"2024-08-08T10:18:02Z\"},{\"versionDisplay\":\"1.4.0\",\"releaseNotes\":\"Introducing a new way to stay motivated! Track your habits together with friends and achieve your goals as a team. \",\"releaseDate\":\"2024-06-25\",\"releaseTimestamp\":\"2024-06-25T08:06:15Z\"},{\"versionDisplay\":\"1.3.6\",\"releaseNotes\":\"Design improvements\",\"releaseDate\":\"2024-06-06\",\"releaseTimestamp\":\"2024-06-06T20:26:53Z\"},{\"versionDisplay\":\"1.3.5\",\"releaseNotes\":\"Performance Improvements\",\"releaseDate\":\"2024-05-01\",\"releaseTimestamp\":\"2024-05-01T08:09:59Z\"},{\"versionDisplay\":\"1.3.3\",\"releaseNotes\":\"Performance Improvements\",\"releaseDate\":\"2024-04-08\",\"releaseTimestamp\":\"2024-04-08T09:38:57Z\"},{\"versionDisplay\":\"1.3.2\",\"releaseNotes\":\"Introducing Routine AI: Boost your productivity! Create customised routines to achieve your goals.\\n\",\"releaseDate\":\"2024-04-02\",\"releaseTimestamp\":\"2024-04-02T07:24:46Z\"},{\"versionDisplay\":\"1.3.1\",\"releaseNotes\":\"Introducing Routine AI: Boost your productivity! Create customised routines to achieve your goals.\",\"releaseDate\":\"2024-03-29\",\"releaseTimestamp\":\"2024-03-29T19:30:30Z\"},{\"versionDisplay\":\"1.3.0\",\"releaseNotes\":\"Performance Improvements\",\"releaseDate\":\"2024-03-16\",\"releaseTimestamp\":\"2024-03-16T00:52:00Z\"},{\"versionDisplay\":\"1.2.9\",\"releaseNotes\":\"Performance Improvements\",\"releaseDate\":\"2024-03-14\",\"releaseTimestamp\":\"2024-03-14T04:03:06Z\"},{\"versionDisplay\":\"1.2.8\",\"releaseNotes\":\"Now you can group your habits into Routines. You can easily switch between Routines to focus on what is important\\n\",\"releaseDate\":\"2024-03-07\",\"releaseTimestamp\":\"2024-03-07T10:22:31Z\"},{\"versionDisplay\":\"1.2.7\",\"releaseNotes\":\"Now you can group your habits into Routines. You can easily switch between Routines to focus on what is important\",\"releaseDate\":\"2024-03-06\",\"releaseTimestamp\":\"2024-03-06T01:12:57Z\"},{\"versionDisplay\":\"1.2.6\",\"releaseNotes\":\"Introducing Journaling. Now you can make notes about your habits or just keep a journal.\",\"releaseDate\":\"2024-02-11\",\"releaseTimestamp\":\"2024-02-11T17:00:50Z\"},{\"versionDisplay\":\"1.2.5\",\"releaseNotes\":\"Bug fixes and Performance Improvements\",\"releaseDate\":\"2024-02-06\",\"releaseTimestamp\":\"2024-02-06T23:11:06Z\"},{\"versionDisplay\":\"1.2.4\",\"releaseNotes\":\"- Now you can share beautiful screenshots of your habits.\\n- You can now change the colour scheme of the app. You can also change the order of the main screen tabs in Settings\",\"releaseDate\":\"2024-02-06\",\"releaseTimestamp\":\"2024-02-06T04:02:40Z\"},{\"versionDisplay\":\"1.2.2\",\"releaseNotes\":\"Now introducing the highly requested Lifetime Subscription option for an uninterrupted Pro experience. We have also added the ability to set monthly habits.\",\"releaseDate\":\"2024-01-24\",\"releaseTimestamp\":\"2024-01-24T19:12:02Z\"},{\"versionDisplay\":\"1.2.1\",\"releaseNotes\":\"Introducing the latest version of our app, now equipped with enhanced features for Goal setting in habits! Users can now achieve multiple completions for their habits, accompanied by visually appealing charts that vividly showcase their progress\\n\",\"releaseDate\":\"2024-01-17\",\"releaseTimestamp\":\"2024-01-17T17:35:22Z\"},{\"versionDisplay\":\"1.2.0\",\"releaseNotes\":\"Introducing Routines: Explore the daily habits of fascinating individuals. Additionally, we're rolling out Articles—delve into the lifestyle of your favorite personalities to gain insights before adopting their routines. Discover a richer, more informed experience with our latest updates!\",\"releaseDate\":\"2023-12-09\",\"releaseTimestamp\":\"2023-12-09T21:21:13Z\"},{\"versionDisplay\":\"1.1.0\",\"releaseNotes\":\"Introducing flexible start-of-week options – now you can customize your routine by choosing to begin your week on either Saturday or Sunday!\",\"releaseDate\":\"2023-11-15\",\"releaseTimestamp\":\"2023-11-15T13:03:28Z\"},{\"versionDisplay\":\"1.0.10\",\"releaseNotes\":\"Archive old habits for a clean slate and fresh start!\",\"releaseDate\":\"2023-10-18\",\"releaseTimestamp\":\"2023-10-18T06:58:36Z\"},{\"versionDisplay\":\"1.0.9\",\"releaseNotes\":\"Introducing streaks: a new way to track your daily progress.\",\"releaseDate\":\"2023-10-16\",\"releaseTimestamp\":\"2023-10-16T16:30:06Z\"},{\"versionDisplay\":\"1.0.8\",\"releaseNotes\":\"Introducing streaks: a new way to track your daily progress.\",\"releaseDate\":\"2023-10-16\",\"releaseTimestamp\":\"2023-10-16T07:58:52Z\"},{\"versionDisplay\":\"1.0.6\",\"releaseNotes\":\"We are introducing stunning new widgets to help you effortlessly stay on track with your habits and routines.\",\"releaseDate\":\"2023-10-10\",\"releaseTimestamp\":\"2023-10-10T13:25:43Z\"},{\"versionDisplay\":\"1.0.5\",\"releaseNotes\":\"4 new type of beautiful widgets\",\"releaseDate\":\"2023-09-21\",\"releaseTimestamp\":\"2023-09-21T10:12:16Z\"},{\"versionDisplay\":\"1.0.4\",\"releaseNotes\":\"* You can now switch the app theme to dark/light mode independent on the system theme\\n* You can now skip habits for the current day\\n\\n\",\"releaseDate\":\"2023-09-13\",\"releaseTimestamp\":\"2023-09-13T00:27:54Z\"},{\"versionDisplay\":\"1.0.3\",\"releaseNotes\":\"* Yearly/Overall Habits View\\n* Bug fixes\",\"releaseDate\":\"2023-08-29\",\"releaseTimestamp\":\"2023-08-29T12:37:42Z\"}],\"websiteUrl\":\"https://thefor.xyz\",\"isXROSCompatible\":true,\"minimumXROSVersion\":\"1.0\",\"hasSafariExtension\":false,\"messagesScreenshots\":{},\"requiresGameController\":false,\"offers\":[{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=1671322093\u0026pricingParameters=STDQ\u0026pg=default\u0026appExtVrsId=867322189\",\"type\":\"get\",\"priceFormatted\":\"$0.00\",\"price\":0,\"currencyCode\":\"USD\",\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":65660928}]},{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=1671322093\u0026pricingParameters=SWUPD\u0026pg=default\u0026appExtVrsId=867322189\",\"type\":\"update\",\"priceFormatted\":\"$0.00\",\"price\":0,\"currencyCode\":\"USD\",\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":65660928}]}],\"requires32bit\":false,\"releaseDate\":\"2023-02-24\",\"hasInAppPurchases\":true,\"bundleId\":\"xyz.thefor.habits.habits\",\"hasMessagesExtension\":false,\"artwork\":{\"width\":1024,\"height\":1024,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Purple221/v4/33/c3/15/33c315e0-87d1-68a9-8f6c-a73e564d1fdd/AppIcon-0-0-1x_U007emarketing-0-7-0-0-85-220.png/{w}x{h}{c}.{f}\",\"bgColor\":\"ffffff\",\"textColor1\":\"09100d\",\"textColor