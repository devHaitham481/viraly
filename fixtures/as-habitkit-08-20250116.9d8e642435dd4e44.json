ple\":{\"name\":\"4+\",\"value\":100,\"rank\":1}},\"deviceFamilies\":[\"iphone\",\"ipad\"],\"supportsStreamlinedBuy\":true,\"url\":\"https://apps.apple.com/us/app/blank-spaces-launcher/id1570856853\",\"userRating\":{\"value\":4.2,\"ratingCount\":855,\"ratingCountList\":[102,31,47,71,604],\"ariaLabelForRatings\":\"4.2 stars\"},\"firstVersionSupportingInAppPurchaseApi\":\"1.0\",\"genreDisplayName\":\"Productivity\",\"name\":\"Blank Spaces Launcher (-)\",\"isPreorder\":false,\"artistName\":\"Ecstasis LLC\",\"reviewsRestricted\":false,\"isIOSBinaryMacOSCompatible\":false,\"requirementsByDeviceFamily\":{\"ipad\":{\"deviceFamily\":\"iPad\",\"requirementString\":\"Requires iPadOS 16.0 or later.\"},\"iphone\":{\"deviceFamily\":\"iPhone\",\"requirementString\":\"Requires iOS 16.0 or later.\"},\"realityDevice\":{\"deviceFamily\":\"Apple Vision\",\"requirementString\":\"Requires visionOS 1.0 or later.\"}},\"platformAttributes\":{\"ios\":{\"minimumMacOSVersion\":\"13.0\",\"description\":{\"standard\":\"Blank Spaces is a minimal home screen launcher that eliminates distraction from your phone.  We believe that technology should empower us, not take away our attention.\\n\\n• Simplify your home screen\\nThis small, beautiful widget lives on your home screen and gives you access to your most important apps without the clutter.\\n\\n• Take back your focus\\nBlank Spaces mutes all sources of distraction, including badges and app icons.  Get back to using your phone as a tool and focusing on what matters in life.\\n\\n• Easy to use\\nThe app is designed to be completely intuitive, and the widget can be installed in 60 seconds.\\n\\n• Completely secure\\nWe believe in openness, privacy, and 100% data ownership.  See our privacy policy at blankspaces.app/privacy.\\n\\n\\nBLANK SPACES SUBSCRIPTION\\n\\nBlank Spaces comes with a 7-day free trial.  After the free trial period ends you will need to subscribe.\\n\\nYou can subscribe to Blank Spaces, choosing from the following plans:\\n\\n• 1 month - $3.99\\n\\n• 1 year - $17.99\\n\\n• Lifetime - $23.99\\n\\nThe subscription automatically renews unless auto-renewal is turned off at least 24 hours before the end of the current period.\\n\\nPayment will be charged to your iTunes account at confirmation of purchase.\\n\\nAccount will be charged for renewal within 24 hours of the end of the current period, and the cost of renewal will be provided.\\n\\n\\nFor more information:\\n\\nTerms of Use - www.blankspaces.app/terms\\n\\nPrivacy Policy - www.blankspaces.app/privacy\\n\\nJoin Us - www.blankspaces.app/cult\"},\"isStandaloneWithCompanionForWatchOS\":false,\"isAppleWatchSupported\":false,\"requiredCapabilitiesForRealityDevice\":\"arm64 \",\"versionHistory\":[{\"versionDisplay\":\"1.132\",\"releaseNotes\":\"This version:\\n• Bug fixes and improvements\\n\\nLast version:\\n• Now supports every app\\n• Wallpaper now works for with large mode\\n• This version will add a small line under each widget, which can be hidden by switching to large mode \\n\\n  /) /) \\n( - .-)\\nO_(\\\")(\\\")\\nChat with us: ask@blankspaces.app\",\"releaseDate\":\"2024-12-26\",\"releaseTimestamp\":\"2024-12-26T21:28:42Z\"},{\"versionDisplay\":\"1.131\",\"releaseNotes\":\"Building...\\n\\n• Now supports every app\\n• Wallpaper now works for with large mode\\n• This version will add a small line under each widget, which can be hidden by switching to large mode \\n\\n  /) /) \\n( - .-)\\nO_(\\\")(\\\")\\nChat with us: ask@blankspaces.app\",\"releaseDate\":\"2024-12-20\",\"releaseTimestamp\":\"2024-12-20T18:31:12Z\"},{\"versionDisplay\":\"1.130\",\"releaseNotes\":\"Building...\\n\\n• Bug fixes\\n\\n  /) /) \\n( - .-)\\nO_(\\\")(\\\")\\nChat with us: ask@blankspaces.app\",\"releaseDate\":\"2024-11-22\",\"releaseTimestamp\":\"2024-11-22T15:19:05Z\"},{\"versionDisplay\":\"1.129\",\"releaseNotes\":\"Ciao!\\n\\n• Bug fixes\\n• Fixed app locking issues\\n• Improved ability to add custom apps\\n• Enabled adding any number of apps to each wi