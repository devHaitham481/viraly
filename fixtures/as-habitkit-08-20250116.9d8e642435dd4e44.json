d-in-apps.5d.20.omit.5bresource.5d.autos.meta.robots.sparselimit.5bapps.3arelated-editorial-items.5d.20.sparselimit.5bapps.3acustomers-also-bought-apps.5d.20.sparselimit.5bapps.3adeveloper-other-apps.5d.20":"{\"x\":1737041860851,\"d\":[{\"id\":\"6443918070\",\"type\":\"apps\",\"href\":\"/v1/catalog/us/apps/6443918070?l=en-US\",\"attributes\":{\"distributionKind\":\"APP_STORE\",\"supportsArcade\":false,\"familyShareEnabledDate\":\"0001-04-23T00:00:00Z\",\"isFirstPartyHideableApp\":false,\"privacy\":{\"privacyTypes\":[{\"privacyType\":\"Data Linked to You\",\"identifier\":\"DATA_LINKED_TO_YOU\",\"description\":\"The following data may be collected and linked to your identity:\",\"dataCategories\":[{\"dataCategory\":\"Purchases\",\"identifier\":\"PURCHASES\"}]},{\"privacyType\":\"Data Not Linked to You\",\"identifier\":\"DATA_NOT_LINKED_TO_YOU\",\"description\":\"The following data may be collected but it is not linked to your identity:\",\"dataCategories\":[{\"dataCategory\":\"Diagnostics\",\"identifier\":\"DIAGNOSTICS\"}]}]},\"contentRatingsBySystem\":{\"appsApple\":{\"name\":\"4+\",\"value\":100,\"rank\":1}},\"deviceFamilies\":[\"iphone\",\"ipod\"],\"supportsStreamlinedBuy\":true,\"usesLocationBackgroundMode\":false,\"url\":\"https://apps.apple.com/us/app/habit-tracker-habitkit/id6443918070\",\"userRating\":{\"value\":4.8,\"ratingCount\":661,\"ratingCountList\":[9,2,16,27,607],\"ariaLabelForRatings\":\"4.8 stars\"},\"firstVersionSupportingInAppPurchaseApi\":\"1.0\",\"genreDisplayName\":\"Productivity\",\"name\":\"Habit Tracker - HabitKit\",\"isPreorder\":false,\"artistName\":\"Sebastian Roehl\",\"reviewsRestricted\":false,\"isIOSBinaryMacOSCompatible\":true,\"requirementsByDeviceFamily\":{\"ipod\":{\"deviceFamily\":\"iPod touch\",\"requirementString\":\"Requires iOS 14.0 or later.\"},\"iphone\":{\"deviceFamily\":\"iPhone\",\"requirementString\":\"Requires iOS 14.0 or later.\"},\"mac\":{\"deviceFamily\":\"Mac\",\"requirementString\":\"Requires macOS 11.0 or later and a Mac with Apple M1 chip or later.\"},\"realityDevice\":{\"deviceFamily\":\"Apple Vision\",\"requirementString\":\"Requires visionOS 1.0 or later.\"}},\"sellerLabel\":\"Seller\",\"hasEula\":false,\"platformAttributes\":{\"ios\":{\"seller\":\"Sebastian Roehl\",\"copyright\":\"© 2023 Sebastian Röhl\",\"minimumMacOSVersion\":\"11.0\",\"description\":{\"standard\":\"HabitKit is the perfect app for anyone looking to form new habits or break old ones. With HabitKit, you can track your progress with beautiful tile-based grid charts. Whether you're trying to quit smoking, eat healthier, or exercise more, HabitKit can help you achieve your goals. You can customize your dashboard by adjusting colors, icons and descriptions. Draw motivation from growing the amount of colored tiles on your habit dashboard.\\n\\n---\\n\\nCREATE HABITS\\nAdd your habits you want to track in a fast and easy way. Provide a name, description, icon and color and you're good to go.\\n\\nDASHBOARD\\nAll your habits are displayed on your dashboard represented by a cool looking grid chart. Every filled out square show a day where you kept up with your habit.\\n\\nCALENDAR\\nThe calendar provides a fast and easy way to manage past completions. Simply tap a day to remove or add a completion.\\n\\nARCHIVE\\nDo you need a break from a habit and don't want to clutter your dashboard with it? Just archive it and restore it at a later point from the menu.\\n\\nIMPORT AND EXPORT\\nSwitching phones and don't want to lose your data? Export your data to a file, save it wherever you want and restore it at a later point of time.\\n\\nPRIVACY FOCUSED\\nAll your data belongs to you and stays on your phone. No sign-in. No servers. No cloud.\\n\\n---\\n\\nTerms of Use: https://www.habitkit.app/tos/\\nPrivacy Policy: https://www.habitkit.app/privacy/\"},\"isStandaloneWithCompanionForWatchOS\":false,\"isAppleWatchSupported\":false,\"is32bitOnly\":false,\"requiredCapabilitiesForRealityDevice\":\"arm64 \",\"versionHistory\":[{\"versionDisplay\":\"1.10.2\",\"releaseNotes\":\"This release includes the following changes:\\n• Remove the \\\"Year In Review\\\" feature from the dashboard\\n• Changing the category icon doesn't apply to the overview\\n• Make categories reorderable\\n• Fix the missing translation for \\\"Create your own\\\"\\n• Make categories deletable (from the overview)\",\"releaseDate\":\"2025-01-08\",\"releaseTimestamp\":\"2025-01-08T09:42:45Z\"},{\"versionDisplay\":\"1.10.1\",\"releaseNotes\":\"This release brings back the \\\"Year In Review\\\" page for everyone.\",\"releaseDate\":\"2024-12-27\",\"releaseTimestamp\":\"2024-12-27T13:14:17Z\"},{\"versionDisplay\":\"1.10.0\",\"releaseNotes\":\"Dashboard Customization: We've added a lot of new customization options to your dashboard.\\n• FEATURE: Display Streaks: You can now display the streak and goals on your habits cards.\\n• FEATURE: Display Labels: You can now display the month and weekday labels on your habits cards.\\n• FEATURE: Display Categories: You can now display the category icons on your habits cards.\\n• FIX: The category filter only allows one selected entry now.\",\"releaseDate\":\"2024-11-26\",\"releaseTimestamp\":\"2024-11-26T09:21:47Z\"},{\"versionDisplay\":\"1.9.5\",\"releaseNotes\":\"This update includes important bug fixes and performance improvements.\",\"releaseDate\":\"2024-11-01\",\"releaseTimestamp\":\"2024-11-01T12:58:46Z\"},{\"versionDisplay\":\"1.9.4\",\"releaseNotes\":\"This update adds support for iOS-18 tinted app icons and introduces new habit icons.\",\"releaseDate\":\"2024-10-29\",\"releaseTimestamp\":\"2024-10-29T10:06:32Z\"},{\"versionDisplay\":\"1.9.3\",\"releaseNotes\":\"This update includes important bugfixes and performance optimizations.\",\"releaseDate\":\"2024-10-22\",\"releaseTimestamp\":\"2024-10-22T08:28:53Z\"},{\"versionDisplay\":\"1.9.2\",\"releaseNotes\":\"This update includes important bugfixes and performance optimizations.\",\"releaseDate\":\"2024-10-01\",\"releaseTimestamp\":\"2024-10-01T08:19:08Z\"},{\"versionDisplay\":\"1.9.1\",\"releaseNotes\":\"This update fixes an issue about the app being stuck on the splash screen.\",\"releaseDate\":\"2024-09-17\",\"releaseTimestamp\":\"2024-09-17T04:38:59Z\"},{\"versionDisplay\":\"1.9.0\",\"releaseNotes\":\"Introducing Categories: Elevate your habit organization with our new category feature. Group related habits together and customize your dashboard for a more focused experience.\",\"releaseDate\":\"2024-09-16\",\"releaseTimestamp\":\"2024-09-16T06:05:32Z\"},{\"versionDisplay\":\"1.8.4\",\"releaseNotes\":\"This release fixes a bug which caused the Month view to ignore the \\\"Week starts on Sunday\\\" option.\",\"releaseDate\":\"2024-08-16\",\"releaseTimestamp\":\"2024-08-16T07:57:42Z\"},{\"versionDisplay\":\"1.8.3\",\"releaseNotes\":\"This release includes important bugfixes and performance improvements.\",\"releaseDate\":\"2024-08-09\",\"releaseTimestamp\":\"2024-08-09T08:34:26Z\"},{\"versionDisplay\":\"1.8.2\",\"releaseNotes\":\"This release includes important bugfixes and performance improvements.\",\"releaseDate\":\"2024-07-30\",\"releaseTimestamp\":\"2024-07-30T06:29:08Z\"},{\"versionDisplay\":\"1.8.1\",\"releaseNotes\":\"This release introduces Shortcuts and Automations support. You can now check off your habits based on certain triggers from other apps.\",\"releaseDate\":\"2024-07-23\",\"releaseTimestamp\":\"2024-07-23T07:36:42Z\"},{\"versionDisplay\":\"1.8.0\",\"releaseNotes\":\"Discover new, dynamic ways to navigate your HabitKit dashboard. Choose the streamlined Compact Mode or experience the versatile Month Mode!\",\"releaseDate\":\"2024-07-12\",\"releaseTimestamp\":\"2024-07-12T06:41:07Z\"},{\"versionDisplay\":\"1.7.3\",\"releaseNotes\":\"This release includes the following changes:\\n• Fixes critical layout and color issues for the home screen widgets\\n• Add \\\"Year-In-Review\\\" feature to Statistics screen\\n• Fix duplicate icons\",\"releaseDate\":\"2024-06-28\",\"releaseTimestamp\":\"2024-06-28T05:36:33Z\"},{\"versionDisplay\":\"1.7.2\",\"releaseNotes\":\"This version includes a quicker way to check off yesterday's habits. Simply long-press your habit on the main screen and discover the new context menu.\",\"releaseDate\":\"2024-06-17\",\"releaseTimestamp\":\"2024-06-17T06:37:19Z\"},{\"versionDisplay\":\"1.7.1\",\"releaseNotes\":\"This version fixes a critical bug for devices running on a system version below iOS 17.\",\"releaseDate\":\"2024-06-11\",\"releaseTimestamp\":\"2024-06-11T11:13:55Z\"},{\"versionDisplay\":\"1.7.0\",\"releaseNotes\":\"We upgraded the widgets of the app and added interactivity. Check off your habits right from your home screen!\",\"releaseDate\":\"2024-06-10\",\"releaseTimestamp\":\"2024-06-10T07:10:07Z\"},{\"versionDisplay\":\"1.6.8\",\"releaseNotes\":\"This version includes important bugfixes and performance improvements.\",\"releaseDate\":\"2024-01-07\",\"releaseTimestamp\":\"2024-01-07T15:04:15Z\"},{\"versionDisplay\":\"1.6.7\",\"releaseNotes\":\"This version includes important bugfixes and performance improvements.\",\"releaseDate\":\"2024-01-04\",\"releaseTimestamp\":\"2024-01-04T14:45:11Z\"},{\"versionDisplay\":\"1.6.6\",\"releaseNotes\":\"This version includes important bugfixes and performance improvements.\",\"releaseDate\":\"2024-01-01\",\"releaseTimestamp\":\"2024-01-01T11:02:04Z\"},{\"versionDisplay\":\"1.6.5\",\"releaseNotes\":\"This version includes important bugfixes and performance improvements.\",\"releaseDate\":\"2023-12-30\",\"releaseTimestamp\":\"2023-12-30T21:48:49Z\"},{\"versionDisplay\":\"1.6.4\",\"releaseNotes\":\"Introducing the new Annual Recap feature: Look back on your year with \\\"HabitKit Wrapped\\\" and get inspired by your progress.\",\"releaseDate\":\"2023-12-15\",\"releaseTimestamp\":\"2023-12-15T07:11:05Z\"},{\"versionDisplay\":\"1.6.3\",\"releaseNotes\":\"This version includes important bugfixes and performance improvements.\",\"releaseDate\":\"2023-12-05\",\"releaseTimestamp\":\"2023-12-05T19:37:10Z\"},{\"versionDisplay\":\"1.6.2\",\"releaseNotes\":\"This version includes important bugfixes and performance improvements.\",\"releaseDate\":\"2023-12-02\",\"releaseTimestamp\":\"2023-12-02T10:19:21Z\"}],\"websiteUrl\":\"https://www.habitkit.app\",\"isXROSCompatible\":true,\"minimumXROSVersion\":\"1.0\",\"hasSafariExtension\":false,\"messagesScreenshots\":{},\"languageList\":[\"English\"],\"requiresGameController\":false,\"requiredCapabilities\":\"arm64 \",\"offers\":[{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=6443918070\u0026pricingParameters=STDQ\u0026pg=default\u0026appExtVrsId=871495892\",\"type\":\"get\",\"priceFormatted\":\"$0.00\",\"price\":0,\"currencyCode\":\"USD\",\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":103746560}]},{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=6443918070\u0026pricingParameters=SWUPD\u0026pg=default\u0026appExtVrsId=871495892\",\"type\":\"update\",\"priceFormatted\":\"$0.00\",\"price\":0,\"currencyCode\":\"USD\",\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":103746560}]}],\"requires32bit\":false,\"supportedLocales\":[{\"name\":\"English\",\"tag\":\"en-US\"}],\"isGameCenterEnabled\":false,\"isSiriSupported\":false,\"releaseDate\":\"2022-11-26\",\"minimumOSVersion\":\"14.0\",\"hasInAppPurchases\":true,\"bundleId\":\"com.roehl.habitkit\",\"hasMessagesExtension\":false,\"artwork\":{\"width\":1024,\"height\":1024,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Purple211/v4/2b/ba/8b/2bba8bcd-8c17-797a-3a90-b2d11dbb2e86/AppIcon-0-0-1x_U007emarketing-0-11-0-85-220.png/{w}x{h}{c}.{f}\",\"bgColor\":\"000000\",\"textColor1\":\"99d63f\",\"textColor2\":\"b078e8\",\"textColor3\":\"7aab32\",\"textColor4\":\"8d60b9\"},\"supportsGameController\":false,\"privacyPolicyUrl\":\"https://www.habitkit.app/privacy\",\"videoPreviewsByType\":{},\"hasFamilyShareableInAppPurchases\":false,\"isStandaloneForWatchOS\":false,\"isHiddenFromSpringboard\":false,\"supportURLForLanguage\":\"htt