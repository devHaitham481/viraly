tore\",\"name\":\"Health \u0026 Fitness\",\"parentId\":\"36\",\"url\":\"https://itunes.apple.com/us/genre/id6013\"}}]}},\"meta\":{\"contentVersion\":{\"RTCI\":1736024626483,\"MZ_INDEXER\":1736024145308}}},{\"id\":\"1547137474\",\"type\":\"apps\",\"href\":\"/v1/catalog/us/apps/1547137474?l=en-US\",\"attributes\":{\"distributionKind\":\"APP_STORE\",\"supportsArcade\":false,\"isFirstPartyHideableApp\":false,\"privacy\":{\"privacyTypes\":[{\"privacyType\":\"Data Not Linked to You\",\"identifier\":\"DATA_NOT_LINKED_TO_YOU\",\"description\":\"The following data may be collected but it is not linked to your identity:\",\"dataCategories\":[{\"dataCategory\":\"Identifiers\",\"identifier\":\"IDENTIFIERS\"},{\"dataCategory\":\"Usage Data\",\"identifier\":\"USAGE_DATA\"},{\"dataCategory\":\"Diagnostics\",\"identifier\":\"DIAGNOSTICS\"}]}]},\"contentRatingsBySystem\":{\"appsApple\":{\"name\":\"4+\",\"value\":100,\"rank\":1}},\"deviceFamilies\":[\"iphone\",\"ipod\"],\"chartPositions\":{\"appStore\":{\"position\":191,\"genreName\":\"Productivity\",\"genre\":6007,\"chart\":\"top-free\",\"genreShortName\":\"Productivity\",\"chartLink\":\"https://apps.apple.com/us/charts/iphone/productivity-apps/6007\"}},\"supportsStreamlinedBuy\":true,\"url\":\"https://apps.apple.com/us/app/onrise-habit-tracker-focus/id1547137474\",\"userRating\":{\"value\":4.8,\"ratingCount\":1406,\"ratingCountList\":[8,7,32,105,1254],\"ariaLabelForRatings\":\"4.8 stars\"},\"genreDisplayName\":\"Productivity\",\"name\":\"Onrise: Habit Tracker \u0026 Focus\",\"isPreorder\":false,\"artistName\":\"Maximilian Munker\",\"reviewsRestricted\":false,\"isIOSBinaryMacOSCompatible\":false,\"requirementsByDeviceFamily\":{\"iphone\":{\"deviceFamily\":\"iPhone\",\"requirementString\":\"Requires iOS 13.0 or later.\"},\"ipod\":{\"deviceFamily\":\"iPod touch\",\"requirementString\":\"Requires iOS 13.0 or later.\"},\"realityDevice\":{\"deviceFamily\":\"Apple Vision\",\"requirementString\":\"Requires visionOS 1.0 or later.\"}},\"platformAttributes\":{\"ios\":{\"minimumMacOSVersion\":\"11.0\",\"description\":{\"standard\":\"Onrise helps you to build beneficial habits, provides a Pomodoro timer to work more effectively and increase productivity, and a journal to keep track of everything. Standing on the latest research about behavior design and productivity, Onrise is your guide to achieving your goals. Give it a try and become the person you aspire to be!\"},\"isStandaloneWithCompanionForWatchOS\":false,\"isAppleWatchSupported\":false,\"requiredCapabilitiesForRealityDevice\":\"arm64 \",\"versionHistory\":[{\"versionDisplay\":\"1.1.6\",\"releaseNotes\":\"We've added animations and optional completion sounds, which provide enhanced visual and auditory feedback when marking habits as done. Also fixes minor bugs.\",\"releaseDate\":\"2023-07-02\",\"releaseTimestamp\":\"2023-07-02T13:13:25Z\"},{\"versionDisplay\":\"1.1.5\",\"releaseNotes\":\"With this update, you can now keep a journal within the app to write down notes or thoughts for the day. In addition, reminders are now optional and there are more customization options for the widget.\\n-----\\n1.1.5: Fixes minor bugs and added a contact form.\",\"releaseDate\":\"2023-01-03\",\"releaseTimestamp\":\"2023-01-03T19:26:26Z\"},{\"versionDisplay\":\"1.1.4\",\"releaseNotes\":\"With this update, you can now keep a journal within the app to write down notes or thoughts for the day. In addition, reminders are now optional and there are more customization options for the widget.\\n-----\\n1.1.4: Fixes minor bugs\",\"releaseDate\":\"2022-12-27\",\"releaseTimestamp\":\"2022-12-27T00:11:41Z\"},{\"versionDisplay\":\"1.1.3\",\"releaseNotes\":\"With this update, you can now keep a journal within the app to write down notes or thoughts for the day. In addition, reminders are now optional and there are more customization options for the widget.\",\"releaseDate\":\"2022-12-23\",\"releaseTimestamp\":\"2022-12-23T00:04:34Z\"},{\"versionDisplay\":\"1.1.2\",\"releaseNotes\":\"Set multiple reminders for a day and be reminded at different times each day of the week.\",\"releaseDate\":\"2022-07-19\",\"releaseTimestamp\":\"2022-07-19T20:27:53Z\"},{\"versionDisplay\":\"1.1.1\",\"releaseNotes\":\"Creating habits is now a little more convenient.\",\"releaseDate\":\"2022-01-05\",\"releaseTimestamp\":\"2022-01-05T17:43:13Z\"},{\"versionDisplay\":\"1.1.0\",\"releaseNotes\":\"Wrapped 2021 + the smallest unit is now optional\",\"releaseDate\":\"2021-12-28\",\"releaseTimestamp\":\"2021-12-28T13:14:14Z\"},{\"versionDisplay\":\"1.0.9\",\"releaseNotes\":\"Small adjustments to the calendar and more localizations.\",\"releaseDate\":\"2021-12-04\",\"releaseTimestamp\":\"2021-12-04T01:13:00Z\"},{\"versionDisplay\":\"1.0.8\",\"releaseNotes\":\"- new: all activities for a habit can be viewed in a calendar\\n- small bug fixes and improvements\\n\",\"releaseDate\":\"2021-11-10\",\"releaseTimestamp\":\"2021-11-10T22:00:58Z\"},{\"versionDisplay\":\"1.0.7\",\"releaseNotes\":\"-it is now possible to go back when creating habits\\n-fixes a bug that caused notifications to be sent twice under certain circumstances\\n-it is now indicated if the notifications are disabled and better explained why they are needed\\n-small bug fixes and performance improvements\",\"releaseDate\":\"2021-10-15\",\"releaseTimestamp\":\"2021-10-15T15:37:37Z\"},{\"versionDisplay\":\"1.0.6\",\"releaseNotes\":\"In addition to the streak, there is now an option to see how many times you have already checked off a habit in total.\\nAlso fixes a small bug that causes the widget to check off the wrong day under certain circumstances.\",\"releaseDate\":\"2021-07-06\",\"releaseTimestamp\":\"2021-07-06T18:46:57Z\"},{\"versionDisplay\":\"1.0.5\",\"releaseNotes\":\"Fixes a problem with the widget and optimizes the order\",\"releaseDate\":\"2021-06-17\",\"releaseTimestamp\":\"2021-06-17T13:00:38Z\"},{\"versionDisplay\":\"1.0.4\",\"releaseNotes\":\"Widgets are here! Add a widget to your home screen and never miss a habit again.\",\"releaseDate\":\"2021-06-13\",\"releaseTimestamp\":\"2021-06-13T16:13:42Z\"},{\"versionDisplay\":\"1.0.3\",\"releaseNotes\":\"-the order of your habits can now be changed (long press the name and drag)\\n-German localization\",\"releaseDate\":\"2021-02-06\",\"releaseTimestamp\":\"2021-02-06T11:37:16Z\"},{\"versionDisplay\":\"1.0.2\",\"releaseNotes\":\"Rewards Bugfixes\",\"releaseDate\":\"2021-01-18\",\"releaseTimestamp\":\"2021-01-18T18:48:13Z\"},{\"versionDisplay\":\"1.0.1\",\"releaseNotes\":\"-Added select all button on reminder page\\n-Changes to the help text of the smallest unit page\\n\",\"releaseDate\":\"2021-01-17\",\"releaseTimestamp\":\"2021-01-17T12:16:42Z\"},{\"versionDisplay\":\"1.0\",\"releaseNotes\":null,\"releaseDate\":\"2021-01-03\",\"releaseTimestamp\":\"2021-01-03T23:11:17Z\"}],\"websiteUrl\":\"https://onrise.me\",\"isXROSCompatible\":true,\"minimumXROSVersion\":\"1.0\",\"hasSafariExtension\":false,\"messagesScreenshots\":{},\"requiresGameController\":false,\"offers\":[{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=1547137474\u0026pricingParameters=STDQ\u0026pg=default\u0026appExtVrsId=858087203\",\"type\":\"get\",\"priceFormatted\":\"$0.00\",\"price\":0,\"currencyCode\":\"USD\",\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":16406528}]},{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=1547137474\u0026pricingParameters=SWUPD\u0026pg=default\u0026appExtVrsId=858087203\",\"type\":\"update\",\"priceFormatted\":\"$0.00\",\"price\":0,\"currencyCode\":\"USD\",\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":16406528}]}],\"requires32bit\":false,\"releaseDate\":\"2021-01-03\",\"hasInAppPurchases\":false,\"bundleId\":\"me.onrise\",\"hasMessagesExtension\":false,\"artwork\":{\"width\":1024,\"height\":1024,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Purple126/v4/1b/74/fa/1b74fa97-7c18-77eb-98fb-02fa358ae455/AppIcon-1x_U007emarketing-0-5-0-85-220.png/{w}x{h}{c}.{f}\",\"bgColor\":\"535353\