e6+\":[{\"width\":1242,\"height\":2208,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource221/v4/33/3c/ed/333cedef-fe94-d194-027b-ba20bd8c3cdd/ad40d643-1656-4127-934a-39017ce10cc4_0_APP_IPHONE_55_0.jpg/{w}x{h}{c}.{f}\",\"bgColor\":\"579bff\",\"textColor1\":\"190800\",\"textColor2\":\"161616\",\"textColor3\":\"252633\",\"textColor4\":\"233145\"},{\"width\":1242,\"height\":2208,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource221/v4/cb/72/9c/cb729c26-1333-3d84-fbb8-3c748faf9735/64a42e1e-82a1-4bee-b301-62186efc53b0_1_APP_IPHONE_55_1.jpg/{w}x{h}{c}.{f}\",\"bgColor\":\"569afd\",\"textColor1\":\"000000\",\"textColor2\":\"1c1c1c\",\"textColor3\":\"111e32\",\"textColor4\":\"283549\"},{\"width\":1242,\"height\":2208,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource221/v4/28/c5/f1/28c5f14c-d014-e611-d11c-074af960cfdc/97cb705f-0222-4ebb-acc7-0e5b0d4384c9_2_APP_IPHONE_55_2.jpg/{w}x{h}{c}.{f}\",\"bgColor\":\"5495e9\",\"textColor1\":\"000000\",\"textColor2\":\"15181c\",\"textColor3\":\"101d2e\",\"textColor4\":\"213145\"},{\"width\":1242,\"height\":2208,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource221/v4/55/3e/b0/553eb0a2-32cd-fd31-c3df-aa87f1d9debd/ba4d8277-cc80-4473-8f55-76cc56320ed3_3_APP_IPHONE_55_3.jpg/{w}x{h}{c}.{f}\",\"bgColor\":\"5899ff\",\"textColor1\":\"000000\",\"textColor2\":\"14181f\",\"textColor3\":\"111e33\",\"textColor4\":\"21324b\"},{\"width\":1242,\"height\":2208,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource211/v4/db/2f/7d/db2f7d09-2416-760c-1cfe-dec29a87e157/4ffa9d4c-4537-4a5c-982e-6980a2fdece8_4_APP_IPHONE_55_4.jpg/{w}x{h}{c}.{f}\",\"bgColor\":\"5597f8\",\"textColor1\":\"000000\",\"textColor2\":\"0b1e3a\",\"textColor3\":\"111e31\",\"textColor4\":\"1a3660\"},{\"width\":1242,\"height\":2208,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource211/v4/b1/75/3a/b1753a57-c7b1-ff61-c976-6685304651bc/fc99cea9-cb56-4ca3-91f2-f80f2545a5fc_5_APP_IPHONE_55_5.jpg/{w}x{h}{c}.{f}\",\"bgColor