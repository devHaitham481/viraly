        <div
    x-data="{
        qr: null,
        opener: null,
        show(key, button) {
            this.opener = button;
            this.qr = key;
            this.$nextTick(() => this.$refs.close.focus());
        },
        hide() {
            this.qr = null;
            this.opener?.focus();
        },
        keepFocus(event) {
            if (event.key === 'Tab') {
                event.preventDefault();
                this.$refs.close.focus();
            }
        },
    }"
    class="flex flex-wrap justify-center gap-2.5 relative mt-1.5"
>
