}\",\"width\":1242},{\"bgColor\":\"d6d6d6\",\"height\":2208,\"textColor1\":\"070707\",\"textColor2\":\"201824\",\"textColor3\":\"303030\",\"textColor4\":\"453e47\",\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource116/v4/ac/46/73/ac46739c-7d96-2262-3c4f-f4f71ad9aa38/9e989eef-adae-4fc6-8a01-fb6fb1ef2c46_Apple_iPhone_8_Plus_Screenshot_5.png/{w}x{h}{c}.{f}\",\"width\":1242}],\"iphone_6_5\":[{\"bgColor\":\"f8f8f8\",\"height\":2688,\"textColor1\":\"090626\",\"textColor2\":\"191d24\",\"textColor3\":\"393650\",\"textColor4\":\"45494e\",\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource116/v4/7a/13/35/7a133586-b536-0678-1e59-b7d968b732ed/f92f0d45-ddcb-40b1-a7f9-f1294452388c_Apple_iPhone_11_Pro_Max_Screenshot_0.png/{w}x{h}{c}.{f}\",\"width\":1242},{\"bgColor\":\"191919\",\"height\":2688,\"textColor1\":\"fbfbfb\",\"textColor2\":\"dddddd\",\"textColor3\":\"cecece\",\"textColor4\":\"b5b5b5\",\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource116/v4/ca/09/64/ca096422-a8a4-4c5c-13ce-876d7d2e66db/883eadeb-6902-4d6f-89f0-ae8beaf8ec34_Apple_iPhone_11_Pro_Max_Screenshot_1.png/{w}x{h}{c}.{f}\",\"width\":1242},{\"bgColor\":\"f8f8f8\",\"height\":2688,\"textColor1\":\"090626\",\"textColor2\":\"24272d\",\"textColor3\":\"393650\",\"textColor4\":\"4f5155\",\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource116/v4/0b/32/08/0b3208c8-7b8a-32d1-e778-d9139b5e9ada/300b21da-2720-4592-ba8e-250566a3cdf2_Apple_iPhone_11_Pro_Max_Screenshot_2.png/{w}x{h}{c}.{f}\",\"width\":1242},{\"bgColor\":\"f8f8f8\",\"height\":2688,\"textColor1\":\"0d0d0d\",\"textColor2\":\"26282d\",\"textColor3\":\"3c3c3c\",\"textColor4\":\"505255\",\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource126/v4/c4/a8/67/c4a867e8-959d-9d1b-3d6c-540e3cf6fd15/72351e7e-5321-4c9f-9917-293335d2654d_Apple_iPhone_11_Pro_Max_Screenshot_3.png/{w}x{h}{c}.{f}\",\"width\":1242},{\"bgColor\":\"f8f8f8\",\"height\":2688,\"textColor1\":\"090626\",\"textColor2\":\"2d1d2c\",\"textColor3\":\"393650\",\"textColor4\":\"554955\",\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource126/v4/9a/70/13/9a7013e9-8332-1f76-45f5-163e000f5743/4db55f86-2243-4f2e-b36a-bac1c6316259_Apple_iPhone_11_Pro_Max_Screenshot_4.png/{w}x{h}{c}.{f}\",\"width\":1242},{\"bgColor\":\"f8f8f8\",\"height\":2688,\"textColor1\":\"0d0d0d\",\"textColor2\":\"232016\",\"textColor3\":\"3c3c3c\",\"textColor4\":\"4e4b43\",\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource116/v4/ea/ca/49/eaca495e-b2c9-5725-0dbb-ed84761ab3de/0f787c47-7886-4d92-893a-0f045462617e_Apple_iPhone_11_Pro_Max_Screenshot_5.png/{w}x{h}{c}.{f}\",\"width\":1242}]},\"customVideoPreviewsByType\":{}}}},\"description\":{\"standard\":\"HabitKit is the perfect app for anyone looking to form new habits or break old ones. With HabitKit, you can track your progress with beautiful tile-based grid charts. Whether you're trying to quit smoking, eat healthier, or exercise more, HabitKit can help you achieve your goals. You can customize your dashboard by adjusting colors, icons and descriptions. Draw motivation from growing the amount of colored tiles on your habit dashboard.\\n\\n---\\n\\nCREATE HABITS\\nAdd your habits you want to track in a fast and easy way. Provide a name, description, icon and color and you're good to go.\\n\\nDASHBOARD\\nAll your habits are displayed on your dashboard represented by a cool looking grid chart. Every filled out square show a day where you kept up with your habit.\\n\\nCALENDAR\\nThe calendar provides a fast and easy way to manage past completions. Simply tap a day to remove or add a completion.\\n\\nARCHIVE\\nDo you need a break from a habit and don't want to clutter your dashboard with it? Just archive it and restore it at a later point from the menu.\\n\\nIMPORT AND EXPORT\\nSwitching phones and don't want to lose your data? Export your data to a file, save it wherever you want and restore it at a later point of time.\\n\\nPRIVACY FOCUSED\\nAll your data belongs to you and stays on your phone. No sign-in. No servers. No cloud.\\n\\n---\\n\\nTerms of Use: https://www.habitkit.app/tos/\\nPrivacy Policy: https://www.habitkit.app/privacy/\"},\"editorialArtwork\":{\"brandLogo\":{\"bgColor\":\"000000\",\"height\":1080,\"textColor1\":\"f2f2f2\",\"textColor2\":\"e5e5e5\",\"textColor3\":\"c1c1c1\",\"textColor4\":\"b7b7b7\",\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Features116/v4/1c/2b/7c/1c2b7cc6-e029-9bf9-f26f-4b5f533ee2fc/af8e3a5e-dba7-4ad7-9b94-9340366eab93.png/{w}x{h}{c}.{f}\",\"width\":1080},\"contentIconTrimmed\":{\"bgColor\":\"0092ff\",\"height\":1080,\"textColor1\":\"00070c\",\"textColor2\":\"000e19\",\"textColor3\":\"00233d\",\"textColor4\":\"002947\",\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Features126/v4/09/15/89/091589bc-f33b-2d71-9e77-2ef3729cd955/abc2adb6-5a59-47b0-b8f5-84523bdd6bd8.png/{w}x{h}{c}.{f}\",\"width\":1048},\"contentIconTrimmedMonochrome\":{\"bgColor\":\"000000\",\"height\":1080,\"textColor1\":\"f2f2f2\",\"textColor2\":\"e5e5e5\",\"textColor3\":\"c1c1c1\",\"textColor4\":\"b7b7b7\",\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Features116/v4/6e/e2/e7/6ee2e7db-bf98-0d30-7adf-15aa80debeb5/721e011e-109f-4227-8978-1f8c6071c48f.png/{w}x{h}{c}.{f}\",\"width\":1048}},\"externalVersionId\":877744849,\"hasFamilyShareableInAppPurchases\":false,\"hasInAppPurchases\":true,\"hasMessagesExtension\":false,\"hasPrivacyPolicyText\":false,\"hasSafariExtension\":false,\"is32bitOnly\":false,\"isAppleWatchSupported\":false,\"isDeliveredInIOSAppForWatchOS\":false,\"isGameCenterEnabled\":false,\"isHiddenFromSpringboard\":false,\"isSiriSupported\":false,\"isStandaloneForWatchOS\":false,\"isStandaloneWithCompanionForWatchOS\":false,\"isXROSCompatible\":true,\"languageList\":[\"English\"],\"messagesScreenshots\":{},\"minimumMacOSVersion\":\"11.0\",\"minimumOSVersion\":\"14.0\",\"minimumXROSVersion\":\"1.0\",\"offers\":[{\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":196356096}],\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=6443918070\u0026pricingParameters=STDQ\u0026pg=default\u0026appExtVrsId=877744849\",\"currencyCode\":\"USD\",\"price\":0,\"priceFormatted\":\"$0.00\",\"priceString\":\"0.00\",\"type\":\"get\"},{\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":196356096}],\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=6443918070\u0026pricingParameters=SWUPD\u0026pg=default\u0026appExtVrsId=877744849\",\"currencyCode\":\"USD\",\"price\":0,\"priceFormatted\":\"$0.00\",\"priceString\":\"0.00\",\"type\":\"update\"}],\"privacyPolicyUrl\":\"https://www.habitkit.app/privacy\",\"releaseDate\":\"2022-11-26\",\"requiredCapabilities\":\"arm64 \",\"requiredCapabilitiesForRealityDevice\":\"arm64 \",\"requirementsString\":\"Requires iOS 14.0 or later. Compatible with iPhone, iPad, and iPod touch.\",\"requires32bit\":false,\"requiresGameController\":false,\"seller\":\"Sebastian Roehl\",\"subtitle\":\"Streaks \u0026 Accountability\",\"supportURLForLanguage\":\"https://www.habitkit.app/contact/\",\"supportedLocales\":[{\"name\":\"English\",\"tag\":\"en-US\"}],\"supportsGameController\":false,\"supportsPassbook\":false,\"versionHistory\":[{\"releaseDate\":\"2025-10-02\",\"releaseNotes\":\"Important bugfixes for the reminder system of the app.\",\"releaseTimestamp\":\"2025-10-02T08:11:11Z\",\"versionDisplay\":\"1.14.2\"},{\"releaseDate\":\"2025-09-01\",\"releaseNotes\":\"• New Icons Added: Meditation, crafts, sports, fashion, music \u0026 tech icons\\n• Bug fixes and performance improvements\",\"releaseTimestamp\":\"2025-09-01T09:49:58Z\",\"versionDisplay\":\"1.14.1\"},{\"releaseDate\":\"2025-08-18\",\"releaseNotes\":\"Enhanced Reminder System - Set up to 3 reminders per habit with our completely redesigned notification system\\nDaily Check-In Reminders - Get daily notifications to review and complete your habits\\nPerformance Improvements - Smoother experience with enhanced reliability\",\"releaseTimestamp\":\"2025-08-18T07:52:01Z\",\"versionDisplay\":\"1.14.0\"},{\"releaseDate\":\"2025-08-05\",\"releaseNotes\":\"Important bug fixes and performance optimizations.\",\"releaseTimestamp\":\"2025-08-05T09:59:36Z\",\"versionDisplay\":\"1.13.4\"},{\"releaseDate\":\"2025-07-09\",\"releaseNotes\":\"Bug fixes and small improvements.\",\"releaseTimestamp\":\"2025-07-09T13:18:54Z\",\"versionDisplay\":\"1.13.3\"},{\"releaseDate\":\"2025-06-26\",\"releaseNotes\":\"Bug fixes and small improvements.\",\"releaseTimestamp\":\"2025-06-26T08:11:41Z\",\"versionDisplay\":\"1.13.2\"},{\"releaseDate\":\"2025-06-18\",\"releaseNotes\":\"Bug fixes and small improvements.\",\"releaseTimestamp\":\"2025-06-18T07:37:22Z\",\"versionDisplay\":\"1.13.1\"},{\"releaseDate\":\"2025-06-16\",\"releaseNotes\":\"New Habit Detail View \u0026 Improvements:\\n• Fresh Habit Details - Redesigned habit detail view with integrated calendar for better progress tracking\\n• Compact List Enhancements - Customize day count display and toggle habit names for a cleaner interface\\n• Performance Boost - Fixed numerous bugs and improved app performance for a smoother experience\",\"releaseTimestamp\":\"2025-06-16T08:00:31Z\",\"versionDisplay\":\"1.13.0\"},{\"releaseDate\":\"2025-05-05\",\"releaseNotes\":\"This release includes important bug fixes and performance optimizations. \",\"releaseTimestamp\":\"2025-05-05T08:29:10Z\",\"versionDisplay\":\"1.12.1\"},{\"releaseDate\":\"2025-04-29\",\"releaseNotes\":\"Emoji Support: Make your habits more personal and meaningful with our new emoji support.\\n• Personalized Expression: Choose from a wide variety of emojis to represent your habits in a way that resonates with you.\\n• Smart Icon/Emoji Search: Find the perfect emoji or icon quickly with our intuitive search feature - type what you feel, find what you need.\",\"releaseTimestamp\":\"2025-04-29T08:19:26Z\",\"versionDisplay\":\"1.12.0\"},{\"releaseDate\":\"2025-04-16\",\"releaseNotes\":\"This version includes the following changes:\\n• Configure the start of the week, whether it's Sunday, Monday or Wednesday. HabitKit is as flexible as possible.\\n• Added a \\\"Manage Subscription\\\" button to the subscribers view.\\n• Added a link in the settings menu to my other app, Liftbear.\\n• Bugfixes and performance optimizations.\",\"releaseTimestamp\":\"2025-04-16T08:32:07Z\",\"versionDisplay\":\"1.11.1\"},{\"releaseDate\":\"2025-04-02\",\"releaseNotes\":\"Track Without Limits: Your habits are now more flexible than ever with unlimited tracking capabilities.\\n• Personalized Tracking: Track your progress your way - whether it's pages read, minutes meditated, or any other metric that matters to you.\\n• Go Beyond Goals: Push past your daily targets and celebrate every achievement, no matter how big.\\n• Enhanced Input Experience: A sleek new dialog makes tracking your progress more intuitive than ever.\",\"releaseTimestamp\":\"2025-04-02T07:07:29Z\",\"versionDisplay\":\"1.11.0\"},{\"releaseDate\":\"2025-02-18\",\"releaseNotes\":\"This release includes bug fixes and important performance optimizations.\",\"releaseTimestamp\":\"2025-02-18T07:02:01Z\",\"versionDisplay\":\"1.10.3\"},{\"releaseDate\":\"2025-01-08\",\"releaseNotes\":\"This release includes the following changes:\\n• Remove the \\\"Year In Review\\\" feature from the dashboard\\n• Changing the category icon doesn't apply to the overview\\n• Make categories reorderable\\n• Fix the missing translation for \\\"Create your own\\\"\\n• Make categories deletable (from the overview)\",\"releaseTimestamp\":\"2025-01-08T09:42:45Z\",\"versionDisplay\":\"1.10.2\"},{\"releaseDate\":\"2024-12-27\",\"releaseNotes\":\"This release brings back the \\\"Year In Review\\\" page for everyone.\",\"releaseTimestamp\":\"2024-12-27T13:14:17Z\",\"versionDisplay\":\"1.10.1\"},{\"releaseDate\":\"2024-11-26\",\"releaseNotes\":\"Dashboard Customization: We've added a lot of new customization options to your dashboard.\\n• FEATURE: Display Streaks: You can now display the streak and goals on your habits cards.\\n• FEATURE: Display Labels: You can now display the month and weekday labels on your habits cards.\\n• FEATURE: Display Categories: You can now display the category icons on your habits cards.\\n• FIX: The category filter only allows one selected entry now.\",\"releaseTimestamp\":\"2024-11-26T09:21:47Z\",\"versionDisplay\":\"1.10.0\"},{\"releaseDate\":\"2024-11-01\",\"releaseNotes\":\"This update includes important bug fixes and performance improvements.\",\"releaseTimestamp\":\"2024-11-01T12:58:46Z\",\"versionDisplay\":\"1.9.5\"},{\"releaseDate\":\"2024-10-29\",\"releaseNotes\":\"This update adds support for iOS-18 tinted app icons and introduces new habit icons.\",\"releaseTimestamp\":\"2024-10-29T10:06:32Z\",\"versionDisplay\":\"1.9.4\"},{\"releaseDate\":\"2024-10-22\",\"releaseNotes\":\"This update includes important bugfixes and performance optimizations.\",\"releaseTimestamp\":\"2024-10-22T08:28:53Z\",\"versionDisplay\":\"1.9.3\"},{\"releaseDate\":\"2024-10-01\",\"releaseNotes\":\"This update includes important bugfixes and performance optimizations.\",\"releaseTimestamp\":\"2024-10-01T08:19:08Z\",\"versionDisplay\":\"1.9.2\"},{\"releaseDate\":\"2024-09-17\",\"releaseNotes\":\"This update fixes an issue about the app being stuck on the splash screen.\",\"releaseTimestamp\":\"2024-09-17T04:38:59Z\",\"versionDisplay\":\"1.9.1\"},{\"releaseDate\":\"2024-09-16\",\"releaseNotes\":\"Introducing Categories: Elevate your habit organization with our new category feature. Group related habits together and customize your dashboard for a more focused experience.\",\"releaseTimestamp\":\"2024-09-16T06:05:32Z\",\"versionDisplay\":\"1.9.0\"},{\"releaseDate\":\"2024-08-16\",\"releaseNotes\":\"This release fixes a bug which caused the Month view to ignore the \\\"Week starts on Sunday\\\" option.\",\"releaseTimestamp\":\"2024-08-16T07:57:42Z\",\"versionDisplay\":\"1.8.4\"},{\"releaseDate\":\"2024-08-09\",\"releaseNotes\":\"This release includes important bugfixes and performance improvements.\",\"releaseTimestamp\":\"2024-08-09T08:34:26Z\",\"versionDisplay\":\"1.8.3\"},{\"releaseDate\":\"2024-07-30\",\"releaseNotes\":\"This release includes important bugfixes and performance improvements.\",\"releaseTimestamp\":\"2024-07-30T06:29:08Z\",\"versionDisplay\":\"1.8.2\"}],\"videoPreviewsByType\":{},\"websiteUrl\":\"https://www.habitkit.app\"}},\"privacy\":{\"privacyTypes\":[{\"dataCategories\":[{\"dataCategory\":\"Purchases\",\"identifier\":\"PURCHASES\"}],\"description\":\"The following data may be collected and linked to your identity:\",\"identifier\":\"DATA_LINKED_TO_YOU\",\"privacyType\":\"Data Linked to You\"},{\"dataCategories\":[{\"dataCategory\":\"Diagnostics\",\"identifier\":\"DIAGNOSTICS\"}],\"description\":\"The following data may be collected but it is not linked to your identity:\",\"identifier\":\"DATA_NOT_LINKED_TO_YOU\",\"privacyType\":\"Data Not Linked to You\"}]},\"requirementsByDeviceFamily\":{\"iphone\":{\"deviceFamily\":\"iPhone\",\"requirementString\":\"Requires iOS 14.0 or later.\"},\"ipod\":{\"deviceFamily\":\"iPod touch\",\"requirementString\":\"Requires iOS 14.0 or later.\"},\"mac\":{\"deviceFamily\":\"Mac\",\"requirementString\":\"Requires macOS 11.0 or later and a Mac with Apple M1 chip or later.\"},\"realityDevice\":{\"deviceFamily\":\"Apple Vision\",\"requirementString\":\"Requires visionOS 1.0 or later.\"}},\"reviewsRestricted\":false,\"sellerLabel\":\"Seller\",\"supportsArcade\":false,\"supportsStreamlinedBuy\":true,\"url\":\"https://apps.apple.com/us/app/habit-tracker-habitkit/id6443918070\",\"userRating\":{\"ariaLabelForRatings\":\"4.9 stars\",\"ratingCount\":1359,\"ratingCountList\":[19,3,25,65,1247],\"value\":4.9},\"usesLocationBackgroundMode\":false},\"relationships\":{\"app-events\":{\"href\":\"/v1/catalog/us/apps/6443918070/app-events?l=en-US\",\"data\":[]},\"customers-also-bought-apps\":{\"href\":\"/v1/catalog/us/apps/6443918070/customers-also-bought-apps?l=en-US\",\"next\":\"/v1/catalog/us/apps/6443918070/customers-a