e\":\"update\"}],\"privacyPolicyUrl\":\"https://www.iubenda.com/privacy-policy/22673733\",\"releaseDate\":\"2024-02-14\",\"requiredCapabilitiesForRealityDevice\":\"arm64 \",\"requires32bit\":false,\"requiresGameController\":false,\"subtitle\":\"The official Atomic Habits app\",\"supportURLForLanguage\":\"https://getatoms.notion.site/Atoms-Support-969074c91f464f9d91fc56bfbdf0f19e\",\"versionHistory\":[{\"releaseDate\":\"2025-10-01\",\"releaseNotes\":\"** Habit Stacking now available! **\\nCreate a habit stack from your existing habits to build natural momentum\\n\\n* Bug fixes and other enhancements\",\"releaseTimestamp\":\"2025-10-01T15:23:16Z\",\"versionDisplay\":\"3.3.0\"},{\"releaseDate\":\"2025-08-25\",\"releaseNotes\":\"** Perfect Days Metrics **\\nFor habits with daily goals, track your perfect day metrics in Habit Details.\\n\\n** App Version Details **\\nCurrent app version information and update alerts are available on the Profile page.\",\"releaseTimestamp\":\"2025-08-25T07:43:25Z\",\"versionDisplay\":\"3.2.0\"},{\"releaseDate\":\"2025-07-31\",\"releaseNotes\":\"- Perfect Days in Habit Details: View the days you achieved your daily goals for a habit using the habit details calendar.\\n- Improvements to habits and widgets for habits with daily goals.\",\"releaseTimestamp\":\"2025-07-31T13:04:26Z\",\"versionDisplay\":\"3.1.0\"},{\"releaseDate\":\"2025-06-25\",\"releaseNotes\":\"**Now you can track habits with Daily Goals!**\\n\\n\\n- Want to monitor a habit you do multiple times a day? Or a habit with targets for the day? You can now track these habits with the latest version!\\n- Set habit goals when creating a new habit or by editing an existing one.  You won't lose progress on current habits; goal tracking begins the next day. \\n- Your habits are auto-logged when you meet the day's goal! However, you can also log your habits manually before reaching the day's goal by pressing and holding the habit as you have been doing. \",\"releaseTimestamp\":\"2025-06-25T13:11:45Z\",\"versionDisplay\":\"3.0.0\"},{\"releaseDate\":\"2025-06-04\",\"releaseNotes\":\"Critical updates and enhancements\",\"releaseTimestamp\":\"2025-06-04T07:48:40Z\",\"versionDisplay\":\"2.7.7\"},{\"releaseDate\":\"2025-05-21\",\"releaseNotes\":\"Critical updates and enhancements\",\"releaseTimestamp\":\"2025-05-21T12:21:25Z\",\"versionDisplay\":\"2.7.6\"},{\"releaseDate\":\"2025-05-19\",\"releaseNotes\":\"Critical updates and enhancements\",\"releaseTimestamp\":\"2025-05-19T08:46:33Z\",\"versionDisplay\":\"2.7.5\"},{\"releaseDate\":\"2025-04-24\",\"releaseNotes\":\"Critical updates and enhancements\",\"releaseTimestamp\":\"2025-04-24T16:13:04Z\",\"versionDisplay\":\"2.7.4\"},{\"releaseDate\":\"2025-04-21\",\"releaseNotes\":\"Critical updates and enhancements\",\"releaseTimestamp\":\"2025-04-21T06:43:02Z\",\"versionDisplay\":\"2.7.3\"},{\"releaseDate\":\"2025-04-04\",\"releaseNotes\":\"Critical updates and enhancements\",\"releaseTimestamp\":\"2025-04-04T02:28:51Z\",\"versionDisplay\":\"2.7.2\"},{\"releaseDate\":\"2025-04-02\",\"releaseNotes\":\"Critical updates and enhancements\",\"releaseTimestamp\":\"2025-04-02T08:42:13Z\",\"versionDisplay\":\"2.7.1\"},{\"releaseDate\":\"2025-03-28\",\"releaseNotes\":\"* Critical updates and enhancements\",\"releaseTimestamp\":\"2025-03-28T15:15:56Z\",\"versionDisplay\":\"2.7.0\"},{\"releaseDate\":\"2025-02-26\",\"releaseNotes\":\"* Spotify in Focus Mode! *\\nSelect and play your choice of audio from your Spotify account during Focus mode\\n\\n* Other bug fixes and improvements *\",\"releaseTimestamp\":\"2025-02-26T13:55:29Z\",\"versionDisplay\":\"2.6.1\"},{\"releaseDate\":\"2025-02-19\",\"releaseNotes\":\"* Spotify in Focus Mode! *\\nSelect and play your choice of audio from your Spotify account during Focus mode\\n\\n* Other bug fixes and improvements *\",\"releaseTimestamp\":\"2025-02-19T13:03:07Z\",\"versionDisplay\":\"2.6.0\"},{\"releaseDate\":\"2025-02-18\",\"releaseNotes\":\"** Log any day in the past! **\\n\\