lor2\":\"dfe2e8\",\"textColor3\":\"cbcdd4\",\"textColor4\":\"b2b7c2\",\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Purple211/v4/91/4e/42/914e42cc-7ac7-dd8a-882f-ab3a94c1c8d1/4cd2ce05-05c7-480d-8cd8-41fcbed84446_Screenshot_10_1290x2796.png/{w}x{h}{c}.{f}\",\"width\":1179}],\"iphone_d74\":[{\"bgColor\":\"ffffff\",\"height\":2796,\"textColor1\":\"010101\",\"textColor2\":\"14181f\",\"textColor3\":\"343434\",\"textColor4\":\"43464c\",\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Purple211/v4/94/b5/3f/94b53fc3-1c29-556b-2bf3-834824fa6d4e/a1523125-8113-4a02-85ca-79ead9126f23_Screenshot_1_1290x2796.png/{w}x{h}{c}.{f}\",\"width\":1290},{\"bgColor\":\"ffffff\",\"height\":2796,\"textColor1\":\"111111\",\"textColor2\":\"14181f\",\"textColor3\":\"414141\",\"textColor4\":\"43464c\",\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Purple221/v4/78/2c/84/782c845f-1496-ed14-aa65-b18f909b0768/89050e86-dbd0-419d-b307-9c53bc2906a5_Screenshot_2_1290x2796.png/{w}x{h}{c}.{f}\",\"width\":1290},{\"bgColor\":\"2e3847\",\"height\":2796,\"textColor1\":\"ffffff\",\"textColor2\":\"ced1cf\",\"textColor3\":\"d5d7da\",\"textColor4\":\"aeb2b4\",\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Purple211/v4/76/be/41/76be41b3-862a-2ee9-26c7-eb19c0057bee/713b47ee-971d-411d-a0b0-1b8c34107fd1_Screenshot_3_1290x2796-original.png/{w}x{h}{c}.{f}\",\"width\":1290},{\"bgColor\":\"ffffff\",\"height\":2796,\"textColor1\":\"14181f\",\"textColor2\":\"131b24\",\"textColor3\":\"43464c\",\"textColor4\":\"42484f\",\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Purple221/v4/86/d3/a5/86d3a5fd-a90c-c063-627a-aa0622760398/d6abe639-c37f-46d0-a59f-61e8b32d1e76_Screenshot_4_1290x2796.png/{w}x{h}{c}.{f}\",\"width\":1290},{\"bgColor\":\"ffffff\",\"height\":2796,\"textColor1\":\"010101\",\"textColor2\":\"14181f\",\"textColor3\":\"343434\",\"textColor4\":\"43464c\",\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Purple221/v4/f0/3d/b0/f03db006-ecf5-0b08-f0d3-3a4dcf09854e/73cf6743-c39f-4d68-bb3b-05304b0d2ca8_Screenshot_5_1290x2796.png/{w}x{h}{c}.{f}\",\"width\":1290},{\"bgColor\":\"ffffff\",\"height\":2796,\"textColor1\":\"14181f\",\"textColor2\":\"131b24\",\"textColor3\":\"43464c\",\"textColor4\":\"42484f\",\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Purple221/v4/8f/f3/15/8ff315c5-caa4-f973-6b93-1ce274cc8201/53479866-2e35-4fbe-bc26-9957154b0c5b_Screenshot_6_1290x2796.png/{w}x{h}{c}.{f}\",\"width\":1290},{\"bgColor\":\"2c2c2e\",\"height\":2796,\"textColor1\":\"ffffff\",\"textColor2\":\"00dde5\",\"textColor3\":\"d4d4d5\",\"textColor4\":\"08bac1\",\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Purple211/v4/57/fd/a4/57fda4b4-d07b-d594-88a2-c6484fd115ae/933e310b-6553-491b-a6a4-9f20888caad6_Screenshot_7_1290x2796.png/{w}x{h}{c}.{f}\",\"width\":1290},{\"bgColor\":\"ffffff\",\"height\":2796,\"textColor1\":\"14181f\",\"textColor2\":\"131a23\",\"textColor3\":\"43464c\",\"textColor4\":\"42474f\",\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Purple221/v4/62/38/1e/62381edf-db0d-5842-332a-9c9a0c73485d/434a90ef-660f-4742-b7d1-ba11db356a85_Screenshot_8_1290x2796.png/{w}x{h}{c}.{f}\",\"width\":1290},{\"bgColor\":\"ffffff\",\"height\":2796,\"textColor1\":\"010101\",\"textColor2\":\"14181f\",\"textColor3\":\"343434\",\"textColor4\":\"43464c\",\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Purple211/v4/08/80/c5/0880c5ae-cc6a-eddc-916c-7fb9ec583ce5/428149ab-cdc2-4744-8df9-a42a06700ab4_Screenshot_9_1290x2796.png/{w}x{h}{c}.{f}\",\"width\":1290},{\"bgColor\":\"fafafa\",\"height\":2796,\"textColor1\":\"14181f\",\"textColor2\":\"131a23\",\"textColor3\":\"42454b\",\"textColor4\":\"41464e\",\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Purple211/v4/a5/02/6d/a5026df5-34cf-57e8-4afc-0fba1ed84715/1b22dfae-6d2e-4102-95a8-7ba896b721ff_Screenshot_10_1290x2796.png/{w}x{h}{c}.{f}\",\"width\":1290}]},\"customVideoPreviewsByType\":{}}}},\"description\":{\"standard\":\"Timelines is easy-to-use, flexible yet powerful time tracking app. Record what you're doing and get insights into your time with interactive timeline and charts. Understand trends, stay motivated to reach your time-based goals, and make the most out of your time!\\n\\nI personally wasn't happy with the way I was spending my time, so I decided to build a tool to help myself and others figure out a way to become more efficient. Timelines has been enabling me and other users to understand where our time is actually going, helping us improve our routines and achieve more in our lives. I sincerely believe it can do the same for you.\\n– Lukas Petr, independent developer of Timelines\\n\\nTimelines has been featured by Apple, and reviewed on 9To5Mac, MacStories, WatchAware, AppAdvice, and more.\\n\\n▶ QUICK DATA ENTRY\\n- track any category you want\\n- control timers with just 1 tap\\n- grid mode of timers\\n- track from lock screen with the today widget\\n- easily edit past events\\n\\n▶ POWERFUL VISUALIZATIONS\\n- see your time on an interactive timeline\\n- playful statistics mode with pie chart\\n- trends over time using bar chart\\n- subcategories - breakdown of your events\\n- quickly filter categories\\n\\n▶ SYNC BETWEEN DEVICES\\n- have an always up-to-date backup of your data with Timelines Cloud\\n- sync between your iPhone, iPad, and Apple Watch, in real-time\\n- sign in using your email address or your Apple ID\\n\\n▶ GOALS\\n- define daily, weekly, and monthly goals\\n- see your progress and stay on track\\n- periodic reports with rich notifications\\n- get rewarded for reaching a goal with confetti\\n\\n▶ AUTOMATIONS\\n- build workflows with Siri Shortcuts\\n- use Siri to start and stop timers\\n- import workouts, sleep, and meditation from Apple Health\\n\\n▶ AND MORE\\n- detailed PDF and CSV exports\\n- timely and customizable reminders\\n- archive unused categories\\n- lots of possible customizations\\n\\n▶ APPLE WATCH APP\\n- watch face complication for quick access\\n- haptic feedback on start and stop of timers\\n- set event names using dictation or choose from recent\\n- adjust start and end times using the digital crown\\n- see active timer’s duration and category on watch face\\n- real-time sync with iPhone and iPad using Timelines Cloud\\n- see list of past past entries and edit them easily\\n- daily, weekly, monthly, or yearly statistics\\n\\n▶ WHAT IS FREE?\\n- track up to 3 categories\\n- basic exporting\\n- pie chart\\n- see events on a timeline\\n- events log\\n- reminders\\n\\n▶ TIMELINES PRO\\n- sync between devices\\n- unlimited categories\\n- bar chart\\n- goals\\n- detailed exports\\n- import from Apple Health\\n- subcategories\\n- support development\\n\\nStart taking control of your time today. It only takes a few days of tracking to start uncovering ways to maximize your time and productivity.\\n\\nI love working on Timelines, and a big part of my vision is to listen closely to users and incorporate their feedback. If you have any questions or suggestions, please reach out to me at\\nlukas@timelines.app.\\n– Lukas Petr, author of Timelines\\n\\n* Privacy policy: https://timelines.app/privacy/\\n* Terms of Use: https://timelines.app/terms/\"},\"editorialArtwork\":{\"brandLogo\":{\"bgColor\":\"000000\",\"height\":1080,\"textColor1\":\"f2f2f2\",\"textColor2\":\"e5e5e5\",\"textColor3\":\"c1c1c1\",\"textColor4\":\"b7b7b7\",\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Features116/v4/1c/2b/7c/1c2b7cc6-e029-9bf9-f26f-4b5f533ee2fc/af8e3a5e-dba7-4ad7-9b94-9340366eab93.png/{w}x{h}{c}.{f}\",\"width\":1080},\"contentIconTrimmed\":{\"bgColor\":\"0092ff\",\"height\":1080,\"textColor1\":\"00070c\",\"textColor2\":\"000e19\",\"textColor3\":\"00233d\",\"textColor4\":\"002947\",\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Features126/v4/09/15/89/091589bc-f33b-2d71-9e77-2ef3729cd955/abc2adb6-5a59-47b0-b8f5-84523bdd6bd8.png/{w}x{h}{c}.{f}\",\"width\":1048},\"contentIconTrimmedMonochrome\":{\"bgColor\":\"000000\",\"height\":1080,\"textColor1\":\"f2f2f2\",\"textColor2\":\"e5e5e5\",\"textColor3\":\"c1c1c1\",\"textColor4\":\"b7b7b7\",\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Features116/v4/6e/e2/e7/6ee2e7db-bf98-0d30-7adf-15aa80debeb5/721e011e-109f-4227-8978-1f8c6071c48f.png/{w}x{h}{c}.{f}\",\"width\":1048},\"storeFlowcase\":{\"bgColor\":\"f0f8fe\",\"height\":1080,\"textColor1\":\"0a0b0b\",\"textColor2\":\"0c0d0d\",\"textColor3\":\"383a3c\",\"textColor4\":\"3a3c3d\",\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Features71/v4/16/a4/66/16a4668c-c24b-bf70-9a71-1c342d175bcb/mza_1282539062703453961.png/{w}x{h}{c}.{f}\",\"width\":4320}},\"editorialNotes\":{\"standard\":\"Time is like money: we never have enough, and we often can’t remember how we spent it. Timelines is razor-sharp instrument in our time-management toolkit, letting us categorize and visualize where the hours in our hectic days are going. We love it for everything from tracking billable time on projects to making sure we’re setting aside chunks of our week to relax with loved ones.\"},\"hasInAppPurchases\":true,\"hasMessagesExtension\":false,\"hasSafariExtension\":false,\"isAppleWatchSupported\":true,\"isDeliveredInIOSAppForWatchOS\":true,\"isHiddenFromSpringboard\":false,\"isStandaloneForWatchOS\":false,\"isStandaloneWithCompanionForWatchOS\":true,\"isXROSCompatible\":false,\"messagesScreenshots\":{},\"minimumMacOSVersion\":\"12.0\",\"offers\":[{\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":67443712}],\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=1112433234\u0026pricingParameters=STDQ\u0026pg=default\u0026appExtVrsId=878265719\",\"currencyCode\":\"USD\",\"price\":0,\"priceFormatted\":\"$0.00\",\"priceString\":\"0.00\",\"type\":\"get\"},{\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":67443712}],\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=1112433234\u0026pricingParameters=SWUPD\u0026pg=default\u0026appExtVrsId=878265719\",\"currencyCode\":\"USD\",\"price\":0,\"priceFormatted\":\"$0.00\",\"priceString\":\"0.00\",\"type\":\"update\"}],\"privacyPolicyUrl\":\"https://timelines.app/privacy/\",\"releaseDate\":\"2016-08-12\",\"requires32bit\":false,\"requiresGameController\":false,\"subtitle\":\"Personal \u0026 Work Hours Tracker\",\"supportURLForLanguage\":\"https://timelines.app\",\"versionHistory\":[{\"releaseDate\":\"2025-09-19\",\"releaseNotes\":\"• Enabled native widgets when running on macOS.\\n• Fixed an occassional delay when starting or stopping timers on macOS.\\n• Improved appearance of the event name prompt.\\n• Improved performance when importing large numbers of Health sleep events.\\n• Fixed an issue where event markers on the timeline could appear stacked even when not overlapping.\",\"releaseTimestamp\":\"2025-09-19T20:30:41Z\",\"versionDisplay\":\"4.1.1\"},{\"releaseDate\":\"2025-09-15\",\"releaseNotes\":\"Liquid Glass Support\\n• Timelines now fully supports the redesigned look of iOS 26.\\n• Most elements stay where you expect, but now match the new system style.\\n• Fully compatible with iOS 26, watchOS 26, and the new iPhone 17, iPhone 17 Pro, and iPhone Air.\\n\\nMore Improvements\\n• Overlapping events are now stacked vertically on the timeline.\\n• You can tap anywhere on a cell in the Tracking list to start or stop a timer.\\n• Fixed the layout of event name suggestions when using an external keyboard.\",\"releaseTimestamp\":\"2025-09-15T11:10:35Z\",\"versionDisplay\":\"4.1\"},{\"releaseDate\":\"2025-07-02\",\"releaseNotes\":\"• Fixed an issue where widgets occasionally showed the wrong subscription status.\\n• PDF exports - improved column width for long timeline names.\\n• Fixed a rare crash when tracking is quickly started and then dismissed.\\n• Fixed a crash in goals when changes are synced in from other devices.\\n• Shortcuts - fixed a crash in the 'Start Tracking' action when previous tracking was auto-deleted.\\n• Fixed a rare crash when updating pinned event names.\\n• Improved the onboarding layout on smaller devices with large accessibility text size.\\n• Various other small bugfixes and improvements.\",\"releaseTimestamp\":\"2025-07-02T09:22:00Z\",\"versionDisplay\":\"4.0.1\"},{\"releaseDate\":\"2025-06-05\",\"releaseNotes\":\"Timelines 4 is finally here!\\n\\nManage and Pin Subcategories\\n• Create and update subcategories while editing a timeline.\\n• Pin your most commonly used event names to the Tracking screen for quick one-tap tracking.\\n• Customize your pinned event names for each Focus mode.\\n\\nCombined Goals\\n• Set a shared goal across multiple timelines.\\n• View your progress in the Home Screen and Lock Screen widgets.\\n\\nSiri Shortcuts Enhancements\\n• Enhanced return values for more powerful automations.\\n• The Get Tracking Status shortcut action now also returns the start time and event name.\\n\\nImproved Live Activity\\n• Stop tracking directly from your Lock Screen.\\n\\nMore Improvements\\n• Show search results on the timeline and in charts.\\n• View archived categories on the timeline and in reporting.\\n• Shift the end of your day — perfect if you work late or on night shifts.\\n• Automatically delete accidentally tracked short events.\\n\\nThis has been in the works for a long time, and I truly hope you enjoy this update as much as I enjoyed working on it. And as always, your feedback or rating on the App Store is much appreciated!\\n- Lukas\",\"releaseTimestamp\":\"2025-06-05T08:55:54Z\",\"versionDisplay\":\"4.0\"},{\"releaseDate\":\"2025-05-07\",\"releaseNotes\":\"• Small bugfixes and improvements.\",\"releaseTimestamp\":\"2025-05-07T13:09:28Z\",\"versionDisplay\":\"3.11.9\"},{\"releaseDate\":\"2025-04-01\",\"releaseNotes\":\"• Various small bugfixes and improvements.\",\"releaseTimestamp\":\"2025-04-01T08:51:18Z\",\"versionDisplay\":\"3.11.8\"},{\"releaseDate\":\"2025-03-21\",\"releaseNotes\":\"• Added a 'notes' parameter to Siri Shortcuts actions for starting and stopping tracking.\\n• The top Lock Screen widget now displays the emoji associated with your actively tracked timeline.\\n• Fixed occasionaly incorrect event names when importing multiple Health types into one timeline.\\n• Fixed a crash on macOS when stopping tracking using the interactive tracking widget.\\n• Various other small bugfixes and improvements.\",\"releaseTimestamp\":\"2025-03-21T15:15:50Z\",\"versionDisplay\":\"3.11.7\"},{\"releaseDate\":\"2025-01-07\",\"releaseNotes\":\"• Various small bugfixes and improvements.\",\"releaseTimestamp\":\"2025-01-07T20:55:42Z\",\"versionDisplay\":\"3.11.6\"},{\"releaseDate\":\"2024-11-27\",\"releaseNotes\":\"• Small bugfixes and improvements.\",\"releaseTimestamp\":\"2024-11-27T20:43:42Z\",\"versionDisplay\":\"3.11.5\"},{\"releaseDate\":\"2024-10-29\",\"releaseNotes\":\"• Fixed short delay when stopping tracking using an interactive home screen widget.\\n• Fixed a rare issue where importing sleep events from Apple Health sometimes didn't work.\",\"releaseTimestamp\":\"2024-10-29T20:59:09Z\",\"versionDisplay\":\"3.11.4\"},{\"releaseDate\":\"2024-10-12\",\"releaseNotes\":\"• Improved Home Screen widgets preview when adding them in the gallery.\\n• Improved empty states of Home Screen widgets.\\n• Fixed: Configuring event names tracking widget.\\n• Fixed: Importing sleep events from Apple Health sometimes didn't work when watchOS 11 is used to track sleep. \",\"releaseTimestamp\":\"2024-10-12T18:12:23Z\",\"versionDisplay\":\"3.11.3\"},{\"releaseDate\":\"2024-10-01\",\"releaseNotes\":\"• Fixed: Small timer text in the Dynamic Island on iOS 18.\\n• Fixed: Home Screen tracking status widget sometimes wrongly showing running timer on iOS 18.\",\"releaseTimestamp\":\"2024-10-01T20:48:26Z\",\"versionDisplay\":\"3.11.2\"},{\"releaseDate\":\"2024-09-16\",\"releaseNotes\":\"• Fixed an issue accidentally introduced in version 3.11 where Timelines might have crashed during launch for some users.\",\"releaseTimestamp\":\"2024-09-16T17:21:00Z\",\"versionDisplay\":\"3.11.1\"},{\"releaseDate\":\"2024-09-14\",\"releaseNotes\":\"New Control Center Widgets\\n• Start and stop tracking right in your Control Center.\\n• Replace the flashlight icon on your Lock Screen with a specific timer from Timelines to quickly track your main activity right on your Lock Screen, with just one long press.\\n\\nLive Activity on Apple Watch\\n• When you start tracking on your phone, a new Live Activity will now appear on your Apple Watch.\\n• You can see the timeline name, its color, and the tracked time.\\n• You can also stop tracking right from that Live Activity.\\n\\nTinted Home Screen Support\\n• Timelines now supports the new tinted home screen feature, as well as the dark app icons.\\n \\nCompatibility with iOS 18 and watchOS 11\\n• Timelines for iPhone, iPad, and Apple Watch has been updated throughout, to support the latest changes and improvements in the respective platforms..\\n• Compatibility with the new Apple Watch Series 10 ,iPhone 16, and iPhone 16 Pro.\\n\\nAs always, if you enjoy this update, please consider rating Timelines on the App Store. It really helps. Thank you!\\n- Lukas\",\"releaseTimestamp\":\"2024-09-14T20:39:38Z\",\"versionDisplay\":\"3.11\"},{\"releaseDate\":\"2024-08-06\",\"releaseNotes\":\"Design Improvements\\n• Tracking list now has a more modern look.\\n• Settings screen also got improved.\\n\\nUser Experience Improvements\\n• New context menu action for adding past entries directly in the Tracking tab.\\n• Reorganized context menu actions in the Events Log to make adding past entries easier.\\n• New quick actions for setting the timer start date to the end of the previous event or the present moment.\\n• Added a new screen in Settings that shows the Apple Watch app status.\\n• Added explanatory screens for automation with Siri Shortcuts and using widgets.\\n\\nPerformance Improvements\\n• Optimized app launch speed.\\n• Starting and stopping timers is now even faster.\\n\\nBug Fixes\\n• You can now confirm Timelines Cloud account later.\\n• Fixed an issue where the Welcome screen sometimes appeared after the iPhone was restarted.\\n• Event name suggestions now work correctly with external keyboards.\\n• Various other smaller bug fixes and improvements.\\n\\nAs always, if you enjoy this update, please consider rating Timelines on the App Store. It really helps. Thank you!\\n- Lukas\",\"releaseTimestamp\":\"2024-08-06T15:43:12Z\",\"versionDisplay\":\"3.10\"},{\"releaseDate\":\"2024-05-22\",\"releaseNotes\":\"Visualization Improvements\\n• Emoji support in pie chart\\n• Ordering of pie slices by duration.\\n• Added support for quarters zoom mode on the timeline.\\n• Added new intervals to Statistics home screen widgets: last 7 days, last 30 days, and more. \\n\\nGeneral Improvements\\n• Added context menu actions for editing start dates and end dates of currently tracked events.\\n• Smart combining of overlapping Apple Health events to avoid double-counting their time.\\n• Multi-window support on iPad - great for viewing statistics and breakdowns at the same time.\\n\\nWatch App Improvements\\n• Overlap detection when changing start times and end times of events.\\n• Improved appearance of the active timer screen.\\n• More under-the-hood improvements.\\n\\nVision Pro App Improvements\\n• Place multiple timer windows in your environment.\\n• For example: place a \\\"Cooking\\\" timer in your kitchen, or a \\\"Practicing guitar\\\" timer next to your guitar, for quick access.\\n\\nBug Fixes\\n• Fixed cell highlighting in goal history and in events lists.\\n• Displaying goal limits in home screen widgets correctly.\\n• Fixed a rare bug where timeline event markers were incorrectly showing the tracking state.\\n\\nIf you enjoy this update, please consider rating Timelines on the App Store. It really helps. Thanks!\\n- Lukas\",\"releaseTimestamp\":\"2024-05-22T09:09:31Z\",\"versionDisplay\":\"3.9\"},{\"releaseDate\":\"2024-03-15\",\"releaseNotes\":\"• Reduced app download size.\\n• Fixed a rare crash when reordering timelines in the Tracking tab.\\n• Fixed a rare crash in the background when new day begins.\\n• Various other small bugfixes and improvements.\",\"releaseTimestamp\":\"2024-03-15T11:29:41Z\",\"versionDisplay\":\"3.8.3\"},{\"releaseDate\":\"2024-02-07\",\"releaseNotes\":\"• Small bugfixes and improvements.\",\"releaseTimestamp\":\"2024-02-07T23:12:38Z\",\"versionDisplay\":\"3.8.2\"},{\"releaseDate\":\"2024-01-02\",\"releaseNotes\":\"• Small bugfixes and improvements.\",\"releaseTimestamp\":\"2024-01-02T14:47:44Z\",\"versionDisplay\":\"3.8.1\"},{\"releaseDate\":\"2023-12-13\",\"releaseNotes\":\"Bar Chart Widgets\\n• See trends of your tracked time right on your home screen.\\n• Configure interval (last 7 days, 14 days, 30 days, 10 weeks, and 12 months).\\n• Configure which timelines you want to see.\\n• Optional: view average duration over the selected period and timelines.\\n\\nModernized User Interface\\n• Screens for editing events and timelines are now more modern.\\n• Most detail screens have also been improved.\\n\\nDynamic Type Support\\n• Timelines will now respect your system-wide setting for text size throughout the app.\\n\\nAnd More\\n• Improved reliability of widgets and live activities.\\n• Fixed several small issues when running Timelines for iOS on the Mac.\\n\\nIf you enjoy this update, please consider rating Timelines on the App Store. It really helps. Thanks!\\n- Lukas\",\"releaseTimestamp\":\"2023-12-13T14:15:04Z\",\"versionDisplay\":\"3.8\"},{\"releaseDate\":\"2023-11-06\",\"releaseNotes\":\"• Various small bug-fixes and improvements.\",\"releaseTimestamp\":\"2023-11-06T15:20:56Z\",\"versionDisplay\":\"3.7.3\"},{\"releaseDate\":\"2023-10-26\",\"releaseNotes\":\"• Various small bug-fixes and improvements.\",\"releaseTimestamp\":\"2023-10-26T15:28:13Z\",\"versionDisplay\":\"3.7.2\"},{\"releaseDate\":\"2023-10-13\",\"releaseNotes\":\"• Fixed a rare issue where Timelines would crash on launch on iPadOS 17 when Health was enabled on iPad.\\n• Interactive tracking widget now respects the setting of prompting for an event name.\\n• Improved design of the Timelines Lock Screen widget.\",\"releaseTimestamp\":\"2023-10-13T15:45:16Z\",\"versionDisplay\":\"3.7.1\"},{\"releaseDate\":\"2023-09-17\",\"releaseNotes\":\"New Interactive Widgets\\n• Control your timers directly from your home screen.\\n• New configurable widget for easy tracking of named subcategories.\\n\\niPad Lock Screen Widgets\\n• See your statistics, personal goals, and timers right on your iPad Lock Screen.\\n• Both portrait and landscape orientations are supported.\\n\\nAnd More\\n• Widgets in Stand By mode when your iPhone is charging and in landscape orientation.\\n• Compatibility with iOS 17 and watchOS 10.\\n\\nIf you enjoy this update, please consider rating Timelines on the App Store. It really helps. Thanks!\\n- Lukas\",\"releaseTimestamp\":\"2023-09-17T21:20:51Z\",\"versionDisplay\":\"3.7\"},{\"releaseDate\":\"2023-08-08\",\"releaseNotes\":\"Calendar Integration\\n• Have your calendar events automatically imported into Timelines.\\n• Configure the mapping between calendars and timelines.\\n• Importing is fully customizable.\\n• Repeating events are also supported.\\n\\nContextual Events Lists\\n• View and edit your individual events.\\n• Accessible from Bar chart, Goal history, and from Events breakdown (pie chart).\\n• Great for those of you who name your events and need to edit them later.\\n\\nAnd more..\\n• Small bugfixes and improvements.\\n\\nIf you enjoy this update, please consider rating Timelines on the App Store, it really helps. Thanks!\\n- Lukas\",\"releaseTimestamp\":\"2023-08-08T15:34:03Z\",\"versionDisplay\":\"3.6\"}],\"videoPreviewsByType\":{},\"websiteUrl\":\"https://timelines.app\"},\"xros\":{\"artwork\":{\"bgColor\":\"ffffff\",\"height\":512,\"textColor1\":\"0d193d\",\"textColor2\":\"3d1d45\",\"textColor3\":\"3e4763\",\"textColor4\":\"634a6a\",\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Purple211/v4/72/6b/f5/726bf53c-5b74-29e3-edeb-da155b4e0f44/AppIcon-vision.lsr/{w}x{h}{c}.{f}\",\"width\":512},\"bundleId\":\"com.glimsoft.Timelines\",\"customAttributes\":{\"default\":{\"default\":{\"customScreenshotsByType\":{\"appleVisionPro\":[{\"bgColor\":\"a19c92\",\"height\":2160,\"textColor1\":\"141312\",\"textColor2\":\"26211c\",\"textColor3\":\"302e2b\",\"textColor4\":\"3e3a33\",\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource211/v4/4f/c6/7c/4fc67c81-d0a5-7f93-8fb3-f57b9e703614/341ff59d-2dad-4425-950b-43f89d006348_Apple-Vision-screenshot-1.png/{w}x{h}{c}.{f}\",\"width\":3840},{\"bgColor\":\"a39e92\",\"height\":2160,\"textColor1\":\"0f0d09\",\"textColor2\":\"1e1d19\",\"textColor3\":\"2c2a25\",\"textColor4\":\"393731\",\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource221/v4/c7/8c/1a/c78c1a8a-6575-03fd-c13c-a4df9c5c42ff/287cdabe-6bce-4513-aa9c-deb0fddb28bb_Apple-Vision-screenshot-2.png/{w}x{h}{c}.{f}\",\"width\":3840},{\"bgColor\":\"a39d92\",\"height\":2160,\"textColor1\":\"020201\",\"textColor2\":\"19130b\",\"textColor3\":\"22211e\",\"textColor4\":\"352e26\",\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource211/v4/45/54/5a/45545a6a-bfcf-0a53-71f0-a10598d3b21f/f24a34b0-e349-47dc-91c5-9913be68cd31_Apple-Vision-screenshot-3.png/{w}x{h}{c}.{f}\",\"width\":3840},{\"bgColor\":\"a39d92\",\"height\":2160,\"textColor1\":\"020201\",\"textColor2\":\"19130b\",\"textColor3\":\"22211e\",\"textColor4\":\"352e26\",\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource211/v4/d6/ff/bd/d6ffbda9-be5b-be13-0aca-e51416324bf6/d93b9147-b80e-4b06-8826-7259d5a282ab_Apple-Vision-screenshot-4.png/{w}x{h}{c}.{f}\",\"width\":3840},{\"bgColor\":\"a49e92\",\"height\":2160,\"textColor1\":\"11080d\",\"textColor2\":\"1e1e1d\",\"textColor3\":\"2e2628\",\"textColor4\":\"383734\",\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource221/v4/e0/20/c5/e020c5e9-4aa1-8790-f077-a652ed979b23/e562276b-3bdf-4fae-8569-d87553df4730_Apple-Vision-screenshot-5.png/{w}x{h}{c}.{f}\",\"width\":3840}]},\"customVideoPreviewsByType\":{}}}},\"description\":{\"standard\":\"Timelines is easy-to-use, flexible yet powerful time tracking app. Record what you're doing and get insights into your time with interactive timeline and charts. Understand trends, stay motivated to reach your time-based goals, and make the most out of your time!\\n\\nI personally wasn't happy with the way I was spending my time, so I decided to build a tool to help myself and others figure out a way to become more efficient. Timelines has been enabling me and other users to understand where our time is actually going, helping us improve our routines and achieve more in our lives. I sincerely believe it can do the same for you.\\n– Lukas Petr, independent developer of Timelines\\n\\nTimelines has been featured by Apple, and reviewed on 9To5Mac, MacStories, WatchAware, and AppAdvice.\\n\\n▶ QUICK DATA ENTRY\\n- track any category you want\\n- control timers with just 1 tap\\n- grid mode of timers\\n- track from lock screen with the today widget\\n- easily edit past events\\n\\n▶ POWERFUL VISUALIZATIONS\\n- see your time on an interactive timeline\\n- playful statistics mode with pie chart\\n- trends over time using bar chart\\n- subcategories - breakdown of your events\\n- quickly filter categories\\n\\n▶ SYNC BETWEEN DEVICES\\n- have an always up-to-date backup of your data with Timelines Cloud\\n- sync between your iPhone, iPad, and Apple Watch, in real-time\\n- sign in using your email address or your Apple ID\\n\\n▶ GOALS\\n- define daily, weekly, and monthly goals\\n- see your progress and stay on track\\n- periodic reports with rich notifications\\n- get rewarded for reaching a goal with confetti\\n\\n▶ AUTOMATIONS\\n- build workflows with Siri Shortcuts\\n- use Siri to start and stop timers\\n- import workouts, sleep, and meditation from Apple Health\\n\\n▶ AND MORE\\n- detailed PDF and CSV exports\\n- timely and customizable reminders\\n- archive unused categories\\n- lots of possible customizations\\n\\n▶ APPLE WATCH APP\\n- watch face complication for quick access\\n- haptic feedback on start and stop of timers\\n- set event names using dictation or choose from recent\\n- adjust start and end times using the digital crown\\n- see active timer’s duration and category on watch face\\n- real-time sync with iPhone and iPad using Timelines Cloud\\n- see list of past past entries and edit them easily\\n- daily, weekly, monthly, or yearly statistics\\n\\n▶ WHAT IS FREE?\\n- track up to 3 categories\\n- basic exporting\\n- pie chart\\n- see events on a timeline\\n- events log\\n- reminders\\n\\n▶ TIMELINES PRO\\n- sync between devices\\n- unlimited categories\\n- bar chart\\n- goals\\n- detailed exports\\n- import from Apple Health\\n- subcategories\\n- support development\\n\\nStart taking control of your time today. It only takes a few days of tracking to start uncovering ways to maximize your time and productivity.\\n\\nI love working on Timelines, and a big part of my vision is to listen closely to users and incorporate their feedback. If you have any questions or suggestions, please reach out to me at\\nlukas@timelines.app.\\n– Lukas Petr, author of Timelines\\n\\n* Privacy policy: https://timelines.app/privacy/\\n* Terms of Use: https://timelines.app/terms/\"},\"editorialArtwork\":{\"brandLogo\":{\"bgColor\":\"000000\",\"height\":1080,\"textColor1\":\"f2f2f2\",\"textColor2\":\"e5e5e5\",\"textColor3\":\"c1c1c1\",\"textColor4\":\"b7b7b7\",\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Features116/v4/1c/2b/7c/1c2b7cc6-e029-9bf9-f26f-4b5f533ee2fc/af8e3a5e-dba7-4ad7-9b94-9340366eab93.png/{w}x{h}{c}.{f}\",\"width\":1080},\"contentIconTrimmed\":{\"bgColor\":\"0092ff\",\"height\":1080,\"textColor1\":\"00070c\",\"textColor2\":\"000e19\",\"textColor3\":\"00233d\",\"textColor4\":\"002947\",\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Features126/v4/09/15/89/091589bc-f33b-2d71-9e77-2ef3729cd955/abc2adb6-5a59-47b0-b8f5-84523bdd6bd8.png/{w}x{h}{c}.{f}\",\"width\":1048},\"contentIconTrimmedMonochrome\":{\"bgColor\":\"000000\",\"height\":1080,\"textColor1\":\"f2f2f2\",\"textColor2\":\"e5e5e5\",\"textColor3\":\"c1c1c1\",\"textColor4\":\"b7b7b7\",\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Features116/v4/6e/e2/e7/6ee2e7db-bf98-0d30-7adf-15aa80debeb5/721e011e-109f-4227-8978-1f8c6071c48f.png/{w}x{h}{c}.{f}\",\"width\":1048},\"storeFlowcase\":{\"bgColor\":\"f0f8fe\",\"height\":1080,\"textColor1\":\"0a0b0b\",\"textColor2\":\"0c0d0d\",\"textColor3\":\"383a3c\",\"textColor4\":\"3a3c3d\",\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Features71/v4/16/a4/66/16a4668c-c24b-bf70-9a71-1c342d175bcb/mza_1282539062703453961.png/{w}x{h}{c}.{f}\",\"width\":4320}},\"editorialNotes\":{\"standard\":\"Time is like money: we never have enough, and we often can’t remember how we spent it. Timelines is razor-sharp instrument in our time-management toolkit, letting us categorize and visualize where the hours in our hectic days are going. We love it for everything from tracking billable time on projects to making sure we’re setting aside chunks of our week to relax with loved ones.\"},\"hasInAppPurchases\":true,\"hasMessagesExtension\":false,\"hasSafariExtension\":false,\"isAppleWatchSupported\":false,\"isDeliveredInIOSAppForWatchOS\":false,\"isHiddenFromSpringboard\":false,\"isStandaloneForWatchOS\":false,\"isStandaloneWithCompanionForWatchOS\":false,\"isXROSCompatible\":false,\"messagesScreenshots\":{},\"minimumMacOSVersion\":\"12.0\",\"offers\":[{\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":50733056}],\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=1112433234\u0026pricingParameters=STDQ\u0026pg=default\u0026appExtVrsId=875289800\",\"currencyCode\":\"USD\",\"price\":0,\"priceFormatted\":\"$0.00\",\"priceString\":\"0.00\",\"type\":\"get\"},{\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":50733056}],\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=1112433234\u0026pricingParameters=SWUPD\u0026pg=default\u0026appExtVrsId=875289800\",\"currencyCode\":\"USD\",\"price\":0,\"priceFormatted\":\"$0.00\",\"priceString\":\"0.00\",\"type\":\"update\"}],\"privacyPolicyUrl\":\"https://timelines.app/privacy/\",\"releaseDate\":\"2016-08-12\",\"requires32bit\":false,\"requiresGameController\":false,\"subtitle\":\"Personal \u0026 Work Hours Tracker\",\"supportURLForLanguage\":\"https://timelines.app\",\"versionHistory\":[{\"releaseDate\":\"2025-06-05\",\"releaseNotes\":\"Timelines 4 is finally here!\\n\\nManage and Pin Subcategories\\n• Create and update subcategories while editing a timeline.\\n• Pin your most commonly used event names to the Tracking screen for quick one-tap tracking.\\n• Customize your pinned event names for each Focus mode.\\n\\nCombined Goals\\n• Set a shared goal across multiple timelines.\\n• View your progress in the Home Screen and Lock Screen widgets.\\n\\nSiri Shortcuts Enhancements\\n• Enhanced return values for more powerful automations.\\n• The Get Tracking Status shortcut action now also returns the start time and event name.\\n\\nImproved Live Activity\\n• Stop tracking directly from your Lock Screen.\\n\\nMore Improvements\\n• Show search results on the timeline and in charts.\\n• View archived categories on the timeline and in reporting.\\n• Shift the end of your day — perfect if you work late or on night shifts.\\n• Automatically delete accidentally tracked short events.\\n\\nThis has been in the works for a long time, and I truly hope you enjoy this update as much as I enjoyed working on it. And as always, your feedback or rating on the App Store is much appreciated!\\n- Lukas\",\"releaseTimestamp\":\"2025-06-05T08:56:17Z\",\"versionDisplay\":\"4.0\"},{\"releaseDate\":\"2024-09-24\",\"releaseNotes\":\"New Control Center Widgets\\n• Start and stop tracking right in your Control Center.\\n• Replace the flashlight icon on your Lock Screen with a specific timer from Timelines to quickly track your main activity right on your Lock Screen, with just one long press.\\n\\nLive Activity on Apple Watch\\n• When you start tracking on your phone, a new Live Activity will now appear on your Apple Watch.\\n• You can see the timeline name, its color, and the tracked time.\\n• You can also stop tracking right from that Live Activity.\\n\\nTinted Home Screen Support\\n• Timelines now supports the new tinted home screen feature, as well as the dark app icons.\\n \\nCompatibility with visionOS 2, iOS 18, and watchOS 11\\n• Timelines for Apple Vision Pro, iPhone, iPad, Apple Watch has been updated throughout, to support the latest changes and improvements in the respective platforms..\\n• Compatibility with the new Apple Watch Series 10, iPhone 16, and iPhone 16 Pro.\\n\\nAs always, if you enjoy this update, please consider rating Timelines on the App Store. It really helps. Thank you!\\n- Lukas\",\"releaseTimestamp\":\"2024-09-24T13:07:00Z\",\"versionDisplay\":\"3.11\"},{\"releaseDate\":\"2024-08-06\",\"releaseNotes\":\"Design Improvements\\n• Tracking list now has a more modern look.\\n• Settings screen also got improved.\\n\\nUser Experience Improvements\\n• New context menu action for adding past entries directly in the Tracking tab.\\n• Reorganized context menu actions in the Events Log to make adding past entries easier.\\n• New quick actions for setting the timer start date to the end of the previous event or the present moment.\\n• Added a new screen in Settings that shows the Apple Watch app status.\\n• Added explanatory screens for automation with Siri Shortcuts and using widgets.\\n\\nPerformance Improvements\\n• Optimized app launch speed.\\n• Starting and stopping timers is now even faster.\\n\\nBug Fixes\\n• You can now confirm Timelines Cloud account later.\\n• Fixed an issue where the Welcome screen sometimes appeared after the iPhone was restarted.\\n• Event name suggestions now work correctly with external keyboards.\\n• Various other smaller bug fixes and improvements.\\n\\nAs always, if you enjoy this update, please consider rating Timelines on the App Store. It really helps. Thank you!\\n- Lukas\",\"releaseTimestamp\":\"2024-08-06T15:42:38Z\",\"versionDisplay\":\"3.10\"},{\"releaseDate\":\"2024-05-22\",\"releaseNotes\":\"Visualization Improvements\\n• Emoji support in pie chart\\n• Ordering of pie slices by duration.\\n• Added support for quarters zoom mode on the timeline.\\n• Added new intervals to Statistics home screen widgets: last 7 days, last 30 days, and more. \\n\\nGeneral Improvements\\n• Added context menu actions for editing start dates and end dates of currently tracked events.\\n• Smart combining of overlapping Apple Health events to avoid double-counting their time.\\n• Multi-window support on iPad - great for viewing statistics and breakdowns at the same time.\\n\\nWatch App Improvements\\n• Overlap detection when changing start times and end times of events.\\n• Improved appearance of the active timer screen.\\n• More under-the-hood improvements.\\n\\nVision Pro App Improvements\\n• Place multiple timer windows in your environment.\\n• For example: place a \\\"Cooking\\\" timer in your kitchen, or a \\\"Practicing guitar\\\" timer next to your guitar, for quick access.\\n\\nBug Fixes\\n• Fixed cell highlighting in goal history and in events lists.\\n• Displaying goal limits in home screen widgets correctly.\\n• Fixed a rare bug where timeline event markers were incorrectly showing the tracking state.\\n• Updated versioning of Timelines for Vision Pro to be aligned with other platforms.\\n\\nIf you enjoy this update, please consider rating Timelines on the App Store. It really helps. Thanks!\\n- Lukas\",\"releaseTimestamp\":\"2024-05-22T09:08:29Z\",\"versionDisplay\":\"3.9\"},{\"releaseDate\":\"2024-02-08\",\"releaseNotes\":\"• Small bugfixes and improvements.\",\"releaseTimestamp\":\"2024-02-08T22:03:52Z\",\"versionDisplay\":\"1.0.1\"},{\"releaseDate\":\"2024-01-31\",\"releaseNotes\":null,\"releaseTimestamp\":\"2024-01-31T22:25:40Z\",\"versionDisplay\":\"1.0\"}],\"videoPreviewsByType\":{},\"websiteUrl\":\"https://timelines.app\"}},\"