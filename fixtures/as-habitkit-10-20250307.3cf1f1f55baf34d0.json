l=en-US\",\"attributes\":{\"genreNames\":[],\"editorialArtwork\":{},\"name\":\"Maximilian Munker\",\"mediaType\":\"Mobile Software Applications\",\"url\":\"https://apps.apple.com/us/developer/maximilian-munker/id983733173\"}}]},\"genres\":{\"href\":\"/v1/catalog/us/apps/1547137474/genres?l=en-US\",\"data\":[{\"id\":\"6007\",\"type\":\"genres\",\"href\":\"/v1/catalog/us/genres/6007?l=en-US\",\"attributes\":{\"parentName\":\"App Store\",\"name\":\"Productivity\",\"parentId\":\"36\",\"url\":\"https://itunes.apple.com/us/genre/id6007\"}},{\"id\":\"6013\",\"type\":\"genres\",\"href\":\"/v1/catalog/us/genres/6013?l=en-US\",\"attributes\":{\"parentName\":\"App Store\",\"name\":\"Health \u0026 Fitness\",\"parentId\":\"36\",\"url\":\"https://itunes.apple.com/us/genre/id6013\"}}]}},\"meta\":{\"contentVersion\":{\"MZ_INDEXER\":1739963185860,\"RTCI\":1738967404734}}},{\"id\":\"1514915737\",\"type\":\"apps\",\"href\":\"/v1/catalog/us/apps/1514915737?l=en-US\",\"attributes\":{\"distributionKind\":\"APP_STORE\",\"supportsArcade\":false,\"isFirstPartyHideableApp\":false,\"privacy\":{\"privacyTypes\":[{\"privacyType\":\"Data Not Linked to You\",\"identifier\":\"DATA_NOT_LINKED_TO_YOU\",\"description\":\"The following data may be collected but it is not linked to your identity:\",\"dataCategories\":[{\"dataCategory\":\"Purchases\",\"identifier\":\"PURCHASES\"}]}]},\"contentRatingsBySystem\":{\"appsApple\":{\"name\":\"12+\",\"value\":300,\"rank\":3,\"advisories\":[\"Infrequent/Mild Alcohol, Tobacco, or Drug Use or References\"]}},\"deviceFamilies\":[\"mac\",\"watch\",\"iphone\",\"ipad\",\"ipod\"],\"supportsStreamlinedBuy\":true,\"url\":\"https://apps.apple.com/us/app/awesome-habits-habit-tracker/id1514915737\",\"userRating\":{\"value\":4.8,\"ratingCount\":645,\"ratingCountList\":[9,7,9,49,571],\"ariaLabelForRatings\":\"4.8 stars\"},\"watchBundleId\":\"com.dreamer.Habits.watchkitapp\",\"firstVersionSupportingInAppPurchaseApi\":\"1.0.1\",\"genreDisplayName\":\"Productivity\",\"name\":\"Awesome Habits: Habit Tracker\",\"isPreorder\":false,\"artistName\":\"Michal Tuma\",\"reviewsRestricted\":false,\"isIOSBinaryMacOSCompatible\":false,\"requirementsByDeviceFamily\":{\"ipod\":{\"deviceFamily\":\"iPod touch\",\"requirementString\":\"Requires iOS 15.2 or later.\"},\"mac\":{\"deviceFamily\":\"Mac\",\"requirementString\":\"Requires macOS 12.1 or later.\"},\"iphone\":{\"deviceFamily\":\"iPhone\",\"requirementString\":\"Requires iOS 15.2 or later.\"},\"watch\":{\"deviceFamily\":\"Apple Watch\",\"requirementString\":\"Requires watchOS 8.0 or later.\"},\"ipad\":{\"deviceFamily\":\"iPad\",\"requirementString\":\"Requires iPadOS 15.2 or later.\"},\"realityDevice\":{\"deviceFamily\":\"Apple Vision\",\"requirementString\":\"Requires visionOS 1.0 or later.\"}},\"minimumWatchOSVersion\":\"8.0\",\"platformAttributes\":{\"osx\":{\"description\":{\"standard\":\"Don't set goals, build habits.\\n\\nDo you remember the last time you wanted to achieve something? You may have started strong, but after some time, maybe you lost motivation. Here is our tip – instead of setting goals, start building your daily routines, and improving your regular habits. Small and easy changes will compound into remarkable results. With our app, you will get better every day and achieve the kind of success that lasts.\\n\\nBuild good habits, break bad ones.\\nWant to cut down on alcohol, improve your healthy habits, or be more productive? Possibilities are unlimited. Get inspiration from our pre-defined templates or add your custom habit.\\n\\nAchieve your daily, weekly, and monthly goals.\\nUsing a simple overview, you can easily manage all your goals and see your achievements. Have you overachieved your goal? You can track that too.\\n\\nTrack your progress.\\nBrowse history, check out your stats and see how you've improved over time.\\nDidn't have time to track a previous day? No problem, you can easily update any record in the past.\\n\\nFeatures:\\n- Build good habits, break bad ones\\n- Daily, weekly, and monthly goals\\n- Track even overachieved goals\\n- Track time-based goals with timers\\n- History and statistics\\n- Habit lists\\n- Habit notes\\n- 2,500+ icons \u0026 emojis\\n- Apple Health support (available on iOS)\\n- Reminders, app badge, and Apple Health notifications\\n- Interactive widgets for Home Screen, Lock Screen, and StandBy mode\\n- Interactive Dynamic Island \u0026 Live Activities\\n- Apple Watch complications and the Smart Stack widget\\n- Works on iPhone, iPad, Mac, and Apple Watch\\n- iCloud backup \u0026 sync\\n- Export to a CSV file\\n- Siri Shortcuts\\n- Dark Mode support and appearance customization\\n\\nTerms of Use: https://www.awesome-habits.com/terms-conditions\\nPrivacy Policy: https://www.awesome-habits.com/privacy-policy\"},\"isStandaloneWithCompanionForWatchOS\":false,\"isAppleWatchSupported\":false,\"requiredCapabilitiesForRealityDevice\":\"arm64 \",\"versionHistory\":[{\"versionDisplay\":\"6.2.4\",\"releaseNotes\":\"• Get started tips: We've added a new help section with tips and how-to guides to help new users get started.\\n• Bug fixes and performance improvements\",\"releaseDate\":\"2025-01-21\",\"releaseTimestamp\":\"2025-01-21T18:40:38Z\"},{\"versionDisplay\":\"6.2.2\",\"releaseNotes\":\"Be awesome in 2025\\n• Reset habit history: Need a fresh start? Easily reset your habit history with the button on the history details screen.\\n• More start of day options: Prefer updating your progress the next morning? Set your start of day to any hour between midnight and noon.\\n• Bug fixes and performance improvements\",\"releaseDate\":\"2025-01-03\",\"releaseTimestamp\":\"2025-01-03T16:18:46Z\"},{\"versionDisplay\":\"6.2\",\"releaseNotes\":\"• Personalize your habit icons like never before. With macOS Sequoia 15.2, you can now use custom stickers and Genmoji created on your iPhone or iPad as habit icons.\\n• Bug fixes and performance improvements\",\"releaseDate\":\"2024-12-13\",\"releaseTimestamp\":\"2024-12-13T01:10:34Z\"},{\"versionDisplay\":\"6.1\",\"releaseNotes\":\"• Quick actions menus: Right-click (or Control-click) a habit to access quick actions like adding a custom value, adding a note, editing, archiving, and more. These quick actions are available throughout the app, including the Home tab, History tab, and calendar view. Available on macOS Sonoma and later.\\n• Adaptive custom repeat: For habits with a custom repeat (e.g., exercising every 3 days), the next repeats now automatically adjust based on the last completion. This ensures you maintain the intended interval, even if you complete the goal on a different day than planned.\\n• Bug fixes and performance improvements\",\"releaseDate\":\"2024-11-30\",\"releaseTimestamp\":\"2024-11-30T03:39:56Z\"},{\"versionDisplay\":\"6.0.6\",\"releaseNotes\":\"• Minor visual refresh of the macOS icon\\n• Bug fixes and performance improvements\",\"releaseDate\":\"2024-10-22\",\"releaseTimestamp\":\"2024-10-22T18:19:50Z\"},{\"versionDisplay\":\"6.0.4\",\"releaseNotes\":\"• Bug fixes and performance improvements\",\"releaseDate\":\"2024-09-25\",\"releaseTimestamp\":\"2024-09-25T07:24:29Z\"},{\"versionDisplay\":\"6.0.2\",\"releaseNotes\":\"• Bug fixes and performance improvements\",\"releaseDate\":\"2024-09-18\",\"releaseTimestamp\":\"2024-09-18T19:59:35Z\"},{\"versionDisplay\":\"6.0\",\"releaseNotes\":\"• We've added support for the new, compact tab bar, now positioned above the app's content. Available on macOS Sequoia.\",\"releaseDate\":\"2024-09-15\",\"releaseTimestamp\":\"2024-09-15T20:29:55Z\"},{\"versionDisplay\":\"5.5.2\",\"releaseNotes\":\"• Bug fixes and performance improvements\",\"releaseDate\":\"2024-07-11\",\"releaseTimestamp\":\"2024-07-11T07:00:22Z\"},{\"versionDisplay\":\"5.5\",\"releaseNotes\":\"• Heat maps: Get a comprehensive view of your daily habits with a 365-day heat map.\\n• Calendar view: Browse your habit history conveniently using a calendar view.\\n• Start of day: Choose your preferred start of the day to update your progress conveniently even late at night.\\n• Time Sensitive Notifications: Receive reminders on time, even in Focus Mode. Customize this feature in the system settings.\\n• Bug fixes and performance improvements\",\"releaseDate\":\"2024-07-04\",\"releaseTimestamp\":\"2024-07-04T07:24:49Z\"},{\"versionDisplay\":\"5.3.3\",\"releaseNotes\":\"• Bug fixes and performance improvements\",\"releaseDate\":\"2024-06-02\",\"releaseTimestamp\":\"2024-06-02T20:52:15Z\"},{\"versionDisplay\":\"5.3\",\"releaseNotes\":\"• Customize sounds: Choose from 25 sounds for reminders and completed habits to personalize your experience and celebrate your achievements.\\n• Bug fixes and performance improvements\",\"releaseDate\":\"2024-04-30\",\"releaseTimestamp\":\"2024-04-30T08:43:21Z\"},{\"versionDisplay\":\"5.2.3\",\"releaseNotes\":\"• Habit notes timeline: View all your habit notes on a single timeline. Click the clock icon on the habit card and switch to the Notes tab.\\n• End date for archived habits: Stopped tracking a habit but forgot to archive it? Now, you can set an end date for your archived habits.\\n• Bug fixes and performance improvements\",\"releaseDate\":\"2024-03-04\",\"releaseTimestamp\":\"2024-03-04T06:51:17Z\"},{\"versionDisplay\":\"5.2.2\",\"releaseNotes\":\"Bug fixes and performance improvements\",\"releaseDate\":\"2024-02-05\",\"releaseTimestamp\":\"2024-02-05T09:31:58Z\"},{\"versionDisplay\":\"5.2.1\",\"releaseNotes\":\"Bug fixes and performance improvements\",\"releaseDate\":\"2024-02-01\",\"releaseTimestamp\":\"2024-02-01T00:53:31Z\"},{\"versionDisplay\":\"5.2\",\"releaseNotes\":\"Happy Holidays!\\n\\n• Vacation mode: Need a break before new year’s challenges? Try our new Vacation mode. It lets you pause your habits while keeping your streaks intact.\\n• Bug fixes and performance improvements\",\"releaseDate\":\"2023-12-25\",\"releaseTimestamp\":\"2023-12-25T14:31:01Z\"},{\"versionDisplay\":\"5.1.1\",\"releaseNotes\":\"• Bug fixes and performance improvements\",\"releaseDate\":\"2023-11-13\",\"releaseTimestamp\":\"2023-11-13T21:01:47Z\"},{\"versionDisplay\":\"5.1\",\"releaseNotes\":\"• Add custom progress: For habits with larger goals, you can now quickly add a custom progress value directly from the habit card.\\n• Last change date: Not sure when you last updated your progress? Drag a habit card up to check the date of your last change.\\n• New Apple Health metrics: Track the time you spend in daylight to improve your physical and mental well-being (requires an Apple Watch with watchOS 10). Also, you can now track Flexibility and Mind \u0026 body workouts.\",\"releaseDate\":\"2023-10-25\",\"releaseTimestamp\":\"2023-10-25T18:57:04Z\"},{\"versionDisplay\":\"5.0\",\"releaseNotes\":\"• Interactive widgets: Update your progress with a single tap, directly from the widgets. Available with iOS 17 and macOS Sonoma.\\n• Interactive Dynamic Island \u0026 Live Activities: Pause or stop habit timers directly from the Dynamic Island or from the iPhone and iPad Lock Screen. Available with iOS 17.\\n• New places for widgets: Add widgets in StandBy mode, to iPad Lock Screen, and Smart Stack on Apple Watch. Available with iOS 17 and watchOS 10.\\n• Improved shortcuts: You can now run multi-step shortcuts without opening the app. Simply turn off “Open When Run” option in Shortcuts app editor.\\n\",\"releaseDate\":\"2023-09-22\",\"releaseTimestamp\":\"2023-09-22T05:44:06Z\"},{\"versionDisplay\":\"4.8\",\"releaseNotes\":\"• Interactive charts: Swipe through the charts to browse your history. Hover over to view details.\\n• Weekly averages: Switch to the weekly tab in the charts to compare your results on a weekly basis.\\n• New emojis: Personalize your habits with the latest emojis. \\n• Bug fixes and performance improvements\",\"releaseDate\":\"2023-07-10\",\"releaseTimestamp\":\"2023-07-10T12:07:59Z\"},{\"versionDisplay\":\"4.7.2\",\"releaseNotes\":\"Bug fixes and performance improvements\",\"releaseDate\":\"2023-05-16\",\"releaseTimestamp\":\"2023-05-16T15:19:39Z\"},{\"versionDisplay\":\"4.7.1\",\"releaseNotes\":\"Bug fixes and performance improvements\",\"releaseDate\":\"2023-05-01\",\"releaseTimestamp\":\"2023-05-01T08:43:25Z\"},{\"versionDisplay\":\"4.7\",\"releaseNotes\":\"• Group skipped and completed: Now you can easily group skipped or completed habits. Turn this option on in Settings \u003e General \u003e Sorting \u0026 Grouping.\\n• Custom repeat: Set custom repeats for your habits. E.g. exercise every 3 days.\\n• New Apple Health metrics: Track your Stand minutes and Traditional strength training.\",\"releaseDate\":\"2023-04-22\",\"releaseTimestamp\":\"2023-04-22T08:23:06Z\"},{\"versionDisplay\":\"4.6\",\"releaseNotes\":\"• Data export: Now you can easily export your data to a CSV file and dive deeper into your results.\\n• New emojis: Personalize your habits with the latest emojis.\",\"releaseDate\":\"2023-02-10\",\"releaseTimestamp\":\"2023-02-10T06:59:05Z\"},{\"versionDisplay\":\"4.5\",\"releaseNotes\":\"Be awesome in 2023!\\n• New Apple Health categories: Track your workouts, stand hours, toothbrushing, and more. Available on your iPhone and Apple Watch.\\n• Live Activities: Start a habit timer and leave it open to see the elapsed time on your Lock Screen. Available on your iPhone with iOS 16.1 and later.\\n• New Siri Shortcuts: Change the goal, add custom progress, or get a habit status. Available in the Shortcuts app.\\n• Bug fixes and performance improvements\",\"releaseDate\":\"2023-01-04\",\"releaseTimestamp\":\"2023-01-04T15:55:34Z\"}],\"websiteUrl\":\"https://www.awesome-habits.com\",\"minimumXROSVersion\":\"1.0\",\"isXROSCompatible\":true,\"hasSafariExtension\":false,\"messagesScreenshots\":{},\"requiresGameController\":false,\"offers\":[{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=1514915737\u0026pricingParameters=STDQ\u0026pg=default\u0026appExtVrsId=871892947\",\"type\":\"get\",\"priceFormatted\":\"$0.00\",\"price\":0,\"currencyCode\":\"USD\",\"assets\":[{\"flavor\":\"macSoftware\",\"size\":10179025}]},{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=1514915737\u0026pricingParameters=SWUPD\u0026pg=default\u0026appExtVrsId=871892947\",\"type\":\"update\",\"priceFormatted\":\"$0.00\",\"price\":0,\"currencyCode\":\"USD\",\"assets\":[{\"flavor\":\"macSoftware\",\"size\":10179025}]}],\"requires32bit\":false,\"releaseDate\":\"2020-06-23\",\"hasInAppPurchases\":true,\"bundleId\":\"com.dreamer.Habits\",\"hasMessagesExtension\":false,\"artwork\":{\"width\":1024,\"height\":1024,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Purple211/v4/1d/4a/4f/1d4a4fd9-0e77-7078-0c84-49af4af3f5ae/AppIcon-0-0-2x_U007euniversal-0-5-0-85-220.png/{w}x{h}{c}.{f}\",\"bgColor\":\"ffffff\",\"textColor1\":\"252658\",\"textColor2\":\"42225a\",\"textColor3\":\"505179\",\"textColor4\":\"674e7b\"},\"privacyPolicyUrl\":\"https://www.awesome-habits.com/app-privacy-policy\",\"videoPreviewsByType\":{},\"supportURLForLanguage\":\"https://www.awesome-habits.com\",\"isHiddenFromSpringboard\":false,\"isStandaloneForWatchOS\":false,\"isDeliveredInIOSAppForWatchOS\":false,\"runsOnAppleSilicon\":true,\"requiresRosetta\":false,\"editorialArtwork\":{\"contentIconTrimmedMonochrome\":{\"width\":1048,\"height\":1080,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Features116/v4/6e/e2/e7/6ee2e7db-bf98-0d30-7adf-15aa80debeb5/721e011e-109f-4227-8978-1f8c6071c48f.png/{w}x{h}{c}.{f}\",\"bgColor\":\"000000\",\"textColor1\":\"f2f2f2\",\"textColor2\":\"e5e5e5\",\"textColor3\":\"c1c1c1\",\"textColor4\":\"b7b7b7\"},\"contentIconTrimmed\":{\"width\":1048,\"height\":1080,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Features126/v4/09/15/89/091589bc-f33b-2d71-9e77-2ef3729cd955/abc2adb6-5a59-47b0-b8f5-84523bdd6bd8.png/{w}x{h}{c}.{f}\",\"bgColor\":\"0092ff\",\"textColor1\":\"00070c\",\"textColor2\":\"000e19\",\"textColor3\":\"00233d\",\"textColor4\":\"002947\"},\"brandLogo\":{\"width\":1080,\"height\":1080,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Features116/v4/1c/2b/7c/1c2b7cc6-e029-9bf9-f26f-4b5f533ee2fc/af8e3a5e-dba7-4ad7-9b94-9340366eab93.png/{w}x{h}{c}.{f}\",\"bgColor\":\"000000\",\"textColor1\":\"f2f2f2\",\"textColor2\":\"e5e5e5\",\"textColor3\":\"c1c1c1\",\"textColor4\":\"b7b7b7\"}},\"subtitle\":\"Simple habit \u0026 goal tracker\",\"preflightPackageUrl\":\"https://osxapps.itunes.apple.com/itunes-assets/Purple221/v4/b8/17/1b/b8171ba3-595a-f46a-1434-22b3ea827179/iwd5772022489072930227.pfpkg\",\"customAttributes\":{\"default\":{\"default\":{\"customVideoPreviewsByType\":{},\"customScreenshotsByType\":{\"mac\":[{\"width\":2880,\"height\":1800,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource211/v4/ea/f4/44/eaf4443b-30ce-6629-0260-61527c0aa57d/366161f6-f536-456c-bb2a-670a0c685bac_1mac.png/{w}x{h}{c}.{f}\",\"bgColor\":\"753ab4\",\"textColor1\":\"ffffff\",\"textColor2\":\"fff5ea\",\"textColor3\":\"e3d7f0\",\"textColor4\":\"e3cfdf\"},{\"width\":2880,\"height\":1800,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource221/v4/7a/51/bc/7a51bc73-b481-cd9e-e63c-98718f199e4f/c9ce8e91-7f4f-4435-b642-33aff7d7e9e0_2.png/{w}x{h}{c}.{f}\",\"bgColor\":\"753ab4\",\"textColor1\":\"ffffff\",\"textColor2\":\"e3dbfc\",\"textColor3\":\"e3d7f0\",\"textColor4\":\"cdbbed\"},{\"width\":2880,\"height\":1800,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource211/v4/d7/1f/64/d71f64b9-c211-1e21-124e-e1e783951e7e/1e5af27d-be42-4bff-be8a-3188c5ebf256_3.png/{w}x{h}{c}.{f}\",\"bgColor\":\"753ab4\",\"textColor1\":\"ffffff\",\"textColor2\":\"f1edfd\",\"textColor3\":\"e3d7f0\",\"textColor4\":\"d8c9ef\"},{\"width\":2880,\"height\":1800,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource221/v4/4b/9e/e6/4b9ee6d3-8046-5e6c-5be4-e76130409668/b446d474-c9db-4e50-ae47-d98fb3e5a6e0_4.png/{w}x{h}{c}.{f}\",\"bgColor\":\"ffffff\",\"textColor1\":\"000000\",\"textColor2\":\"30295b\",\"textColor3\":\"333333\",\"textColor4\":\"59547c\"},{\"width\":2880,\"height\":1800,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource211/v4/21/25/18/21251840-c975-fa90-f354-b7ed24a290dc/5d43be69-fe2f-4de9-9574-e7cbc107aeb5_5.png/{w}x{h}{c}.{f}\",\"bgColor\":\"753ab4\",\"textColor1\":\"ffffff\",\"textColor2\":\"38cdfa\",\"textColor3\":\"e3d7f0\",\"textColor4\":\"44b0ec\"},{\"width\":2880,\"height\":1800,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource221/v4/d5/c0/5e/d5c05e48-b59b-ed28-0c97-becc052b1c6f/0532eed8-6939-40c2-83cd-f6ac396df103_6.png/{w}x{h}{c}.{f}\",\"bgColor\":\"753ab4\",\"textColor1\":\"ffffff\",\"textColor2\":\"3ac3fa\",\"textColor3\":\"e3d7f0\",\"textColor4\":\"46a7ec\"},{\"width\":2880,\"height\":1800,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource211/v4/d1/93/56/d1935611-fadc-b2cd-fe8f-55b7337478c6/7e1fc0d4-b226-4465-a636-f80a7e5bbda4_7.png/{w}x{h}{c}.{f}\",\"bgColor\":\"753ab4\",\"textColor1\":\"ffffff\",\"textColor2\":\"e3dafc\",\"textColor3\":\"e3d7f0\",\"textColor4\":\"cdbaed\"}]}}}},\"runsOnIntel\":true},\"ios\":{\"description\":{\"standard\":\"Don't set goals, build habits.\\n\\nDo you remember the last time you wanted to achieve something? You may have started strong, but after some time, maybe you lost motivation. Here is our tip – instead of setting goals, start building your daily routines, and improving your regular habits. Small and easy changes will compound into remarkable results. With our app, you will get better every day and achieve the kind of success that lasts.\\n\\nBuild good habits, break bad ones.\\nWant to cut down on alcohol, improve your healthy habits, or be more productive? Possibilities are unlimited. Get inspiration from our pre-defined templates or add your custom habit.\\n\\nAchieve your daily, weekly, and monthly goals.\\nUsing a simple overview, you can easily manage all your goals and see your achievements. Have you overachieved your goal? You can track that too.\\n\\nTrack your progress.\\nBrowse history, check out your stats and see how you've improved over time.\\nDidn't have time to track a previous day? No problem, you can easily update any record in the past.\\n\\nFeatures:\\n- Build good habits, break bad ones\\n- Daily, weekly, and monthly goals\\n- Track even overachieved goals\\n- Track time-based goals with timers\\n- History and statistics\\n- Habit lists\\n- Habit notes\\n- 2,500+ icons \u0026 emojis\\n- Apple Health support\\n- Reminders, app badge, and Apple Health notifications\\n- Interactive widgets for Home Screen, Lock Screen, and StandBy mode\\n- Interactive Dynamic Island \u0026 Live Activities\\n- Apple Watch complications and the Smart Stack widget\\n- Works on iPhone, iPad, Mac, and Apple Watch\\n- iCloud backup \u0026 sync\\n- Export to a CSV file\\n- Siri Shortcuts\\n- Dark Mode support and appearance customization\\n\\nTerms of Use: https://www.awesome-habits.com/terms-conditions\\nPrivacy Policy: https://www.awesome-habits.com/privacy-policy\"},\"isStandaloneWithCompanionForWatchOS\":false,\"isAppleWatchSupported\":true,\"requiredCapabilitiesForRealityDevice\":\"arm64 \",\"versionHistory\":[{\"versionDisplay\":\"6.2.4\",\"releaseNotes\":\"• Get started tips: We've added a new help section with tips and how-to guides to help new users get started.\\n• Bug fixes and performance improvements\",\"releaseDate\":\"2025-01-21\",\"releaseTimestamp\":\"2025-01-21T15:56:54Z\"},{\"versionDisplay\":\"6.2.2\",\"releaseNotes\":\"Be awesome in 2025\\n• Reset habit history: Need a fresh start? Easily reset your habit history with the button on the history details screen.\\n• More start of day options: Prefer updating your progress the next morning? Set your start of day to any hour between midnight and noon.\\n• Bug fixes and performance improvements\",\"releaseDate\":\"2024-12-29\",\"releaseTimestamp\":\"2024-12-29T23:01:26Z\"},{\"versionDisplay\":\"6.2\",\"releaseNotes\":\"• Personalize your habit icons like never before. With iOS 18.2, you can set custom stickers as habit icons or take advantage of Apple Intelligence (available in supported regions and on compatible devices) to create unique Genmoji icons.\\n\\n• To maintain optimal performance and user experience on iPadOS 18, we have decided to discontinue support for the extra-large widget. We apologize for any inconvenience this may cause and appreciate your understanding.\\n\\n• Bug fixes and performance improvements\",\"releaseDate\":\"2024-12-13\",\"releaseTimestamp\":\"2024-12-13T01:09:42Z\"},{\"versionDisplay\":\"6.1\",\"releaseNotes\":\"• Quick actions menus: Touch and hold a habit to access quick actions like adding a custom value, adding a note, editing, archiving, and more. These quick actions are available throughout the app, including the Home tab, History tab, and calendar view. Available on iOS 17 and later.\\n• Adaptive custom repeat: For habits with a custom repeat (e.g., exercising every 3 days), the next repeats now automatically adjust based on the last completion. This ensures you maintain the intended interval, even if you complete the goal on a different day than planned.\\n• Bug fixes and performance improvements\",\"releaseDate\":\"2024-11-30\",\"releaseTimestamp\":\"2024-11-30T03:39:05Z\"},{\"versionDisplay\":\"6.0.6\",\"releaseNotes\":\"• Bug fixes and performance improvements\",\"releaseDate\":\"2024-10-22\",\"releaseTimestamp\":\"2024-10-22T18:19:21Z\"},{\"versionDisplay\":\"6.0.4\",\"releaseNotes\":\"New in this version:\\n• Bug fixes and performance improvements\\n\\nCheck out all the features in our recent major update for iOS 18:\\n• Mood tracking: Track your mental wellbeing by logging your daily mood and syncing with Apple Health. Available on iOS 18.\\n• Control Center actions: Add controls to the Control Center or the bottom of your Lock Screen to quickly open a habit, start a timer, or show a habit list. Available on iOS 18.\\n• New tab bar on iPad: We've added support for the new, compact tab bar, now positioned above the app's content. Available on iPadOS 18.\\n• Tinted effect support: We've optimized widgets to look great with the new Home Screen tinted effect. Available on iOS 18.\\n• Live Activity mirroring: Start a habit timer on your iPhone, and it will automatically appear in the Smart Stack on your Apple Watch. Available on watchOS 11.\\n• Double tap gesture: Quickly complete a habit or start/stop a timer by tapping your index finger and thumb together twice. Available on Apple Watch Series 9 with watchOS 11.\",\"releaseDate\":\"2024-09-24\",\"releaseTimestamp\":\"2024-09-24T20:18:36Z\"},{\"versionDisplay\":\"6.0.2\",\"releaseNotes\":\"New in this version:\\n• Add controls to the Control Center or the bottom of your Lock Screen to quickly open a habit, start a timer, or show a habit list. Available on iOS 18.\\n\\nCheck out all the features in our previous major update for iOS 18:\\n• Mood tracking: Track your mental wellbeing by logging your daily mood and syncing with Apple Health. Available on iOS 18.\\n• New tab bar on iPad: We've added support for the new, compact tab bar, now positioned above the app's content. Available on iPadOS 18.\\n• Tinted effect support: We've optimized widgets to look great with the new Home Screen tinted effect. Available on iOS 18.\\n• Live Activity mirroring: Start a habit timer on your iPhone, and it will automatically appear in the Smart Stack on your Apple Watch. Available on watchOS 11.\\n• Double tap gesture: Quickly complete a habit or start/stop a timer by tapping your index finger and thumb together twice. Available on Apple Watch Series 9 with watchOS 11.\",\"releaseDate\":\"2024-09-18\",\"releaseTimestamp\":\"2024-09-18T19:12:41Z\"},{\"versionDisplay\":\"6.0\",\"releaseNotes\":\"• Mood tracking: Track your mental wellbeing by logging your daily mood and syncing with Apple Health. Available on iOS 18.\\n• New tab bar on iPad: We've added support for the new, compact tab bar, now positioned above the app's content. Available on iPadOS 18.\\n• Tinted effect support: We've optimized widgets to look great with the new Home Screen tinted effect. Available on iOS 18.\\n• Live Activity mirroring: Start a habit timer on your iPhone, and it will automatically appear in the Smart Stack on your Apple Watch. Available on watchOS 11.\\n• Double tap gesture: Quickly complete a habit or start/stop a timer by tapping your index finger and thumb together twice. Available on Apple Watch Series 9 with watchOS 11.\",\"releaseDate\":\"2024-09-15\",\"releaseTimestamp\":\"2024-09-15T20:29:19Z\"},{\"versionDisplay\":\"5.5.2\",\"releaseNotes\":\"• Bug fixes and performance improvements\",\"releaseDate\":\"2024-07-11\",\"releaseTimestamp\":\"2024-07-11T06:59:51Z\"},{\"versionDisplay\":\"5.5\",\"releaseNotes\":\"• Heat maps: Get a comprehensive view of your daily habits with a 365-day heat map.\\n• Calendar view: Browse your habit history conveniently using a calendar view.\\n• Start of day: Choose your preferred start of the day to update your progress conveniently even late at night.\\n• Time Sensitive Notifications: Receive reminders on time, even in Focus Mode. Customize this feature in the system settings.\\n• Bug fixes and performance improvements\",\"releaseDate\":\"2024-07-04\",\"releaseTimestamp\":\"2024-07-04T07:24:00Z\"},{\"versionDisplay\":\"5.3.3\",\"releaseNotes\":\"• Bug fixes and performance improvements\",\"releaseDate\":\"2024-06-02\",\"releaseTimestamp\":\"2024-06-02T16:05:42Z\"},{\"versionDisplay\":\"5.3\",\"releaseNotes\":\"• Customize sounds: Choose from 25 sounds for reminders and completed habits to personalize your experience and celebrate your achievements.\\n• Bug fixes and performance improvements\",\"releaseDate\":\"2024-04-30\",\"releaseTimestamp\":\"2024-04-30T08:39:09Z\"},{\"versionDisplay\":\"5.2.3\",\"releaseNotes\":\"• Habit notes timeline: View all your habit notes on a single timeline. Tap the clock icon on the habit card and switch to the Notes tab.\\n• End date for archived habits: Stopped tracking a habit but forgot to archive it? Now, you can set an end date for your archived habits.\\n• Bug fixes and performance improvements\",\"releaseDate\":\"2024-03-04\",\"releaseTimestamp\":\"2024-03-04T06:50:25Z\"},{\"versionDisplay\":\"5.2.2\",\"releaseNotes\":\"Bug fixes and performance improvements\",\"releaseDate\":\"2024-02-05\",\"releaseTimestamp\":\"2024-02-05T09:30:59Z\"},{\"versionDisplay\":\"5.2.1\",\"releaseNotes\":\"Bug fixes and performance improvements\",\"releaseDate\":\"2024-02-01\",\"releaseTimestamp\":\"2024-02-01T00:52:28Z\"},{\"versionDisplay\":\"5.2\",\"releaseNotes\":\"Happy Holidays!\\n\\n• Vacation mode: Need a break before new year’s challenges? Try our new Vacation mode. It lets you pause your habits while keeping your streaks intact.\\n• Bug fixes and performance improvements\",\"releaseDate\":\"2023-12-25\",\"releaseTimestamp\":\"2023-12-25T14:30:18Z\"},{\"versionDisplay\":\"5.1.1\",\"releaseNotes\":\"• Bug fixes and performance improvements\",\"releaseDate\":\"2023-11-13\",\"releaseTimestamp\":\"2023-11-13T21:03:03Z\"},{\"versionDisplay\":\"5.1\",\"releaseNotes\":\"• Add custom progress: For habits with larger goals, you can now quickly add a custom progress value directly from the habit card.\\n• Last change date: Not sure when you last updated your progress? Swipe a habit card up to check the date of your last change.\\n• New Apple Health metrics: Track the time you spend in daylight to improve your physical and mental well-being (requires an Apple Watch with watchOS 10). Also, you can now track Flexibility and Mind \u0026 body workouts.\",\"releaseDate\":\"2023-10-25\",\"releaseTimestamp\":\"2023-10-25T14:58:05Z\"},{\"versionDisplay\":\"5.0\",\"releaseNotes\":\"• Interactive widgets: Update your progress with a single tap, directly from the widgets. Available with iOS 17.\\n• Interactive Dynamic Island \u0026 Live Activities: Pause or stop habit timers directly from the Dynamic Island or from the iPhone and iPad Lock Screen. Available with iOS 17.\\n• New places for widgets: Add widgets in StandBy mode, to iPad Lock Screen, and Smart Stack on Apple Watch. Available with iOS 17 and watchOS 10.\\n• Improved shortcuts: You can now run multi-step shortcuts without opening the app. Simply turn off “Open When Run” option in Shortcuts app editor.\\n\",\"releaseDate\":\"2023-09-21\",\"releaseTimestamp\":\"2023-09-21T18:33:35Z\"},{\"versionDisplay\":\"4.8\",\"releaseNotes\":\"• Interactive charts: Swipe through the charts to browse your history. Touch and hold to view details.\\n• Weekly averages: Switch to the weekly tab in the charts to compare your results on a weekly basis.\\n• New emojis: Personalize your habits with the latest emojis. \\n• Bug fixes and performance improvements\",\"releaseDate\":\"2023-07-10\",\"releaseTimestamp\":\"2023-07-10T12:07:22Z\"},{\"versionDisplay\":\"4.7.2\",\"releaseNotes\":\"Bug fixes and performance improvements\",\"releaseDate\":\"2023-05-16\",\"releaseTimestamp\":\"2023-05-16T15:19:21Z\"},{\"versionDisplay\":\"4.7.1\",\"releaseNotes\":\"Bug fixes and performance improvements\",\"releaseDate\":\"2023-05-01\",\"releaseTimestamp\":\"2023-05-01T08:42:44Z\"},{\"versionDisplay\":\"4.7\",\"releaseNotes\":\"• Group skipped and completed: Now you can easily group skipped or completed habits. Turn this option on in Settings \u003e General \u003e Sorting \u0026 Grouping.\\n• Custom repeat: Set custom repeats for your habits. E.g. exercise every 3 days.\\n• New Apple Health metrics: Track your Stand minutes and Traditional strength training.\",\"releaseDate\":\"2023-04-22\",\"releaseTimestamp\":\"2023-04-22T08:22:03Z\"},{\"versionDisplay\":\"4.6.1\",\"releaseNotes\":\"Bug fixes and performance improvements\",\"releaseDate\":\"2023-04-13\",\"releaseTimestamp\":\"2023-04-13T13:37:44Z\"},{\"versionDisplay\":\"4.6\",\"releaseNotes\":\"• Data export: Now you can easily export your data to a CSV file and dive deeper into your results.\\n• New emojis: Personalize your habits with the latest emojis.\",\"releaseDate\":\"2023-02-10\",\"releaseTimestamp\":\"2023-02-10T06:58:22Z\"}],\"websiteUrl\":\"https://www.awesome-habits.com\",\"isXROSCompatible\":true,\"minimumXROSVersion\":\"1.0\",\"hasSafariExtension\":false,\"messagesScreenshots\":{},\"requiresGameController\":false,\"offers\":[{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=1514915737\u0026pricingParameters=STDQ\u0026pg=default\u0026appExtVrsId=871892945\",\"type\":\"get\",\"priceFormatted\":\"$0.00\",\"price\":0,\"currencyCode\":\"USD\",\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":28357632}]},{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=1514915737\u0026pricingParameters=SWUPD\u0026pg=default\u0026appExtVrsId=871892945\",\"type\":\"update\",\"priceFormatted\":\"$0.00\",\"price\":0,\"currencyCode\":\"USD\",\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":28357632}]}],\"requires32bit\":false,\"releaseDate\":\"2020-06-23\",\"hasInAppPurchases\":true,\"bundleId\":\"com.dreamer.Habits\",\"hasMessagesExtension\":false,\"artwork\":{\"width\":1024,\"height\":1024,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/Purple221/v4/b5/aa/99/b5aa99ff-e448-2e95-9ede-db2cb97ed703/AppIcon-0-0-1x_U007epad-0-1-0-85-220.png/{w}x{h}{c}.{f}\",\"bgColor\":\"ffffff\",\"textColor1\":\"2a2869\",\"textColor2\":\"1d2c6c\",\"textColor3\":\"555387\",\"textColor4\":\"4a5689\"},\"privacyPolicyUrl\":\"https://www.awesome-habits.com/app-privacy-policy\",\"videoPreviewsByType\":{\"iphone_6_5\":[{\"previewFrame\":{\"width\":886,\"height\":1920,\"url\":\"https://is1-ssl.mzstatic.com/image/thumb/PurpleVideo116/v4/82/65/a4/8265a4e1-a28b-6645-ca13-fd5025ec31a4/Job972a9758-bc83-4c22-aef8-cc5005a59a75-156014816-PreviewImage_preview_image_nonvideo_sdr-Time1695310929262.png/{w}x{h}{c}.{f}\",\"bgColor\":\"93a5ff\",\"textColor1\":\"000000\",\"textColor2\":\"002108\",\"textColor3\":\"1d2133\",\"textColor4\":\"1e3c39\"},\"video\":\"https://apptrailers.itunes.apple.com/itunes-assets/PurpleVideo126/v4/cf/42/be/cf42be46-667b-5c54-d43d-051d26384ad5/P625769796_defaul