303/genres?l=en-US\",\"data\":[{\"id\":\"6007\",\"type\":\"genres\",\"href\":\"/v1/catalog/us/genres/6007?l=en-US\",\"attributes\":{\"parentName\":\"App Store\",\"name\":\"Productivity\",\"parentId\":\"36\",\"url\":\"https://itunes.apple.com/us/genre/id6007\"}},{\"id\":\"6002\",\"type\":\"genres\",\"href\":\"/v1/catalog/us/genres/6002?l=en-US\",\"attributes\":{\"parentName\":\"App Store\",\"name\":\"Utilities\",\"url\":\"https://itunes.apple.com/us/genre/id6002\",\"parentId\":\"36\"}}]}},\"meta\":{\"contentVersion\":{\"RTCI\":1741118251832,\"MZ_INDEXER\":1741118548241}}},{\"id\":\"6504743503\",\"type\":\"apps\",\"href\":\"/v1/catalog/us/apps/6504743503?l=en-US\",\"attributes\":{\"distributionKind\":\"APP_STORE\",\"supportsArcade\":false,\"isFirstPartyHideableApp\":false,\"privacy\":{\"privacyTypes\":[{\"privacyType\":\"Data Not Linked to You\",\"identifier\":\"DATA_NOT_LINKED_TO_YOU\",\"description\":\"The following data may be collected but it is not linked to your identity:\",\"dataCategories\":[{\"dataCategory\":\"Purchases\",\"identifier\":\"PURCHASES\"},{\"dataCategory\":\"Usage Data\",\"identifier\":\"USAGE_DATA\"},{\"dataCategory\":\"Diagnostics\",\"identifier\":\"DIAGNOSTICS\"}]}]},\"contentRatingsBySystem\":{\"appsApple\":{\"name\":\"4+\",\"value\":100,\"rank\":1}},\"deviceFamilies\":[\"iphone\"],\"supportsStreamlinedBuy\":true,\"url\":\"https://apps.apple.com/us/app/dumb-phone-dp/id6504743503\",\"userRating\":{\"value\":4.5,\"ratingCount\":592,\"ratingCountList\":[41,10,19,41,481],\"ariaLabelForRatings\":\"4.5 stars\"},\"firstVersionSupportingInAppPurchaseApi\":\"1.0\",\"genreDisplayName\":\"Productivity\",\"name\":\"Dumb Phone (dp)\",\"isPreorder\":false,\"artistName\":\"Michael Tigas\",\"reviewsRestricted\":false,\"isIOSBinaryMacOSCompatible\":false,\"requirementsByDeviceFamily\":{\"iphone\":{\"deviceFamily\":\"iPhone\",\"requirementString\":\"Requires iOS 16.1 or later.\"}},\"platformAttributes\":{\"ios\":{\"minimumMacOSVersion\":\"13.0\",\"description\":{\"standard\":\"Turn your iPhone into a Dumb Phone.\\n\\nDumb Phone lets you create your very own minimalist-style phone on iOS.\\n\\nReplace colorful app icons, pesky notification badges, and anything that might give you a dopamine hit when you unlock your phone, with simple buttons to open your essential apps, and nothing more.\\n\\nKey features:\\n\\n• Break out of your existing habits\\nEvery time you unlock your phone, all you will see is apps that you need, without being coerced into easy distractions from colourful apps on your Home Screen, or from the App Library.\\n\\n• Create a Minimalist Launcher\\nSelect apps and add Dumb Phone widgets to your Home Screen to blend everything together.\\n\\n• Choose your essential apps\\nSelect apps that you frequently use, so they are a single tap away.\\n\\n• Style your Home Screen\\nChoose from a Dark or Light minimalist style, by adjusting your wallpaper, background, text, and more, with themes.\\n\\n• Create multiple app launchers\\nCreate launchers for leisure, work, night time, so you see the most important apps in context to your day.\\n\\n• Detox Mode\\nCreate an immersive dumb phone experience by choosing which non-essential apps to block and/or hide on your device, with the powerful capabilities of Screen Time.\\n\\n• Control Center widgets \\nQuickly switch between app launchers from the Control Center with new control center widgets that instantly change your Home Screen.\\n\\nDownload the Dumb Phone app today and embrace the full benefits of minimalism, and turn your iPhone into a powerful utility once more.\\n\\nVisit the Dumb Phone app website for more info:\\nhttps://dumbphone.so/\\n\\nView our Privacy \u0026 Terms at:\\nhttps://dumbphone.so/privacy\\nhttps://dumbphone.so/terms\"},\"isStandaloneWithCompanionForWatchOS\":false,\"isAppleWatchSupported\":false,\"requiredCapabilitiesForRealityDevice\":\"arm64 \",\"versionHistory\":[{\"versionDisplay\":\"1.4.0\",\"releaseNotes\":\"Thank you for supporting Dumb Phone, and we wish you the best with being more mindful when using our phones each day!\\n\\nThis update fixes a couple of minor UI bugs, includes more apps to select from, and improves the flexibility of displaying specific app launchers.\\n\\nPlease consider leaving a kind review if you have found Dumb Phone super helpful each day. :)\",\"releaseDate\":\"2025-02-25\",\"releaseTimestamp\":\"2025-02-25T23:59:05Z\"},{\"versionDisplay\":\"1.3.7\",\"releaseNotes\":\"Thank you for supporting Dumb Phone, and we wish you the best with being more mindful when using our phones each day!\\n\\nThis update fixes a couple of minor UI bugs, improves the instructions based on your awesome feedback, and includes more apps to select from.\\n\\nPlease consider leaving a kind review if you have found Dumb Phone super helpful each day. :)\",\"releaseDate\":\"2025-02-17\",\"releaseTimestamp\":\"2025-02-17T13:32:03Z\"},{\"versionDisplay\":\"1.3.6\",\"releaseNotes\":\"Thank you for supporting Dumb Phone, and we wish you the best with being more mindful when using our phones each day!\\n\\nThis update fixes a couple of minor UI bugs and also a few apps have been renamed.\\n\\nPlease consider leaving a kind review if you have found Dumb Phone super helpful each day. :)\",\"releaseDate\":\"2025-02-13\",\"releaseTimestamp\":\"2025-02-13T01:43:03Z\"},{\"versionDisplay\":\"1.3.5\",\"releaseNotes\":\"Thank you for supporting Dumb Phone, and we wish you the best with being more mindful when using our phones each day.\\n\\nThis update fixes a couple minor UI bugs and app names.\\n\\nEnjoy, and please consider leaving a kind review if you find Dumb Phone super helpful. :)\",\"releaseDate\":\"2025-02-11\",\"releaseTimestamp\":\"2025-02-11T04:07:29Z\"},{\"versionDisplay\":\"1.3.4\",\"releaseNotes\":\"Thank you for supporting Dumb Phone, and we wish you the best with being more mindful when using our phones each day.\\n\\nThis update fixes a couple minor UI bugs and app names.\\n\\nEnjoy, and please consider leaving a kind review if you find Dumb Phone super helpful. :)\",\"releaseDate\":\"2025-02-10\",\"releaseTimestamp\":\"2025-02-10T13:24:55Z\"},{\"versionDisplay\":\"1.3.3\",\"releaseNotes\":\"Happy New Year for 2025! \\n\\nThank you for supporting Dumb Phone across 2024, and we wish you a great year ahead for making better decisions with using our phones.\\n\\nThis update fixes the Next App Launcher control widget icon not appearing, lets you turn on Detox Mode via Shortcuts, adds a Detox Mode control center widget, lets you link App Launchers and adjust Detox Mode to Focus modes with Focus Filter support, lets you add spacers between apps, and adds support for more apps.\\n\\nEnjoy, and please consider leaving a kind review if you find Dumb Phone super helpful. :)\\n\",\"releaseDate\":\"2025-02-06\",\"releaseTimestamp\":\"2025-02-06T06:37:02Z\"},{\"versionDisplay\":\"1.3.2\",\"releaseNotes\":\"Happy New Year for 2025! \\n\\nThank you for supporting Dumb Phone across 2024, and we wish you a great year ahead for making better decisions with using our phones.\\n\\nThis update fixes the Next App Launcher control widget icon not appearing, lets you turn on Detox Mode via Shortcuts, adds a Detox Mode control center widget, lets you link App Launchers and adjust Detox Mode to Focus modes with Focus Filter support, lets you add spacers between apps, and adds support for more apps.\\n\\nEnjoy, and please consider leaving a kind review if you find Dumb Phone super helpful. :)\\n\",\"releaseDate\":\"2025-01-14\",\"releaseTimestamp\":\"2025-01-14T14:19:23Z\"},{\"versionDisplay\":\"1.3.1\",\"releaseNotes\":\"Happy New Year for 2025! \\n\\nThank you for supporting Dumb Phone across 2024, and we wish you a great year ahead for making better decisions with using our phones.\\n\\nThis update fixes the Next App Launcher control widget icon not appearing, lets you turn on Detox Mode via Shortcuts, adds a Detox Mode control center widget, lets you link App Launchers and adjust Detox Mode to Focus modes with Focus Filter support, lets you add spacers between apps, and adds support for more apps.\\n\\nEnjoy, and please consider leaving a kind review if you find Dumb Phone super helpful. :)\",\"releaseDate\":\"2025-01-12\",\"releaseTimestamp\":\"2025-01-12T11:34:41Z\"},{\"versionDisplay\":\"1.3\",\"releaseNotes\":\"Happy New Year for 2025! \\n\\nThank you for supporting Dumb Phone across 2024, and we wish you a great year ahead for making better decisions with using our phones.\\n\\nThis update fixes the Next App Launcher control widget icon not appearing, lets you turn on Detox Mode via Shortcuts, adds a Detox Mode control center widget, lets you link App Launchers and adjust Detox Mode to Focus modes with Focus Filter support, lets you add spacers between apps, and adds support for more apps.\\n\\nEnjoy, and please consider leaving a kind review if you find Dumb Phone super helpful. :)\",\"releaseDate\":\"2025-01-09\",\"releaseTimestamp\":\"2025-01-09T03:40:35Z\"},{\"versionDisplay\":\"1.2.9\",\"releaseNotes\":\"Happy New Year for 2025! \\n\\nThank you for supporting Dumb Phone across 2024, and we wish you a great year ahead for making better decisions with using our phones.\\n\\nThis update fixes a few bugs related to specific apps not working, makes it easier to turn on Detox Mode, add more apps, and to reach out to us if you have a question.\\n\\nEnjoy, and please consider leaving a kind review if you find Dumb Phone super helpful. :)\",\"releaseDate\":\"2025-01-07\",\"releaseTimestamp\":\"2025-01-07T06:43:32Z\"},{\"versionDisplay\":\"1.2.8\",\"releaseNotes\":\"Happy New Year for 2025! \\n\\nThank you for supporting Dumb Phone across 2024, and we wish you a great year ahead for making better decisions with using our phones.\\n\\nThis update fixes a few bugs related to specific apps not working, and makes it easier to reach out if you have a question.\\n\\nEnjoy, and please consider leaving a kind review if you find Dumb Phone super helpful. :)\",\"releaseDate\":\"2025-01-04\",\"releaseTimestamp\":\"2025-01-04T02:56:48Z\"},{\"versionDisplay\":\"1.2.7\",\"releaseNotes\":\"Thank you for using Dumb Phone during 2024!\\n\\nThis update improves theming support, fixes an issue with launching apps through Dumb Phone, and adds more selectable apps to the Add Apps screen.\\n\\nPlease leave a kind review if you've found Dumb Phone super helpful. :-)\",\"releaseDate\":\"2024-12-24\",\"releaseTimestamp\":\"2024-12-24T06:39:57Z\"},{\"versionDisplay\":\"1.2.6\",\"releaseNotes\":\"Thank you for using Dumb Phone!\\n\\nThis update fixes an issue when preferring to launch apps through Dumb Phone, and adds more apps.\\n\\nPlease leave a kind review if you find them super helpful. :-)\",\"releaseDate\":\"2024-12-15\",\"releaseTimestamp\":\"2024-12-15T13:22:52Z\"},{\"versionDisplay\":\"1.2.5\",\"releaseNotes\":\"Thank you for using Dumb Phone!\\n\\nThis update fixes an issue when preferring to launch apps through Dumb Phone, and adds more apps.\\n\\nPlease leave a kind review if you find them super helpful. :-)\",\"releaseDate\":\"2024-12-03\",\"releaseTimestamp\":\"2024-12-03T02:45:07Z\"},{\"versionDisplay\":\"1.2.4\",\"releaseNotes\":\"Thank you for using Dumb Phone!\\n\\nThis update adds support for the latest version of iOS and iPadOS!\\n\\nIt also adds more apps, backgrounds, styles, and a new Detox Mode.\\n\\nAlso fixed are some cases where widgets might not immediately update after adjusting their style or adding apps. \\n\\nThere's also flickering issue when launching apps with Light Mode that has now been patched up, and WhatsApp showing a link popup when opened.\\n\\nPlease consider leaving a kind review for Dumb Phone if you find them super helpful.\\n\\nAppreciate it!\",\"releaseDate\":\"2024-11-26\",\"releaseTimestamp\":\"2024-11-26T03:13:18Z\"},{\"versionDisplay\":\"1.2.3\",\"releaseNotes\":\"Thank you for using Dumb Phone!\\n\\nThis update adds support for the latest version of iOS and iPadOS!\\n\\nIt also adds more apps, backgrounds, styles, and a new Detox Mode.\\n\\nAlso fixed are some cases where widgets might not immediately update after adjusting their style or adding apps. \\n\\nThere's also flickering issue when launching apps with Light Mode that has now been patched up, and WhatsApp showing a link popup when opened.\\n\\nPlease consider leaving a kind review for Dumb Phone if you find them super helpful.\\n\\nAppreciate it!\",\"releaseDate\":\"2024-11-19\",\"releaseTimestamp\":\"2024-11-19T00:50:53Z\"},{\"versionDisplay\":\"1.2.2\",\"releaseNotes\":\"Thank you for using Dumb Phone!\\n\\nThis update adds support for the latest version of iOS and iPadOS!\\n\\nIt also adds more apps, backgrounds, styles, and a new Detox Mode.\\n\\nAlso fixed are some cases where widgets might not immediately update after adjusting their style or adding apps. \\n\\nThere's also flickering issue when launching apps with Light Mode that has now been patched up.\\n\\nPlease consider leaving a kind review for Dumb Phone if you find them super helpful.\\n\\nAppreciate it!\",\"releaseDate\":\"2024-11-18\",\"releaseTimestamp\":\"2024-11-18T00:34:52Z\"},{\"versionDisplay\":\"1.1.1\",\"releaseNotes\":\"Thank you for using Dumb Phone in 2024!\\n\\nThis update adds support for the latest version of iOS, including new features such as dynamic app icons and Control Center widgets, so you can easily \u0026 quickly change App Launchers to adjust your Home Screen in a snap. \\n\\nWe've also added lots of selectable new apps to the list, and have fixed an issue that prevented first-time users from launching Dumb Phone.\\n\\nWe hope you find them super helpful. Please leave a kind review if you do! :)\",\"releaseDate\":\"2024-09-23\",\"releaseTimestamp\":\"2024-09-23T12:09:26Z\"},{\"versionDisplay\":\"1.1\",\"releaseNotes\":\"Thank you for using Dumb Phone in 2024!\\n\\nThis update adds support for the latest version of iOS, including new features such as dynamic app icons and Control Center widgets, so you can easily \u0026 quickly change App Launchers to adjust your Home Screen in a snap. \\n\\nWe've also added lots of selectable new apps to the list, and have fixed the issue that caused the No Matching App alert to annoyingly linger around.\\n\\nWe hope you find them super helpful. Please leave a kind review if you do! :)\",\"releaseDate\":\"2024-09-12\",\"releaseTimestamp\":\"2024-09-12T03:07:06Z\"},{\"versionDisplay\":\"1.0.7\",\"releaseNotes\":\"Thank you for using Dumb Phone! \\n\\nThis update includes minor bug fixes.\",\"releaseDate\":\"2024-08-30\",\"releaseTimestamp\":\"2024-08-30T13:20:40Z\"},{\"versionDisplay\":\"1.0.6\",\"releaseNotes\":\"Thank you for using Dumb Phone! \\n\\nWe've truly appreciated all the love and support that's come our way this past week, and people sharing their new home screens with us. They all look beautifully minimal!\\n\\nThis update contains minor bug fixes, including;\\n- Fixes an issue launching Telegram, Proton Mail, and Podcasts\\n- Fixes an issue that caused the upgrade screen to unnecessarily appear\\n- Fixes an issue where the preview list of apps didn't correctly align app titles depending on their horizontal placement\\n- Adds a new dedicated screen for renaming apps\\n- Adds 15 new apps including Claude, Beeper, Komoot, Bear, Endel, OneNote, Flow, and MyFitnessPal to the list of selectable apps (keep em coming!)\",\"releaseDate\":\"2024-08-10\",\"releaseTimestamp\":\"2024-08-10T06:29:54Z\"},{\"versionDisplay\":\"1.0.5\",\"releaseNotes\":\"Thank you for using Dumb Phone! \\n\\nWe've truly appreciated all the love and support that's come our way this past week, and people sharing their new home screens with us. They all look beautifully minimal!\\n\\nThis update contains minor bug fixes including;\\n- Fixing an issue launching Gmail\\n- Adds Apple Sports to the list of apps\",\"releaseDate\":\"2024-08-09\",\"releaseTimestamp\":\"2024-08-09T08:08:26Z\"},{\"versionDisplay\":\"1.0.4\",\"releaseNotes\":\"Thank you for using Dumb Phone! \\n\\nWe've truly appreciated all the love and support that's come our way this past week, and people sharing their new home screens with us. They all look beautifully minimal!\\n\\nThis update contains minor bug fixes including;\\n- Fixing an issue where the dim overlay doesn't always appear when launching apps\\n- Added 7 new apps; Chorsee, Copy Me That, ESV Bible, Hoopla, LibriVox, Timers, and Yoto (thanks for sending these in)\\n\",\"releaseDate\":\"2024-08-07\",\"releaseTimestamp\":\"2024-08-07T07:47:07Z\"},{\"versionDisplay\":\"1.0.3\",\"releaseNotes\":\"Thank you for using Dumb Phone! \\n\\nWe've truly appreciated all the love and support that's come our way this past week, and people sharing their new home screens with us. They all look beautifully minimal!\\n\\nThis update contains minor bug fixes including;\\n- Fixing an issue where adjusting a launcher's font after changing the text size would revert the text size (sorry!)\\n- Fixed an issue launching the Fantastical app\\n- Added CardPointers, Journal, Weather, StepUp, Swifty Compiler, and Mela apps (appreciate people sending these in)\",\"releaseDate\":\"2024-08-05\",\"releaseTimestamp\":\"2024-08-05T02:29:22Z\"},{\"versionDisplay\":\"1.0.2\",\"releaseNotes\":\"Thank you for using Dumb Phone!\\n\\nThis update includes minor bug fixes, such as;\\n- widgets not appearing on earlier versions of iOS\\n- a crash when opening the set up guide\\n- and improved set up instructions\\n\\nEnjoy!\",\"releaseDate\":\"2024-07-24\",\"releaseTimestamp\":\"2024-07-24T14:24:34Z\"}],\"isXROSCompatible\":false,\"minimumXROSVersion\":\"1.0\",\"hasSafariExtension\":false,\"messagesScreenshots\":{},\"requiresGameController\":false,\"offers\":[{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=6504743503\u0026pricingParameters=STDQ\u0026pg=default\u0026appExtVrsId=872770187\",\"type\":\"get\",\"priceFormatted\":\"$0.00\",\"price\":0,\"currencyCode\":\"USD\",\"assets\":[{\"flavor\":\