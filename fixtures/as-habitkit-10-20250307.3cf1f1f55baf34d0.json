,\"iPad14,4-A\":41395200,\"iPhone9,4\":51240960,\"iPad8,11\":41815040,\"universal\":52559872,\"iPad6,4\":51113984,\"iPad7,5\":51118080,\"iPhone6,2\":51113984,\"iPad13,19\":41391104,\"iPhone10,5\":51240960,\"iPhone9,1\":51113984,\"iPhone14,6\":41391104,\"iPhone11,2\":51195904,\"iPad8,8\":51101696,\"iPad7,3\":51113984,\"iPhone14,3\":41485312,\"iPhone14,7\":41485312,\"iPad13,11\":41815040,\"iPhone15,2\":41485312,\"iPad6,12\":51118080,\"iPad14,2\":41395200,\"iPad8,1\":51101696,\"iPad14,5-B\":41395200,\"iPad4,7\":51118080,\"MacFamily20,1\":41815040,\"iPad13,7\":41815040,\"iPhone13,4\":41905152,\"iPhone12,5\":41905152,\"iPhone7,2\":51113984,\"iPhone8,4\":51113984,\"iPad14,5-A\":41395200,\"iPhone15,5\":41485312,\"iPhone10,1\":51113984,\"iPad4,1\":51118080,\"iPhone7,1\":51240960,\"iPad11,1\":42792960,\"iPad14,6-B\":41395200,\"iPad13,4\":41815040,\"iPad8,4\":51101696,\"iPad13,6\":41815040}},\"relationships\":{\"developer\":{\"href\":\"/v1/catalog/us/apps/6448476249/developer?l=en-US\",\"data\":[{\"id\":\"1602956482\",\"type\":\"developers\",\"href\":\"/v1/catalog/us/developers/1602956482?l=en-US\",\"attributes\":{\"genreNames\":[],\"editorialArtwork\":{},\"name\":\"Sebastian Roehl\",\"mediaType\":\"Mobile Software Applications\",\"url\":\"https://apps.apple.com/us/developer/sebastian-roehl/id1602956482\"}}]},\"genres\":{\"href\":\"/v1/catalog/us/apps/6448476249/genres?l=en-US\",\"data\":[{\"id\":\"6013\",\"type\":\"genres\",\"href\":\"/v1/catalog/us/genres/6013?l=en-US\",\"attributes\":{\"parentName\":\"App Store\",\"name\":\"Health \u0026 Fitness\",\"parentId\":\"36\",\"url\":\"https://itunes.apple.com/us/genre/id6013\"}},{\"id\":\"6012\",\"type\":\"genres\",\"href\":\"/v1/catalog/us/genres/6012?l=en-US\",\"attributes\":{\"parentName\":\"App Store\",\"name\":\"Lifestyle\",\"parentId\":\"36\",\"url\":\"https://itunes.apple.com/us/genre/id6012\"}}]}},\"meta\":{\"contentVersion\":{\"MZ_INDEXER\":1739931742295,\"RTCI\":1731361098059}}}]},\"related-editorial-items\":{\"href\":\"/v1/catalog/us/apps/6443918070/related-editorial-items?l=en-US\",\"data\":[]},\"customers-also-bought-apps\":{\"href\":\"/v1/catalog/us/apps/6443918070/customers-also-bought-apps?l=en-US\",\"next\":\"/v1/catalog/us/apps/6443918070/customers-also-bought-apps?l=en-US\u0026offset=10\",\"data\":[{\"id\":\"1403517519\",\"type\":\"apps\",\"href\":\"/v1/catalog/us/apps/1403517519?l=en-US\",\"attributes\":{\"distributionKind\":\"APP_STORE\",\"supportsArcade\":false,\"isFirstPartyHideableApp\":false,\"privacy\":{\"privacyTypes\":[{\"privacyType\":\"Data Not Linked to You\",\"identifier\":\"DATA_NOT_LINKED_TO_YOU\",\"description\":\"The following data may be collected but it is not linked to your identity:\",\"dataCategories\":[{\"dataCategory\":\"Identifiers\",\"identifier\":\"IDENTIFIERS\"},{\"dataCategory\":\"Usage Data\",\"identifier\":\"USAGE_DATA\"},{\"dataCategory\":\"Diagnostics\",\"identifier\":\"DIAGNOSTICS\"}]}]},\"contentRatingsBySystem\":{\"appsApple\":{\"name\":\"4+\",\"value\":100,\"rank\":1}},\"deviceFamilies\":[\"iphone\",\"ipod\"],\"supportsStreamlinedBuy\":true,\"url\":\"https://apps.apple.com/us/app/habit-tracker-goals-evoday/id1403517519\",\"userRating\":{\"value\":4.8,\"ratingCount\":1177,\"ratingCountList\":[25,9,29,85,1029],\"ariaLabelForRatings\":\"4.8 stars\"},\"firstVersionSupportingInAppPurchaseApi\":\"1.0\",\"genreDisplayName\":\"Productivity\",\"name\":\"Habit Tracker \u0026 Goals | Evoday\",\"isPreorder\":false,\"artistName\":\"Cosmic Taps SL\",\"reviewsRestricted\":false,\"isIOSBinaryMacOSCompatible\":false,\"requirementsByDeviceFamily\":{\"iphone\":{\"deviceFamily\":\"iPhone\",\"requirementString\":\"Requires iOS 14.0 or later.\"},\"ipod\":{\"deviceFamily\":\"iPod touch\",\"requirementString\":\"Requires iOS 14.0 or later.\"},\"realityDevice\":{\"deviceFamily\":\"Apple Vision\",\"requirementString\":\"Requires visionOS 1.0 or later.\"}},\"platformAttributes\":{\"ios\":{\"minimumMacOSVersion\":\"11.0\",\"description\":{\"standard\":\"Get your habit tracker app, with home screen widgets, to help you focus and motivate yourself to achieve your goals. Track your progress with the calendar grids!\\n\\nTake control of your habits and reach your goals! Join 80K+ users building their dream lives. Track your habits daily and display your progress on yearly calendars and grids. Evoday will give you the motivation you need to become a better you.\\n\\nEvoday helps you to build healthy habits, whether they are daily or weekly habits. To help you improve your life and keep you motivated, the app displays your progress on beautifully designed monthly and yearly calendars, either as grids or complete calendars (showing the months of the year). You’ll also be able to see a bunch of cool statistics for each habit, such as your current and longest streak and your yearly and all-time completion rates.\\n\\nAny great new skill requires at least a few months of practice before you begin to see solid results: learning an instrument, getting back into shape, taking up a new language, etc. Focus on doing a little bit every day, log it in the app, and within a few months you’ll start to see incredible progress.\\n\\nBuild good habits, break bad habits, and achieve greatness!\\n\\n• Practice Better\\nEvoday encourages you to practice better with its progress tracking feature. Giving up on your dreams will be harder to do when you see how long your current streaks are, and how much  practice you’ve put in so far. Visualize your progress on a yearly calendar and get reports for each habit with your current and longest streak, as well as your yearly and all-time completion rates. \\n\\n• Make your Home Screen shine with widgets\\nThe app offer a wide variety of gorgeous widgets: weekly calendar, monthly calendar, last 3 months calendar, last 20 weeks grid, etc.\\n\\n• Share Your Habits\\nShare your habits with friends, family, and followers - thanks to the beautifully designed,  pre-formatted calendar images.\\n\\n• Get Your Dopamine Rush\\nNothing quite hits like the dopamine rush you get when crossing off an item on a list. With Evoday, you can track your daily goals and feel that sweet sense of accomplishment when you reach them.\\n\\n• Your Data Is Your Data\\nWe care about your privacy. Your habits data never leave your phone or the iCloud backups of your phone. None of your habits data is ever sent to a server, except iCloud as part of your secure phone backups. When you get a new phone and restore from your previous phone (or your iCloud backup), your habits data will be there waiting for you, so you can jump right back in with ease. You can also export your data and save it wherever you want! (Files, Dropbox, Google Drive, etc.).\\n\\n• Our App Is Made For Everyone\\nWe’ve made the choice of offering most features of Evoday free of charge, forever. We want our app to be accessible to anyone and everyone, in the hopes of helping to improve your habits and your life. . If you want to unlock some advanced features and track unlimited habits, an optional Premium Plan is available either as a subscription, or as a one-time purchase.\\n\\nPrivacy Policy: https://www.kevinquisquater.com/superhabit/privacy.html\\nTerms of Use: https://www.kevinquisquater.com/superhabit/terms.html\\n\\n\\nIf you have any feedback or suggestions, then we’d be more than happy to hear them! Get in touch via the app and let us know how we’re doing. \\n\\n••• About Cosmic Taps •••\\nWe are a tiny team building apps that we love to use. Check them out either by tapping on our developer name, by searching “Cosmic Taps” on the App Store, or by visiting www.cosmictaps.com\\n\\nTo a better you,\\nThe team at Cosmic Taps\"},\"isStandaloneWithCompanionForWatchOS\":false,\"isAppleWatchSupported\":false,\"requiredCapabilitiesForRealityDevice\":\"arm64 \",\"versionHistory\":[{\"versionDisplay\":\"2025.8\",\"releaseNotes\":\"• Minor bug fixes and improvements\",\"releaseDate\":\"2025-02-26\",\"releaseTimestamp\":\"2025-02-26T09:23:55Z\"},{\"versionDisplay\":\"2025.7\",\"releaseNotes\":\"• Minor bug fixes and improvements\",\"releaseDate\":\"2025-02-21\",\"releaseTimestamp\":\"2025-02-21T08:36:02Z\"},{\"versionDisplay\":\"2025.6\",\"releaseNotes\":\"• Minor bug fixes and improvements\",\"releaseDate\":\"2025-02-04\",\"releaseTimestamp\":\"2025-02-04T07:47:19Z\"},{\"versionDisplay\":\"2025.5\",\"releaseNotes\":\"• Minor bug fixes and improvements\",\"releaseDate\":\"2025-01-16\",\"releaseTimestamp\":\"2025-01-16T14:50:33Z\"},{\"versionDisplay\":\"2025.4\",\"releaseNotes\":\"• Minor bug fixes and improvements\",\"releaseDate\":\"2025-01-08\",\"releaseTimestamp\":\"2025-01-08T15:08:57Z\"},{\"versionDisplay\":\"2025.3\",\"releaseNotes\":\"• Minor bug fixes and improvements\",\"releaseDate\":\"2025-01-06\",\"releaseTimestamp\":\"2025-01-06T21:14:18Z\"},{\"versionDisplay\":\"2025.2\",\"releaseNotes\":\"Happy 2025 everyone!\\n• EVODAY: we are really happy to announce that we have found a great new name for the app: Evoday. Tell us what you think by tapping “Contact” in the app! Your friends can find us at evoday.com\\n• First attempt at trying to fix a crash that sometimes happens when you go to the Yearly page. We are not sure yet if this will fix the issue, but are hopeful :-)\",\"releaseDate\":\"2025-01-03\",\"releaseTimestamp\":\"2025-01-03T10:28:34Z\"},{\"versionDisplay\":\"2025.1\",\"releaseNotes\":\"• Minor bug fixes and improvements\",\"releaseDate\":\"2024-12-31\",\"releaseTimestamp\":\"2024-12-31T09:02:29Z\"},{\"versionDisplay\":\"2024.18\",\"releaseNotes\":\"Happy 2025 everyone!\\nThe entire team hopes you build the life you want, and that the app will play a little role in helping you reach your goals.\\n• Kevin speaking: I’ve just realized I messed up the crash reporting setup years ago —classic Kevin move. If your app was crashing, we probably had no idea unless you emailed us about it. It’s fixed now, so we’ll actually notice crashes quickly and get them sorted in time. Remember, you can always email us directly if you spot issues—we read every message.\\n• We heard that the app sometimes crashes when going from the monthly page to the Today page: with that update, we should soon receive crash reports and be able to find out what’s happening. Sorry about that.\\nThanks a lot and to an amazing New Year for you and for our team!\\nKevin, for the team at Cosmic Taps\",\"releaseDate\":\"2024-12-29\",\"releaseTimestamp\":\"2024-12-29T20:34:17Z\"},{\"versionDisplay\":\"2024.17\",\"releaseNotes\":\"• Minor bug fixes and improvements\",\"releaseDate\":\"2024-12-20\",\"releaseTimestamp\":\"2024-12-20T09:01:00Z\"},{\"versionDisplay\":\"2024.16\",\"releaseNotes\":\"• Minor bug fixes and improvements\",\"releaseDate\":\"2024-12-12\",\"releaseTimestamp\":\"2024-12-12T10:30:37Z\"},{\"versionDisplay\":\"2024.15\",\"releaseNotes\":\"• Minor bug fixes and improvements\",\"releaseDate\":\"2024-12-04\",\"releaseTimestamp\":\"2024-12-04T12:58:43Z\"},{\"versionDisplay\":\"2024.14\",\"releaseNotes\":\"• Minor bug fixes and improvements\",\"releaseDate\":\"2024-11-28\",\"releaseTimestamp\":\"2024-11-28T10:33:54Z\"},{\"versionDisplay\":\"2024.13\",\"releaseNotes\":\"• We have fixed a bug with the contact form that was introduced with iOS 18. If you were not able to contact us recently, please send us another email. Sorry about that!\\n• We’ve added support for the new iOS 18 tinted mode in widgets.\\n• We fixed a bug where white spaces could appear on the borders of some Premium widgets.\",\"releaseDate\":\"2024-11-19\",\"releaseTimestamp\":\"2024-11-19T08:35:32Z\"},{\"versionDisplay\":\"2024.12\",\"releaseNotes\":\"• We added Dark and Tinted app icons for a future update of iOS\",\"releaseDate\":\"2024-09-16\",\"releaseTimestamp\":\"2024-09-16T08:17:05Z\"},{\"versionDisplay\":\"2024.11\",\"releaseNotes\":\"• Minor bug fixes and improvements\",\"releaseDate\":\"2024-09-10\",\"releaseTimestamp\":\"2024-09-10T06:37:47Z\"},{\"versionDisplay\":\"2024.10\",\"releaseNotes\":\"• Minor bug fixes and improvements\",\"releaseDate\":\"2024-08-23\",\"releaseTimestamp\":\"2024-08-23T16:06:46Z\"},{\"versionDisplay\":\"2024.9\",\"releaseNotes\":\"• Minor bug fixes and improvements\",\"releaseDate\":\"2024-07-25\",\"releaseTimestamp\":\"2024-07-25T12:41:32Z\"},{\"versionDisplay\":\"2024.8\",\"releaseNotes\":\"Hello everyone! On the menu today, a bug fix and UI polishing for our lovely widgets:\\n• We’ve fixed a small but annoying display bug with the “Last 20 weeks” widget, where data appeared shifted by one day. This was just a display issue, it did not affect your data. Thank you to the users that contacted us about this.\\n• We’ve made tons of really small tweaks to the design of the widgets. There are subtle, but if you have a good eye you will notice the difference.\\n\\nBig thanks to the team for the amazing work on this!\\nKevin, for the team at Cosmic Taps\",\"releaseDate\":\"2024-06-10\",\"releaseTimestamp\":\"2024-06-10T07:34:50Z\"},{\"versionDisplay\":\"2024.7\",\"releaseNotes\":\"• Minor bug fixes and improvements\",\"releaseDate\":\"2024-04-27\",\"releaseTimestamp\":\"2024-04-27T09:40:56Z\"},{\"versionDisplay\":\"2024.6\",\"releaseNotes\":\"• Minor bug fixes and improvements\",\"releaseDate\":\"2024-04-16\",\"releaseTimestamp\":\"2024-04-16T08:22:30Z\"},{\"versionDisplay\":\"2024.5\",\"releaseNotes\":\"• Minor bug fixes and improvements\",\"releaseDate\":\"2024-04-11\",\"releaseTimestamp\":\"2024-04-11T12:42:57Z\"},{\"versionDisplay\":\"2024.4\",\"releaseNotes\":\"• Minor bug fixes and improvements\",\"releaseDate\":\"2024-04-10\",\"releaseTimestamp\":\"2024-04-10T14:26:18Z\"},{\"versionDisplay\":\"2024.3\",\"releaseNotes\":\"WIDGETS ARE HERE!\\nYou have been asking for them for months, and our little team is finally delivering!\\nWe didn't want to just build one simple widget... we've been working hard at building what we believe is one of the most complete suite of widgets of any habit tracker on the App Store. And we have many many more in our design files, shipping slowly over the next few months!\\n\\nWe have spend hundreds of hours planning, designing and developing those widgets. We have been testing them for a few weeks and we hope you'll love them as much as we do.\\n\\nIf you want to talk to the team or to other users, you can join our community on Reddit: reddit.com/r/HabitsApp\\n\\nSome important information:\\n• You may notice that the widgets are not perfect yet, they are not interactive (we tried, but there are some iOS limitations that prevented us to make it work flawlessly —we are keeping an eye on Apple's annouvements), they might not refresh immediately at midnight, etc. But we have all this on our to-do list and will improve them over time.\\n• You need to be on iOS 17 to access the widgets.\\n• All users are able to create as many weekly calendar widgets as they want. Our more fancy widgets (current month calendar, last 3 months calendar, last 20 weeks grid) are exclusive to Premium users.\\nIf you appreciate our work, please consider upgrading to Premium!\\n\\nHuge thanks to everyone that sent us feature requests and ideas about widgets. We took note of everything!\\n\\n---\\nBy the way, this is Kevin writing, and I am lucky not to be alone working on the apps anymore. We are a small team and our company is called Cosmic Taps, you can check out our other apps at CosmicTaps.com\\n\\nI would like to send a huge thanks to the entire team that was involved in making the widgets possible, they will recognize themselves!\\nI would have NEVER been able to work on this alone. I have been using the widgets on my phone for a few weeks and I still can't believe that they exist and look so beautiful.\\n\\nThank you\\n— Kevin\",\"releaseDate\":\"2024-03-17\",\"releaseTimestamp\":\"2024-03-17T20:31:05Z\"},{\"versionDisplay\":\"2024.2\",\"releaseNotes\":\"• Minor bug fixes and improvements\",\"releaseDate\":\"2024-02-28\",\"releaseTimestamp\":\"2024-02-28T09:58:15Z\"}],\"websiteUrl