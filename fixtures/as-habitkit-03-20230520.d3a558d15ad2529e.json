butionKind\":\"APP_STORE\",\"supportsArcade\":false,\"isFirstPartyHideableApp\":false,\"privacy\":{\"privacyTypes\":[{\"privacyType\":\"Data Not Linked to You\",\"identifier\":\"DATA_NOT_LINKED_TO_YOU\",\"description\":\"The following data may be collected but it is not linked to your identity:\",\"dataCategories\":[{\"dataCategory\":\"Purchases\",\"identifier\":\"PURCHASES\"},{\"dataCategory\":\"Identifiers\",\"identifier\":\"IDENTIFIERS\"},{\"dataCategory\":\"Usage Data\",\"identifier\":\"USAGE_DATA\"},{\"dataCategory\":\"Diagnostics\",\"identifier\":\"DIAGNOSTICS\"}]}]},\"contentRatingsBySystem\":{\"appsApple\":{\"name\":\"4+\",\"value\":100,\"rank\":1}},\"deviceFamilies\":[\"iphone\"],\"url\":\"https://apps.apple.com/us/app/forte-habit-tracker/id1507681077\",\"userRating\":{\"value\":4.4,\"ratingCount\":32,\"ratingCountList\":[2,0,2,7,21],\"ariaLabelForRatings\":\"4.4 stars\"},\"firstVersionSupportingInAppPurchaseApi\":\"2020.1\",\"genreDisplayName\":\"Productivity\",\"name\":\"Forte² - Habit Tracker\",\"isPreorder\":false,\"artistName\":\"Cortilab LLC\",\"isIOSBinaryMacOSCompatible\":false,\"reviewsRestricted\":false,\"requirementsByDeviceFamily\":{\"iphone\":{\"deviceFamily\":\"iPhone\",\"requirementString\":\"Requires iOS 16.0 or later.\"}},\"platformAttributes\":{\"ios\":{\"minimumMacOSVersion\":\"13.0\",\"description\":{\"standard\":\"Meet Forte - Habit Tracker\\n\\nForte is a habit tracker unlike any other. While other habit trackers track your progress using streaks, Forte uses a fancy algorithm to measure your habit strength. Unlike streak based habit trackers, Forte won't crush your motivation by resetting your hard-earned progress back to zero from one bad day.\\n\\nFeatures:\\n• Track the habits you want to BUILD or QUIT\\n• Track habits up to 100 times per day\\n• Set a weekly, bi-weekly, or monthly goal for each habit\\n• Set multiple habit reminders to keep you on track\\n• View detailed stats for each habit \u0026 share them with your friends\\n• 10 vibrant color options\\n• 180+ habit icons\\n• Home screen widgets keep your habits front and center\\n• Automatic iCloud backups\\n• Fully accessible with VoiceOver\\n\\nThe FREE version of Forte² allows you to track up to 4 habits. To track more, you'll need to subscribe to Forte Premium.\\n\\nForte Premium:\\n• Unlimited number of habits\\n• Record daily notes for each habit\\n• Customize accent color and app icon\\n• Support development \\n\\nIf you have any questions or suggestions on how I can improve Forte, please do not hesitate to contact me at support@fortehabits.com\\n\\n—-\\nIcons by Icons8\\nTerms of Use: https://www.apple.com/legal/internet-services/itunes/dev/stdeula/\"},\"isStandaloneWithCompanionForWatchOS\":false,\"isAppleWatchSupported\":false,\"versionHistory\":[{\"versionDisplay\":\"2022.8\",\"releaseNotes\":\"- Added Lifetime subscription option\",\"releaseDate\":\"2022-12-18\",\"releaseTimestamp\":\"2022-12-18T00:03:52Z\"},{\"versionDisplay\":\"2022.7\",\"releaseNotes\":\"Bug Fixes\\n- Fixed bug that prevented iCloud from syncing in some cases.\\n- Fixed bug that caused missing entries in database.\\n- Fixed loophole where users could continue tracking more than 4 habits after subscription ended\",\"releaseDate\":\"2022-11-26\",\"releaseTimestamp\":\"2022-11-26T17:04:41Z\"},{\"versionDisplay\":\"2022.6\",\"releaseNotes\":\"New Features\\n- Added lock screen widget\\n- Redesigned home screen widget\\n\\nBug Fixes\\n- Fixed blank home screen widgets\\n- Various visual bugs caused by iOS 16\\n\",\"releaseDate\":\"2022-11-21\",\"releaseTimestamp\":\"2022-11-21T14:22:26Z\"},{\"versionDisplay\":\"2022.5\",\"releaseNotes\":\"New Features\\n• Redesigned habit editor and icon picker\",\"releaseDate\":\"2022-06-29\",\"releaseTimestamp\":\"2022-06-29T18:44:17Z\"},{\"versionDisplay\":\"2022.4\",\"releaseNotes\":\"New Features\\n• Added labels for days and months on the heatmap\\n\\nBug Fixes\\n• Fixed display issues with the heatmap widget\\n• Fixed bug that caused the badge count to not update on day change\",\"releaseDate\":\"2022-06-10\",\"releaseTimestamp\":\"2022-06-10T02:18:43Z\"},{\"versionDisplay\":\"2022.3\",\"releaseNotes\":\"New Features\\n• You can now track habits every 2, 3, or 4 weeks or even monthly.\\n• The long requested ability to exceed your habit's daily goal is finally here.\\n• Premium subscribers can add daily notes to each habit. Just long press on a checkbox to bring up the note editor.\\n• The habit score now only goes up to 100%. You may notice your scores have changed with the updated algorithm.\",\"releaseDate\":\"2022-05-31\",\"releaseTimestamp\":\"2022-05-31T22:03:48Z\"},{\"versionDisplay\":\"2022.2\",\"releaseNotes\":\"New Features\\n• Improved accessibility with support for VoiceOver and Dynamic Type\\n• New alerts for iCloud sync issues\\n• 2 new habit icons\\n\\nBug Fixes\\n• Fixed remnants of habits remaining after deletion\\n• Fixed 24-hour time formatting\\n• Temporarily removed archiving due to some serious bugs\",\"releaseDate\":\"2022-04-07\",\"releaseTimestamp\":\"2022-04-07T00:01:35Z\"},{\"versionDisplay\":\"2022.1\",\"releaseNotes\":\"- New stats on habit stats page\\n- 2 new widgets\\n- 6 new habit icons\\n- Added iCloud sync monitoring\\n- Reminders now support 24-hour time format\\n- Colors have been adjusted for legibility\",\"releaseDate\":\"2022-02-18\",\"releaseTimestamp\":\"2022-02-18T22:21:39Z\"},{\"versionDisplay\":\"2021.4\",\"releaseNotes\":\"New Features\\n- Added indicators on the main screen to show the whole week’s progress for each habit.\\n\\nBug Fixes\\n- Fixed broken habit sorting.\\n- Fixed bug that caused user selected app theme to reset to the system theme when the app was restarted.\\n- Fixed alignment issues on the habit stats page.\\n- Fixed issue where previous day was still selected on app open.\",\"releaseDate\":\"2021-12-28\",\"releaseTimestamp\":\"2021-12-28T20:58:07Z\"},{\"versionDisplay\":\"2021.3\",\"releaseNotes\":\"- Fixed a bug that prevented importing data from the original Forte\",\"releaseDate\":\"2021-12-12\",\"releaseTimestamp\":\"2021-12-12T12:29:08Z\"},{\"versionDisplay\":\"2021.2\",\"releaseNotes\":\"Forte has been rewritten from the ground up!\\n\\nI've spent a good chunk of 2021 rewriting the horrible mess that was the original React Native version of Forte. Forte² has been created from scratch in Swift and SwiftUI to be more performant and prettier than ever! \\n\\nSo What's Changed?\\n\\n- No more skipping or failing\\nCheck off the days you complete your habits, ignore the days you don't. Forte²'s improved scoring algorithm will handle the rest.\\n\\n- Track habits multiple times a day\\nForte² allows you to track habits all the way up to 100 times a day. I'm not sure why you'd need to do that but now you can!\\n\\n- Widgets\\nI've only got one kind added so far, more will be coming!\\n\\n- Achievements\\nI made some shiny badges you can earn by completing your habits every day! You can easily share them with your friends or strangers on the internet too (while providing me with free advertising)\\n\\n- What else?\\nThere's a new stats page for each habit, some extra settings like a privacy lock, new app icons, and of course who could forget all the \\\"bug fixes and improvements.\\\"\\n\\nPrivacy Policy has been updated\",\"releaseDate\":\"2021-12-11\",\"releaseTimestamp\":\"2021-12-11T15:34:11Z\"},{\"versionDisplay\":\"2021.1\",\"releaseNotes\":\"Bug fix for issue where the full calendar would be off by one day.\",\"releaseDate\":\"2021-03-14\",\"releaseTimestamp\":\"2021-03-14T22:20:53Z\"},{\"versionDisplay\":\"2020.5\",\"releaseNotes\":\"• You can now view the full calendar history of your habits.\\n• Habit sorting is back! It can be accessed from the settings screen.\\n• Reverted reminder time selector to the classic spinner style.\\n• Bug fixes.\",\"releaseDate\":\"2020-11-20\",\"releaseTimestamp\":\"2020-11-20T19:16:24Z\"},{\"versionDisplay\":\"2020.4\",\"releaseNotes\":\"• Fixed error logging bug.\",\"releaseDate\":\"2020-09-27\",\"releaseTimestamp\":\"2020-09-27T13:18:38Z\"},{\"versionDisplay\":\"2020.3\",\"releaseNotes\":\"• Your habits are now automatically backed up to iCloud.\\n• Added button in Settings to restore from data in iCloud.\\n• Modified UI for adding reminders.\\n• Fixed bug that would prevent adding multiple reminders.\\n• Confirmation now required to delete a habit.\\n• Removed the header from the main screen.\\n• Temporarily removed habit sorting due to a bug that would crash the app.\\n• Forte's Privacy Policy has been updated. https://fortehabits.com/privacy-policy\",\"releaseDate\":\"2020-09-03\",\"releaseTimestamp\":\"2020-09-03T18:18:36Z\"},{\"versionDisplay\":\"2020.2\",\"releaseNotes\":\"• Added a fancy update modal\\n• Forte's Privacy Policy has been updated. https://fortehabits.com/privacy-policy\",\"releaseDate\":\"2020-06-09\",\"releaseTimestamp\":\"2020-06-09T14:06:56Z\"},{\"versionDisplay\":\"2020.1\",\"releaseNotes\":null,\"releaseDate\":\"2020-05-23\",\"releaseTimestamp\":\"2020-05-23T05:53:13Z\"}],\"websiteUrl\":\"http://www.fortehabits.com\",\"hasSafariExtension\":false,\"messagesScreenshots\":{},\"requiresGameController\":false,\"offers\":[{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=1507681077\u0026pricingParameters=STDQ\u0026pg=default\u0026appExtVrsId=853927001\",\"type\":\"get\",\"priceFormatted\":\"$0.00\",\"price\":0,\"currencyCode\":\"USD\",\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":72091648}]},{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=1507681077\u0026pricingParameters=SWUPD\u0026pg=default\u0026appExtVrsId=853927001\",\"type\":\"update\",\"priceFormatted\":\"$0.00\",\"price\":0,\"currencyCode\":\"USD\",\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":72091648}]}],\"requires32bit\":false,\"releaseDate\":\"2020-06-01\",\"hasInAppPurchases\":true,\"bundleId\":\"com.cortilab.forte\",\"hasMessagesExtension\":false,\"artwork\":{\"width\":1024,\"heigh