"@@product@@ @@qualifier@@","WEA.LocalNav.Title.Preview.iBooks":"@@product@@ @@qualifier@@","WEA.LocalNav.Title.Preview.iTunes":"@@product@@ @@qualifier@@","WEA.MusicPages.Riaa.Explicit.AX":"Parental Advisory: Explicit Lyrics.","WEA.PaddleNav.Next.AX":"Next","WEA.PaddleNav.Previous.AX":"Previous","WEA.StarRating.Separator":" • ","WFA.Common.Meta.Twitter.site":"@Apple"}}</script><script type="fastboot/shoebox" id="shoebox-media-api-cache-apps">{".v1.catalog.us.apps.6443918070.l.en-us.platform.web.additionalplatforms.appletv.2cipad.2ciphone.2cmac.extend.custompromotionaltext.2ccustomscreenshotsbytype.2cdescription.2cdeveloperinfo.2cdistributionkind.2ceditorialvideo.2cfilesizebydevice.2cmessagesscreenshots.2cprivacy.2cprivacypolicyurl.2crequirementsbydevicefamily.2csupporturlforlanguage.2cversionhistory.2cwebsiteurl.2cvideopreviewsbytype.include.app-events.2cgenres.2cdeveloper.2creviews.2cmerchandised-in-apps.2ccustomers-also-bought-apps.2cdeveloper-other-apps.2ctop-in-apps.2crelated-editorial-items.limit.5bmerchandised-in-apps.5d.20.omit.5bresource.5d.autos.meta.robots.sparselimit.5bapps.3arelated-editorial-items.5d.20.sparselimit.5bapps.3acustomers-also-bought-apps.5d.20.sparselimit.5bapps.3adeveloper-other-apps.5d.20":"{\"x\":1684547768142,\"d\":[{\"id\":\"6443918070\",\"type\":\"apps\",\"href\":\"/v1/catalog/us/apps/6443918070?l=en-US\",\"attributes\":{\"distributionKind\":\"APP_STORE\",\"supportsArcade\":false,\"familyShareEnabledDate\":\"0001-04-23T00:00:00Z\",\"isFirstPartyHideableApp\":false,\"privacy\":{\"privacyTypes\":[{\"privacyType\":\"Data Linked to You\",\"identifier\":\"DATA_LINKED_TO_YOU\",\"description\":\"The following data may be collected and linked to your identity:\",\"dataCategories\":[{\"dataCategory\":\"Purchases\",\"identifier\":\"PURCHASES\"}]},{\"privacyType\":\"Data Not Linked to You\",\"identifier\":\"DATA_NOT_LINKED_TO_YOU\",\"description\":\"The following data may be collected but it is not linked to your identity:\",\"dataCategories\":[{\"dataCategory\":\"Diagnostics\",\"identifier\":\"DIAGNOSTICS\"}]}]},\"contentRatingsBySystem\":{\"appsApple\":{\"name\":\"4+\",\"value\":100,\"rank\":1}},\"deviceFamilies\":[\"iphone\",\"ipod\"],\"url\":\"https://apps.apple.com/us/app/habit-tracker-habitkit/id6443918070\",\"usesLocationBackgroundMode\":false,\"userRating\":{\"value\":5,\"ratingCount\":33,\"ratingCountList\":[0,0,0,0,33],\"ariaLabelForRatings\":\"5.0 stars\"},\"firstVersionSupportingInAppPurchaseApi\":\"1.0\",\"name\":\"Habit Tracker - HabitKit\",\"genreDisplayName\":\"Productivity\",\"isPreorder\":false,\"artistName\":\"Sebastian Roehl\",\"isIOSBinaryMacOSCompatible\":true,\"reviewsRestricted\":false,\"sellerLabel\":\"Seller\",\"requirementsByDeviceFamily\":{\"ipod\":{\"deviceFamily\":\"iPod touch\",\"requirementString\":\"Requires iOS 14.0 or later.\"},\"iphone\":{\"deviceFamily\":\"iPhone\",\"requirementString\":\"Requires iOS 14.0 or later.\"},\"mac\":{\"deviceFamily\":\"Mac\",\"requirementString\":\"Requires macOS 11.0 or later and a Mac with Apple M1 chip or later.\"}},\"hasEula\":false,\"platformAttributes\":{\"ios\":{\"seller\":\"Sebastian Roehl\",\"copyright\":\"© 2022 Sebastian Röhl\",\"minimumMacOSVersion\":\"11.0\",\"description\":{\"standard\":\"HabitKit is the perfect app for anyone looking to form new habits or break old ones. With HabitKit, you can track your progress with beautiful tile-based grid charts. Whether you're trying to quit smoking, eat healthier, or exercise more, HabitKit can help you achieve your goals. You can customize your dashboard by adjusting colors, icons and descriptions. Draw motivation from growing the amount of colored tiles on your habit dashboard.\\n\\n---\\n\\nCREATE HABITS\\nAdd your habits you want to track in a fast and easy way. Provide a name, description, icon and color and you're good to go.\\n\\nDASHBOARD\\nAll your habits are displayed on your dashboard represented by a cool looking grid chart. Every filled out square show a day where you kept up with your habit.\\n\\nCALENDAR\\nThe calendar provides a fast and easy way to manage past completions. Simply tap a day to remove or add a completion.\\n\\nARCHIVE\\nDo you need a break from a habit and don't want to clutter your dashboard with it? Just archive it and restore it at a later point from the menu.\\n\\nIMPORT AND EXPORT\\nSwitching phones and don't want to lose your data? Export your data to a file, save it wherever you want and restore it at a later point of time.\\n\\nPRIVACY FOCUSED\\nAll your data belongs to you and stays on your phone. No sign-in. No servers. No cloud.\\n\\n---\\n\\nTerms of Use: https://www.habitkit.app/tos/\\nPrivacy Policy: https://www.habitkit.app/privacy/\"},\"isStandaloneWithCompanionForWatchOS\":false,\"is32bitOnly\":false,\"isAppleWatchSupported\":false,\"versionHistory\":[{\"versionDisplay\":\"1.4.5\",\"releaseNotes\":\"This release includes several bug fixes and performance optimizations.\",\"releaseDate\":\"2023-04-28\",\"releaseTimestamp\":\"2023-04-28T06:28:15Z\"},{\"versionDisplay\":\"1.4.4\",\"releaseNotes\":\"This release includes several bug fixes and performance optimizations.\",\"releaseDate\":\"2023-04-21\",\"releaseTimestamp\":\"2023-04-21T07:14:03Z\"},{\"versionDisplay\":\"1.4.3\",\"releaseNotes\":\"This release includes several bug fixes and performance optimizations.\",\"releaseDate\":\"2023-03-26\",\"releaseTimestamp\":\"2023-03-26T06:34:11Z\"},{\"versionDisplay\":\"1.4.2\",\"releaseNotes\":\"This release includes several bug fixes.\",\"releaseDate\":\"2023-03-19\",\"releaseTimestamp\":\"2023-03-19T08:38:13Z\"},{\"versionDisplay\":\"1.4.1\",\"releaseNotes\":\"This release includes several bug fixes.\",\"releaseDate\":\"2023-03-18\",\"releaseTimestamp\":\"2023-03-18T18:17:49Z\"},{\"versionDisplay\":\"1.4.0\",\"releaseNotes\":\"This release includes the following new features:\\n- New widget type: Small consistency graph\\n- Configurable widgets (theme, completion indicator, description)\\n- Performance optimizations and bug fixes\",\"releaseDate\":\"2023-03-18\",\"releaseTimestamp\":\"2023-03-18T07:34:35Z\"},{\"versionDisplay\":\"1.3.1\",\"releaseNotes\":\"This release includes various bugfixes and performance optimizations.\",\"releaseDate\":\"2023-02-21\",\"releaseTimestamp\":\"2023-02-21T05:57:45Z\"},{\"versionDisplay\":\"1.3.0\",\"releaseNotes\":\"This release includes the following features:\\n- Generate cool images to share your consistency\\n- Several bugfixes and performance optimizations\",\"releaseDate\":\"2023-02-18\",\"releaseTimestamp\":\"2023-02-18T08:58:29Z\"},{\"versionDisplay\":\"1.2.2\",\"releaseNotes\":\"This release includes the following:\\n- New translations (Arabic, Belarusian, Catalan, Spanish, French, Hungarian, Italian, Dutch, Portugese and Turkish)\\n- New and more icons\\n- Option to start the week on a Sunday\\n- Several bugfixes and performance optimizations\",\"releaseDate\":\"2023-02-08\",\"releaseTimestamp\":\"2023-02-08T08:04:13Z\"},{\"versionDisplay\":\"1.2.1\",\"releaseNotes\":\"This release includes several bugfixes and performance optimizations.\",\"releaseDate\":\"2023-01-21\",\"releaseTimestamp\":\"2023-01-21T21:39:19Z\"},{\"versionDisplay\":\"1.2.0\",\"releaseNotes\":\"This version adds support for Home Screen Widgets.\",\"releaseDate\":\"2023-01-21\",\"releaseTimestamp\":\"2023-01-21T08:27:51Z\"},{\"versionDisplay\":\"1.1.3\",\"releaseNotes\":\"This release includes several bugfixes and performance optimizations.\",\"releaseDate\":\"2023-01-10\",\"releaseTimestamp\":\"2023-01-10T07:57:34Z\"},{\"versionDisplay\":\"1.1.2\",\"releaseNotes\":\"This release includes several bugfixes and performance optimizations.\",\"releaseDate\":\"2022-12-20\",\"releaseTimestamp\":\"2022-12-20T06:36:39Z\"},{\"versionDisplay\":\"1.1.1\",\"releaseNotes\":\"This release includes several bugfixes and performance optimizations.\",\"releaseDate\":\"2022-12-19\",\"releaseTimestamp\":\"2022-12-19T09:45:07Z\"},{\"versionDisplay\":\"1.1.0\",\"releaseNotes\":\"Thank you for using HabitKit! Below are the changes for this update. Happy habit tracking!\\n\\n*Streaks*\\nGet motivation from streaks. Tell the app how often you would like to complete a habit (3/week, 20/month, daily, ...) and see how your streak count grows!\\n\\n*Reminders*\\nNever miss a completion again and add reminders to your habits. You'll get a notification at your specified time.\\n\\n*Other Improvements*\\n- Completions on the overview page by long-pressing the checkmark\\n- More colors\\n- Bugfixes\",\"releaseDate\":\"2022-12-18\",\"releaseTimestamp\":\"2022-12-18T08:03:23Z\"},{\"versionDisplay\":\"1.0.1\",\"releaseNotes\":\"This release includes several bugfixes and performance optimizations.\",\"releaseDate\":\"2022-12-01\",\"releaseTimestamp\":\"2022-12-01T13:34:10Z\"},{\"versionDisplay\":\"1.0\",\"releaseNotes\":null,\"releaseDate\":\"2022-11-27\",\"releaseTimestamp\":\"2022-11-27T07:57:11Z\"}],\"websiteUrl\":\"https://www.habitkit.app\",\"hasSafariExtension\":false,\"languageList\":[\"English\"],\"messagesScreenshots\":{},\"requiresGameController\":false,\"requiredCapabilities\":\"arm64 \",\"offers\":[{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=6443918070\u0026pricingParameters=STDQ\u0026pg=default\u0026appExtVrsId=856609286\",\"type\":\"get\",\"priceFormatted\":\"$0.00\",\"price\":0,\"currencyCode\":\"USD\",\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":68556800}]},{\"buyParams\":\"productType=C\u0026price=0\u0026salableAdamId=6443918070\u0026pricingParameters=SWUPD\u0026pg=default\u0026appExtVrsId=856609286\",\"type\":\"update\",\"priceFormatted\":\"$0.00\",\"price\":0,\"currencyCode\":\"USD\",\"assets\":[{\"flavor\":\"iosSoftware\",\"size\":68556800}]}],\"requires32bit\":false,\"supportedLocales\":[{\"name\":\"English\",\"tag\":\"en-US\"}],\"isGameCenterEnabled\":false,\"isSiriSupported\":false,\"releaseDate\":\"2022-11-26\",\"minimumOSVersion\":\"14.0\",\"hasInAppPurchases\":true,\"bundleId\":\"com.roehl.habitkit\"