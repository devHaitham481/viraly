"],\"url\":\"https://apps.apple.com/us/app/quick-capture-fast-notes/id1609202525\",\"userRating\":{\"value\":5,\"ratingCount\":19,\"ratingCountList\":[0,0,0,0,19],\"ariaLabelForRatings\":\"5.0 stars\"},\"genreDisplayName\":\"Productivity\",\"name\":\"Quick Capture: Fast Notes\",\"isPreorder\":false,\"artistName\":\"Philip Davis\",\"isIOSBinaryMacOSCompatible\":false,\"reviewsRestricted\":false,\"requirementsByDeviceFamily\":{\"iphone\":{\"deviceFamily\":\"iPhone\",\"requirementString\":\"Requires iOS 15.0 or later and a device with the A12 Bionic chip or later.\",\"devices\":[\"iPhone XS\",\"iPhone XS Max\",\"iPhone XR\",\"iPhone 11\",\"iPhone 11 Pro\",\"iPhone 11 Pro Max\",\"iPhone SE (2nd generation)\",\"iPhone 12 mini\",\"iPhone 12\",\"iPhone 12 Pro\",\"iPhone 12 Pro Max\",\"iPhone 13 Pro\",\"iPhone 13 Pro Max\",\"iPhone 13 mini\",\"iPhone 13\",\"iPhone SE (3rd generation)\",\"iPhone 14\",\"iPhone 14 Plus\",\"iPhone 14 Pro\",\"iPhone 14 Pro Max\"]}},\"platformAttributes\":{\"ios\":{\"minimumMacOSVersion\":\"12.0\",\"description\":{\"standard\":\"Quick Capture is a frictionless note taking app.\\n\\nIt's focused on helping you get your ideas out of your head, and into plain text.\\n\\nThere are three input modes to help you do this. Live Text, Dictation, and Keyboard.\\n\\nYou can also share your notes with others, or send it to other apps.\"},\"isStandaloneWithCompanionForWatchOS\":false,\"isAppleWatchSupported\":false,\"versionHistory\":[{\"versionDisplay\":\"1.2.0\",\"releaseNotes\":\"Fixed a few iOS16 bugs\\nAdded a refreshed app icon\",\"releaseDate\":\"2022-09-16\",\"releaseTimestamp\":\"2022-09-16T22:30:32Z\"},{\"versionDisplay\":\"1.1.0\",\"releaseNotes\":\"Added Dictation support for the following languages:\\nArabic\\nCantonese\\nChinese (Simplified)\\nChinese (Traditional)\\nFrench\\nGerman\\nGreek\\nHebrew\\nHindi\\nIndonesian\\nJapanese\\nKorean\\nRomanian\\nRussian\\nSpanish\\nThai\\nUkranian\\nVietnamese\\n\\nIf you like the app, I'd appreciate a ra