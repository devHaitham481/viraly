:\"/v1/catalog/us/apps/1659811306/genres?l=en-US\",\"data\":[{\"id\":\"6007\",\"type\":\"genres\",\"href\":\"/v1/catalog/us/genres/6007?l=en-US\",\"attributes\":{\"parentName\":\"App Store\",\"name\":\"Productivity\",\"parentId\":\"36\",\"url\":\"https://itunes.apple.com/us/genre/id6007\"}},{\"id\":\"6012\",\"type\":\"genres\",\"href\":\"/v1/catalog/us/genres/6012?l=en-US\",\"attributes\":{\"parentName\":\"App Store\",\"name\":\"Lifestyle\",\"parentId\":\"36\",\"url\":\"https://itunes.apple.com/us/genre/id6012\"}}]}},\"meta\":{\"contentVersion\":{\"RTCI\":1672496848317,\"MZ_INDEXER\":1682850273921}}},{\"id\":\"1481348382\",\"type\":\"apps\",\"href\":\"/v1/catalog/us/apps/1481348382?l=en-US\",\"attributes\":{\"distributionKind\":\"APP_STORE\",\"supportsArcade\":false,\"isFirstPartyHideableApp\":false,\"privacy\":{\"privacyTypes\":[{\"privacyType\":\"Data Not Linked to You\",\"identifier\":\"DATA_NOT_LINKED_TO_YOU\",\"description\":\"The following data may be collected but it is not linked to your identity:\",\"dataCategories\":[{\"dataCategory\":\"Location\",\"identifier\":\"LOCATION\"},{\"dataCategory\":\"Identifiers\",\"identifier\":\"IDENTIFIERS\"},{\"dataCategory\":\"Usage Data\",\"identifier\":\"USAGE_DATA\"}]}]},\"contentRatingsBySystem\":{\"appsApple\":{\"name\":\"4+\",\"value\":100,\"rank\":1,\"advisories\":[\"Infrequent/Mild Contests\"]}},\"deviceFamilies\":[\"iphone\"],\"url\":\"https://apps.apple.com/us/app/atomic-daily-habit-tracker/id1481348382\",\"userRating\":{\"value\":4.8,\"ratingCount\":12,\"ratingCountList\":[0,0,0,2,10],\"ariaLabelForRatings\":\"4.8 stars\"},\"firstVersionSupportingInAppPurchaseApi\":\"1.2\",\"genreDisplayName\":\"Productivity\",\"name\":\"Atomic Daily Habit Tracker\",\"isPreorder\":false,\"artistName\":\"kazene.com\",\"isIOSBinaryMacOSCompatible\":true,\"reviewsRestricted\":false,\"requirementsByDeviceFamily\":{\"iphone\":{\"deviceFamily\":\"iPhone\",\"requirementString\":\"Requires iOS 16.0 or later.\"},\"mac\":{\"deviceFamily\":\"Mac\",\"requirementString\":\"Requires macOS 13.0 or later and a Mac with Apple M1 chip or later.\"}},\"platformAttributes\":{\"ios\":{\"minimumMacOSVersion\":\"13.0\",\"description\":{\"standard\":\"Small Habits is the ultimate habit-forming app that can help you adopt one new habit every month and track it in the home screen widget. \\nThe habit tracker widget is a quick and easy way to keep yourself accountable, add data and see your progress in a calendar view.  \\n\\nThe widget will show how many days in a row you were on track. With Small Habits, you can create your habit, set a reminder, and track your progress.\\n\\nThis App is perfect for anyone looking to build better eating habits, establish a consistent exercise routine, or simply find more time for self-care. In fact, Small Habits has habit tracker features that suit all your needs. Small Habits app is the best app for anyone looking to build new, positive habits that stick. Its user-friendly design, powerful habit tracker features, and effective reminders make it the perfect tool for anyone looking to make positive changes in their life one habit at a time.\\n\\nSo, don't wait any longer. \\nDownload Small Habits today and start building the habits that will transform your life! \\n\\nMake sure you take advantage of the habit tracker widget, and habit tracker features to help you succeed in creating new, positive habits.\\n\\nPrivacy Policy: http://sleepybytes.com/privacy-policy/\\nTerms of use: https://www.apple.com/legal/internet-services/itunes/dev/stdeula/\"},\"isStandaloneWithCompanionForWatchOS\":false,\"isAppleWatchSupported\":false,\"versionHistory\":[{\"versionDisplay\":\"1.3.3\",\"releaseNotes\":\"The current day is now highlighted in the calendar widget\",\"releaseDate\":\"2023-02-22\",\"releaseTimestamp\":\"2023-02-22T23:42:57Z\"},{\"versionDisplay\":\"1.3.2\",\"releaseNotes\":\"Small fixes and performance improvements\",\"releaseDate\":\"2023-02-11\",\"releaseTimestamp\":\"2023-02-11T19