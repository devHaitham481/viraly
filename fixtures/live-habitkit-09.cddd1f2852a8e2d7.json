                                    <li><a href="#add-a-widget-on-iphone" class="block rounded py-2 text-[14px] leading-relaxed text-muted hover:text-accent focus-ring">Add A Widget On iPhone</a></li>
                                    <li><a href="#add-a-widget-on-android" class="block rounded py-2 text-[14px] leading-relaxed text-muted hover:text-accent focus-ring">Add A Widget On Android</a></li>
                                    <li><a href="#what-you-can-tap-on-the-widget" class="block rounded py-2 text-[14px] leading-relaxed text-muted hover:text-accent focus-ring">What You Can Tap On The Widget</a></li>
