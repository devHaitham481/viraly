Breviews%5D=8&l=en-US","destination":{"storefront":"us","language":"en-US","$kind":"ProductPageIntent","id":"672401817","platform":"iphone"}},"impressionMetrics":{"fields":{"id":"672401817","name":"Strides: Habit Tracker + Goals","impressionType":"lockup","idType":"its_id","reco_algoId":"cab_1","reco_eligible":"1","reco_hash":"cab_1","platformDisplayStyle":"ios","impressionIndex":7,"variantId":"default","experimentId":"93ad57ed-ed6a-494f-8161-5c607e034fbf","experimentLocale":"en-US","contentRating":100,"bundleId":"com.puresignal.strides"}}},{"$kind":"Lockup","adamId":"1450486923","bundleId":"com.alt.goodmorning","decorations":[],"icon":{"$kind":"Artwork","backgroundColor":{"red":1,"green":1,"blue":1,"type":"rgb"},"textColor":{"red":0.054901960784313725,"green":0.054901960784313725,"blue":0.03137254901960784,"type":"rgb"},"style":"roundedRectPrerendered","crop":"bb","contentMode":null,"imageScale":null,"template":"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource211/v4/ea/03/e2/ea03e263-a1a2-5c87-45ec-2b87a408ebf9/Placeholder.mill/{w}x{h}{c}.{f}","width":1024,"height":1024,"variants":[{"$kind":"ArtworkVariant","format":"jpeg","quality":70,"supportsWideGamut":false}]},"title":"Routine Planner, Habit Tracker","isIOSBinaryMacOSCompatible":true,"useAdsLocale":false,"subtitle":"Reminder & To Do List for ADHD","tertiaryTitle":"Designed for iPad.\nNot verified for macOS.","tertiaryTitleAction":null,"tertiaryTitleArtwork":null,"developerTagline":"Reminder & To Do List for ADHD","editorialTagline":"Create plans and routines","editorialDescription":"When a habit just won’t stick, let this app guide you to consistency. Set your cadence and schedule, then start a timer to get things done. In-depth stats will show your improvement in habits big and small.","ageRating":"16+","productDescription":"STOP PLANNING ROUTINES YOU NEVER FINISH. START LIVING THEM.\n\nRoutinery is the routine app that doesn't just help you plan — it walks you through every step. With voice-guided timers, notifications, and a flexible design built for real life, Routinery switches on your actions. Whether you're managing ADHD, juggling a packed schedule, or simply trying to build better habits, this is the habit tracker that actually moves with you.\n\nTRUSTED BY MILLIONS\n• Voted 2026 App of the Day by the Apple App Store\n• Named Best ADHD App by Forbes Health 2025\n• Loved and trusted by over 5 million users worldwide\n\nWE'VE ALL BEEN THERE\nYou set ambitious routines. You write them down, set alarms, and promise yourself tomorrow will be different — but life gets in the way. Without real-time guidance, even the best-planned routine falls apart. The problem was never your motivation. It was your tools.\n\nYOUR ROUTINE, ON AUTOPILOT\nRoutinery solves this with voice alerts (TTS) and push notifications that guide you through each task in real time. Think of it as a personal coach in your pocket — gently keeping you on track, one step at a time. No willpower required. Just press start.\n\nSTART IT, FOLLOW IT, FINISH IT\nTap play and let Routinery's timer walk you through your routine step by step. Pause, skip, adjust time, or add tasks on the fly — the experience adapts to you. When you're done, see exactly how your session went and watch your consistency grow over time.\n\nEVERYTHING YOU NEED TO STAY ON TRACK\n• Voice alerts & push notifications to guide each task hands-free\n• Flexible timer with pause, skip, auto-next, time adjustment, and white noise\n• Customizable timer screen — arrange it your way for total focus\n• Schedule routines by day of the week and time of day\n• 800+ emojis to design routines that feel uniquely yours\n• Daily, weekly, and monthly habit tracker with completion analytics\n• Plant badge reward system that grows with your streaks\n• Popular routines and celebrity routine recommendations to get started fast\n• Checklist widget to complete routines right from your home screen\n• Seamless support across phone, tablet, and smartwatch\n\nRE