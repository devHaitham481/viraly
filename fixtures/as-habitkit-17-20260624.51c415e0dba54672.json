ind\n\nEvoday helps you stay motivated and keep going, day after day.\n\n▶ FEATURES\n• Build good habits and break bad ones\n• Track your progress on beautiful grids and calendars\n• See your current streak, longest streak, and completion rates\n• Home Screen widgets: weekly calendar, monthly calendar, last 3 months, last 20 weeks, and more\n• Share beautifully formatted habit calendars\n• Export your data and keep your own backup\n• Your habit data never leaves your phone, except in your iCloud backups\n\n▶ MADE BY A SOLO DEVELOPER\nFeel free to send your questions, suggestions, or feature requests from inside the app.\nI read and answer them myself!\nKevin\n\nPrivacy Policy & Terms of Use: https://www.cosmictaps.com/evoday/privacy","rating":4.8,"ratingCount":"1.4K","buttonAction":{"title":"Get","presentationStyle":[],"actionMetrics":{"$kind":"ActionMetrics","data":[{"fields":{"reco_algoId":"cab_1","reco_eligible":"1","reco_hash":"cab_1","actionDetails":{"buyParams":"productType=C&price=0&salableAdamId=1403517519&pricingParameters=STDQ&pg=default&appExtVrsId=886194469"},"location":[{"locationPosition":0,"locationType":"button","name":"Get","reco_algoId":"cab_1","reco_eligible":"1","reco_hash":"cab_1","idType":"its_id","id":"1403517519","variantId":"default","experimentId":"fe2250a3-62af-47a3-93bc-059ab6af1969","experimentLocale":"en-US"},{"locationPosition":2,"locationType":"lockup","name":"Habit Tracker - Evoday","reco_algoId":"cab_1","reco_eligible":"1","reco_hash":"cab_1","idType":"its_id","id":"1403517519","variantId":"default","experimentId":"fe2250a3-62af-47a3-93bc-059ab6af1969","experimentLocale":"en-US"},{"locationPosition":12,"locationType":"similarItems","name":"You Might Also Like","idType":"relationship","id":"customers-also-bought-apps"}],"jet_adamId":"1403517519","eventType":"click","targetType":"button","targetId":"1403517519","platformContext":"iphone","alt_ab2_data":"[]"},"includingFields":["impressionsSnapshot","pageFields","contentRestrictionReas