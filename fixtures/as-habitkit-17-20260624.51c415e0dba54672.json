4c.376-1.049.161-1.882-.78-2.527L8.613 27.341c-.134-.08-.161-.134-.134-.215.027-.08.08-.08.242-.08l16.26.295c1.103.027 1.802-.43 2.151-1.532l4.677-15.562c.027-.162.08-.215.134-.215.08 0 .135.053.162.215l4.676 15.562c.35 1.102 1.048 1.559 2.15 1.532l16.261-.296c.162 0 .216 0 .243.081.027.08-.027.134-.135.215l-13.385 9.246c-.94.645-1.156 1.478-.78 2.527l5.35 15.374c.026.161.053.188 0 .242-.055.08-.135.026-.243-.054l-12.928-9.864c-.86-.672-1.855-.672-2.715 0l-12.928 9.864c-.107.08-.188.134-.242.054Z"></path></svg> </li> </ol></div></div> <div class="review-header svelte-1nf834u"><time class="date svelte-1nf834u" datetime="2025-07-25T12:39:34.000Z">07/25/2025</time>  <div class="multiline-clamp svelte-1r39353" style="--mc-lineClamp: var(--defaultClampOverride, 1);" role="text"> <span class="multiline-clamp__text svelte-1r39353"><span class="author svelte-1nf834u">smartraccoon1111</span></span> </div></div></div> <p><!-- HTML_TAG_START -->This is by far the most visually appealing app. I was actually going to develop my own app which was similar to this, where it had the altair heatmap chart. But this goes beyond my initial idea and also has step counts/tiered counting. Moreover, the ease of completing a task with a tap, setting of reminders, color coding and the availability to switch between three different views is exactly what I needed.This is way better than todoist, it is simple and intuitive. Most other apps have a lot of clutter and have too many details and clunky interfaces.One important feature that is missing though is its integration with Calendar and Reminders. Not just that, PLEASE expose APIs to interact with the data, this would have a limited use case, but still could be very useful. For example, one could ingest their daily step count and automatically mark a habit. Another example is that say if I want to block a particular app unless I do X, it could allow it to do so. Lets say that I have a habit like “no scrolling videos in the morning for 2 hours”, I should be able to enforce this and mark the habit only when certain conditions outside the app are met - I know this is a little outside the scope of this app and probably would fit into another “habit enforcer” app that could integrate with this, but in any case this requires REST APIs to be exposed. I would love to partner with the dev and work on this idea.<!-- HTML_TAG_END --> </p></div> </div> </div> </dialog> </div></li>   <li class="shelf-grid__list-item svelte-13b6ljx" data-test-id="shelf-grid-list-item-2" data-index="2" aria-hidden="true"><div class="svelte-13b6ljx"><div class="container svelte-1nf834u" aria-labelledby="review-11526306665-title" dir="ltr"><div class="header svelte-1nf834u"><div class="title-and-rating-container svelte-1nf834u"> <div class="multiline-clamp svelte-1r39353" style="--mc-lineClamp: var(--defaultClampOverride, 1);" role="text"> <span class="multiline-clamp__text svelte-1r39353"><h3 id="review-11526306665-title" class="title svelte-1nf834u">Great Simple App, Great Developer, Some Limitations</h3></span> </div> <div style="display: contents; --fill-color:var(--systemOrange); --star-size:12px;"><ol class="stars svelte-1fdd9o7" aria-label="5 Stars"><li class="star svelte-1fdd9o7"><svg class="icon" viewBox="0 0 64 64"><path d="M13.559 60.051c1.102.86 2.5.565 4.166-.645l14.218-10.455L46.19 59.406c1.666 1.21 3.037 1.505 4.166.645 1.102-.833 1.344-2.204.672-4.166l-5.618-16.718 14.353-10.32c1.666-1.183 2.338-2.42 1.908-3.764-.43-1.29-1.693-1.935-3.763-1.908l-17.605.108-5.348-16.8C34.308 4.496 33.34 3.5 31.944 3.5c-1.372 0-2.34.995-2.984 2.984L23.61 23.283l-17.605-.108c-2.07-.027-3.333.618-3.763 1.908-.457 1.344.242 2.58 1.909 3.763l14.352 10.321-5.617 16.718c-.672 1.962-.43 3.333.672 4.166Z"></path></svg> </li><li class="star svelte-1fdd9o7"><svg class="icon" viewBox="0 0 64 64"><path d="M13.559 60.051c1.102.86 2.5.565 4.166-.645l14.218-10.455L46.19 59.406c1.666 1.21 3.037 1.505 4.166.645 1.102-.833 1.344-2.204.672-4.166l-5.618-16.718 14.353-10.32c1.666-1.183 2.338-2.42 1.908-3.764-.43-1.29-1.693-1.935-3.763-1.908l-17.605.108-5.348-16.8C34.308 4.496 33.34 3.5 31.944 3.5c-1.372 0-2.34.995-2.984 2.984L23.61 23.283l-17.605-.108c-2.07-.027-3.333.618-3.763 1.908-.457 1.344.242 2.58 1.909 3.763l14.352 10.321-5.617 16.718c-.672 1.962-.43 3.333.672 4.166Z"></path></svg> </li><li class="star svelte-1fdd9o7"><svg class="icon" viewBox="0 0 64 64"><path d="M13.559 60.051c1.102.86 2.5.565 4.166-.645l14.218-10.455L46.19 59.406c1.666 1.21 3.037 1.505 4.166.645 1.102-.833 1.344-2.204.672-4.166l-5.618-16.718 14.353-10.32c1.666-1.183 2.338-2.42 1.908-3.764-.43-1.29-1.693-1.935-3.763-1.908l-17.605.108-5.348-16.8C34.308 4.496 33.34 3.5 31.944 3.5c-1.372 0-2.34.995-2.984 2.984L23.61 23.283l-17.605-.108c-2.07-.027-3.333.618-3.763 1.908-.457 1.344.242 2.58 1.909 3.763l14.352 10.321-5.617 16.718c-.672 1.962-.43 3.333.672 4.166Z"></path></svg> </li><li class="star svelte-1fdd9o7"><svg class="icon" viewBox="0 0 64 64"><path d="M13.559 60.051c1.102.86 2.5.565 4.166-.645l14.218-10.455L46.19 59.406c1.666 1.21 3.037 1.505 4.166.645 1.102-.833 1.344-2.204.672-4.166l-5.618-16.718 14.353-10.32c1.666-1.183 2.338-2.42 1.908-3.764-.43-1.29-1.693-1.935-3.763-1.908l-17.605.108-5.348-16.8C34.308 4.496 33.34 3.5 31.944 3.5c-1.372 0-2.34.995-2.984 2.984L23.61 23.283l-17.605-.108c-2.07-.027-3.333.618-3.763 1.908-.457 1.344.242 2.58 1.909 3.763l14.352 10.321-5.617 16.718c-.672 1.962-.43 3.333.672 4.166Z"></path></svg> </li><li class="star svelte-1fdd9o7"><svg class="icon" viewBox="0 0 64 64"><path d="M13.559 60.051c1.102.86 2.5.565 4.166-.645l14.218-10.455L46.19 59.406c1.666 1.21 3.037 1.505 4.166.645 1.102-.833 1.344-2.204.672-4.166l-5.618-16.718 14.353-10.32c1.666-1.183 2.338-2.42 1.908-3.764-.43-1.29-1.693-1.935-3.763-1.908l-17.605.108-5.348-16.8C34.308 4.496 33.34 3.5 31.944 3.5c-1.372 0-2.34.995-2.984 2.984L23.61 23.283l-17.605-.108c-2.07-.027-3.333.618-3.763 1.908-.457 1.344.242 2.58 1.909 3.763l14.352 10.321-5.617 16.718c-.672 1.962-.43 3.333.672 4.166Z"></path></svg> </li> </ol></div></div> <div class="review-header svelte-1nf834u"><time class="date svelte-1nf834u" datetime="2024-07-23T16:44:59.000Z">07/23/2024</time>  <div class="multiline-clamp svelte-1r39353" style="--mc-lineClamp: var(--defaultClampOverride, 1);" role="text"> <span class="multiline-clamp__text svelte-1r39353"><span class="author svelte-1nf834u">LegendaryPink</span></span> </div></div></div> <div class="content svelte-1nf834u">  <div class="truncate-wrapper svelte-1b6lxg0"><p data-testid="truncate-text" dir="auto" class="content svelte-1b6lxg0" style="--lines: 3; --line-height: var(--lineHeight, 16); --link-length: 4;"><!-- HTML_TAG_START -->I really love how simple and easy this app is to use. The pricing is also extremely reasonable for $0.99 when most apps charge way more just for some basic functions. I think it would be great if we would were able to create our own account so we can sync progress across different devices. I have ADHD and this app really helps me stay motivated and manage my executive dysfunction because I have to gamify EVERYTHING just to do simple things. I like how we are able to select different days for when we want to track a habit, but I wish we could select different reminder times for different days as well under the same habit. Say you want to add a yoga habit for each day, but want reminders at 2:00pm on certain days and 3:00pm on other days for those with varying schedules. I also think sub-habit/task would be an interesting game changer. Say you’re trying to incorporate an entire morning routine habit, you can just label the habit morning routine, and you can click it to open, add a sub-habit/task, like make bed, brush teeth, do skin care, and once you check off all three of those things, it will complete that habit for the day. I feel like this would help with lessening the amount of habits you have to make when one habit can incorporate many things you want to do!<!-- HTML_TAG_END --></p> </div>  <div class="developer-response-container svelte-1nf834u"><span class="developer-response-heading svelte-1nf834u">Developer Response</span>   <div class="truncate-wrapper svelte-1b6lxg0"><p data-testid="truncate-text" dir="auto" class="content svelte-1b6lxg0" style="--lines: 1; --line-height: var(--lineHeight, 16); --link-length: 4;"><!-- HTML_TAG_START -->Hey there,Thank you so much for the awesome review and your feedback. I am currently working on a cross-device sync functionality and hope to release it this year!More reminder/notification configuration options are also on the roadmap and will be implemented with a future version of the app.Ultimately, some form of "categories" will come with the next big update, so very soon. Stay tuned for that.Thanks for the great points!<!-- HTML_TAG_END --></p> </div> </div></div></div>  <dialog data-testid="dialog" class="svelte-1p01z7" id="" aria-hidden="true"><div data-testid="content-modal" class="content-modal-container svelte-1ih6d3u" dir="auto"><div class="button-container svelte-1ih6d3u"><button data-testid="content-modal-close-button" class="close-button svelte-1ih6d3u" type="button" aria-label="Close"><svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true" data-testid="content-modal-close-button-svg"><path d="M1.2 18C.6 18 0 17.5 0 16.8c0-.4.1-.6.4-.8l7-7-7-7c-.3-.2-.4-.5-.4-.8C0 .5.6 0 1.2 0c.3 0 .6.1.8.3l7 7 7-7c.2-.2.5-.3.8-.3.6 0 1.2.5 1.2 1.2 0 .3-.1.6-.4.8l-7 7 7 7c.2.2.4.5.4.8 0 .7-.6 1.2-1.2 1.2-.3 0-.6-.1-.8-.3l-7-7-7 7c-.2.1-.5.3-.8.3z"></path></svg></button> </div> <div class="header-container svelte-1ih6d3u"><h1 data-testid="content-modal-title" class="title svelte-1ih6d3u">Great Simple App, Great Developer, Some Limitations</h1> </div> <div class="content-container svelte-1ih6d3u"><div class="container svelte-1nf834u is-detail-view" aria-labelledby="review-11526306665-title" dir="ltr"><div class="header svelte-1nf834u"><div class="title-and-rating-container svelte-1nf834u"> <div s