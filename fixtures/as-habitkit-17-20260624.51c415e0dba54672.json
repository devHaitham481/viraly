 you want and restore it at a later point of time.\n\nPRIVACY FOCUSED\nAll your data belongs to you and stays on your phone. No sign-in. No servers. No cloud.\n\n---\n\nTerms of Use: https://www.habitkit.app/tos/\nPrivacy Policy: https://www.habitkit.app/privacy/","mediaType":"text/plain","style":"standard","alignment":"localized","isCollapsed":true,"suppressVerticalMargins":false,"wantsCollapsedNewlines":true},"developerAction":{"title":"Sebastian Roehl","presentationStyle":[],"actionMetrics":{"$kind":"ActionMetrics","data":[{"fields":{"actionType":"navigate","actionUrl":"https://apps.apple.com/us/developer/sebastian-roehl/id1602956482","location":[{"locationPosition":0,"locationType":"button","name":"Sebastian Roehl","idType":"its_id","id":"1602956482"}],"eventType":"click","targetType":"button","targetId":"1602956482","platformContext":"iphone","alt_ab2_data":"[]"},"includingFields":["impressionsSnapshot","pageFields","contentRestrictionReasons"],"excludingFields":["amsMetricsID"],"topic":"xp_amp_appstore_unidentified","shouldFlush":false}],"custom":{}},"$kind":"flowAction","actionClass":"FlowAction","page":"page","pageUrl":"https://apps.apple.com/us/developer/sebastian-roehl/id1602956482","pageData":null,"presentationContext":"infer","animationBehavior":"infer","origin":"inapp","destination":{"storefront":"us","language":"en-US","id":"1602956482","$kind":"DeveloperPageIntent"}},"tags":[],"developerLinks":[{"$kind":"ProductPageLink","text":"Website","clickAction":{"presentationStyle":[],"actionMetrics":{"$kind":"ActionMetrics","data":[],"custom":{}},"$kind":"ExternalUrlAction","actionClass":"ExternalUrlAction","url":"https://www.habitkit.app","isSensitive":false},"systemImageName":"safari"},{"$kind":"ProductPageLink","text":"Support","clickAction":{"presentationStyle":[],"actionMetrics":{"$kind":"ActionMetrics","data":[],"custom":{}},"$kind":"ExternalUrlAction","actionClass":"ExternalUrlAction","url":"https://www.habitkit.app/contact/","isSensitive":false},"syste