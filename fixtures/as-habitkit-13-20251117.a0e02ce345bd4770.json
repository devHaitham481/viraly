x":null,"imageName":null},"failureAction":null,"adamId":"6443918070"}},"productAction":{"impressionMetrics":null,"title":"Habit Tracker - HabitKit","artwork":null,"presentationStyle":[],"actionClass":"FlowAction","$kind":"flowAction","actionMetrics":{"data":[],"custom":{}},"page":"product","pageUrl":"https://apps.apple.com/us/app/6443918070?platform=iphone","pageData":null,"presentationContext":"infer","animationBehavior":"infer","origin":"inapp","destination":{"storefront":"us","language":"en-US","$kind":"ProductPageIntent","id":"6443918070","platform":"iphone"}},"writeReviewAction":{"impressionMetrics":null,"title":"Write a Review","artwork":{"checksum":null,"backgroundColor":null,"textColor":null,"style":null,"crop":"bb","contentMode":null,"imageScale":null,"template":"systemimage://square.and.pencil","width":0,"height":0,"variants":[{"format":"jpeg","quality":70,"supportsWideGamut":false}]},"presentationStyle":[],"actionClass":"FlowAction","$kind":"flowAction","actionMetrics":{"data":[],"custom":{}},"page":"writeReview","pageUrl":"?id=6443918070","pageData":"6443918070","presentationContext":"presentModal","animationBehavior":"infer","origin":"inapp"},"supportAction":{"impressionMetrics":null,"title":"App Support","artwork":null,"presentationStyle":[],"actionClass":"ExternalUrlAction","$kind":"ExternalUrlAction","actionMetrics":{"data":[],"custom":{}},"url":"https://www.habitkit.app/contact/","isSensitive":false},"alwaysAllowReviews":false}],"url":null,"mergeWhenFetched":false,"fetchStrategy":"onPageLoad","batchGroup":null,"seeAllAction":null,"footerTitle":null,"footerAction":null,"eyebrow":null,"eyebrowArtwork":null,"footerStyle":null,"title":"Ratings & Reviews","titleArtwork":null,"subtitle":null,"isHorizontal":false,"isHidden":false,"rowsPerColumn":null,"background":{"type":"none"},"contentsMetadata":{"type":"none"},"isPersonalized":false,"shouldFilterApps":false},{"impressionMetrics":{"fields":{"id":"23","name":"","impressionType":"ratingsDetails","idType":"sequential","impressionIndex":2}},"contentType":"reviews","marker":null,"items":[{"impressionMetrics":null,"id":"12150441065","title":"Almost perfect","date":"2025-01-06T04:03:56.000Z","dateText":"* null *","contents":"I’ve tried a few habit apps, and absolutely love using this one so far. The user experience is extremely intuitive and easy to use, and has (almost) all the features I was looking for. Just as an example, the Shortcuts integration is great for me - I was able to integrate HabitKit into an existing Shortcut I was using for recording a daily journal, and so now recording one will also automatically mark the habit complete for the day too. The widgets are really nice too and improve the overall interaction.\n\nAll that said, there are just a few additional features I’d like to see. First, a MacOS version of the app would be great, though I can confirm that it does work to install the iOS version. However, it would really be awesome if it could sync to iCloud both to make this actually usable, as well as to make it easy when you get a new device. There is an export / import feature for this but this would make it a lot. Lee seamless. Finally, it would be nice to have additional Shortcuts support - the ability to look at past completions / streaks, change completion for other dates, export / import from Shortcut, etc.\n\nWith that list, why did I still give it 5 stars? Because even as-is it is incredibly useful and I would recommend it to everyone even without these features (though they would be great!)","rating":5,"reviewerName":"cognitive gears","dateAuthorText":"* null * · cognitive gears","response":{"id":"49799617","contents":"Hey! Thanks for the awesome review and your feedback. Mac support and cross-device sync are on the roadmap!\nI really appreciate that you still rated it 5 stars even though it doesn't have every feature you wish for!","date":"2025-01-20T14:06:50.000Z","dateText":"* null *"},"flowPreviewActionsConfiguration":null},{"impressionMetrics":null,"id":"11526306665","title":"Great Simple App, Great Developer, Some Limitations","date":"2024-07-23T16:44:59.000Z","dateText":"* null *","contents":"I really love how simple and easy this app is to use. The pricing is also extremely reasonable for $0.99 when most apps charge way more just for some basic functions. I think it would be great if we would were able to create our own account so we can sync progress across different devices. \n\nI have ADHD and this app really helps me stay motivated and manage my executive dysfunction because I have to gamify EVERYTHING just to do simple things. I like how we are able to select different days for when we want to track a habit, but I wish we could select different reminder times for different days as well under the same habit. Say you want to add a yoga habit for each day, but want reminders at 2:00pm on certain days and 3:00pm on other days for those with varying schedules.\n\n I also think sub-habit/task would be an interesting game changer. Say you’re trying to incorporate an entire morning routine habit, you can just label the habit morning routine, and you can click it to open, add a sub-habit/task, like make bed, brush teeth, do skin care, and once you check off all three of those things, it will complete that habit for the day. I feel like this would help with lessening the amount of habits you have to make when one habit can incorporate many things you want to do!","rating":5,"reviewerName":"LegendaryPink","dateAuthorText":"* null * · LegendaryPink","response":{"id":"45648942","contents":"Hey there,\n\nThank you so much for the awesome review and your feedback. I am currently working on a cross-device sync functionality and hope to release it this year!\nMore reminder/notification configuration options are also on the roadmap and will be implemented with a future version of the app.\nUltimately, some form of \"categories\" will come with the next big update, so very soon. Stay tuned for that.\n\nThanks for the great points!","date":"2024-07-31T09:05:58.000Z","dateText":"* null *"},"flowPreviewActionsConfiguration":null},{"impressionMetrics":null,"id":"11196441680","title":"Fantastic Habit Tracker from a Responsive Developer","date":"2024-04-24T19:09:15.000Z","dateText":"* null *","contents":"The app is an intuitive, visually pleasing way to track your habits. It does a great job of allowing users to customize their habits while not crowding the ui or creating a convoluted user experience. Overall, it is a near-perfect habit tracker with a nice minimalist aesthetic\n\nAlso, the developer shows a lot of respect for the users of the app. I wrote to them regarding some functionality that I was hoping they would add and they quickly wrote back to let me know they were working on that. A couple months later they reached out to let me know they were rolling out that feature! In my experience, it is hard to find a developer that is so genuinely responsive to user feedback\n\nLastly, the app, which does have a premium option, makes the non-premium version actually worthwhile to use and offers the premium version via both subscription and one-time-purchase. Both of those are big pluses in my book!","rating":5,"reviewerName":"AngletonReviews","dateAuthorText":"* null * · AngletonReviews","response":{"id":"44884920","contents":"Thank you so much for the awesome review, I really appreciate your support and am happy that you like my app and development!","date":"2024-06-27T10:11:28.000Z","dateText":"* null *"},"flowPreviewActionsConfiguration":null},{"impressionMetrics":null,"id":"11999151976","title":"10/10 Customer Satisfaction","date":"2024-11-27T21:40:05.000Z","dateText":"edited * null *","contents":"If you’re looking to change your life, “atomic habits” style, then you need this app. Not the other habit trackers.. you need this one. This one right here is the best. \n\nI honestly can’t remember what the free version is like because I saw the value of upgrading within a week of downloading.\n\nI’ve added HabitKit widgets all across my phone and not only have I see my productivity increase, but my lifestyle and mindset have greatly benefited from using this app. \n\nIf Apple were to release a habit tracking app, it wouldn’t compare to this one. It’s sleek, easily customizable, and it’s just an overall better application compared to other habit trackers on the App Store.\n\nIf you’re NOT a fan of subscription based services, then THIS IS THE APP FOR YOU. I made a one time payment and this developer has continued to push out updates with an increasing attention to detail. The developer has helped me troubleshoot and they might even incorporate some of my feedback within future updates. \n\nIf you’re hesitant to buy their product, then think of it this way. Apple wants you to subscribe to their iCloud service indefinitely and the developer of this app only wants a one-time contribution from you. That’s it. You’re not renting this product, it is yours to keep. You receive all the future benefits without a monthly/yearly recurring charge to your bank.","rating":5,"reviewerName":"Nico.Baga","dateAuthorText":"edited * null * · Nico.Baga","response":{"id":"44827084","contents":"Thanks for the awesome review! Happy that you like the new widgets!","date":"2024-06-25T09:29:39.000Z","dateText":"* null *"},"flowPreviewActionsConfiguration":null},{"impressionMetrics":null,"id":"9475276997","title":"The Ultimate Habit Tracking App!","date":"2023-01-05T21:22:57.000Z","dateText":"* null *","contents":"I absolutely love HabitKit! It is by far the best habit tracking app I have ever used. The tile-based grid charts make it super easy to visualize my progress, and the customization options for the dashboard are a great touch. The ability to choose my own colors, icons, and descriptions really helps me to personalize the app to my own needs and goals.\n\nOne of the things I love most about HabitKit is the motivation it provides. Seeing the tiles on my dashboard fill up with color as I complete my habits is a great way to stay motivated and on track. The app is also very user-friendly and easy to navigate. I highly recommend HabitKit to anyone looking to form new habits or break old ones.\n\nOverall, I would give HabitKit a solid 5 out of 5 stars. It has truly made a difference in my life and I am so grateful to have found it. Thank you, Sebastian, for creating such a wonderful app!","rating":5,"reviewerName":"Chevy Phillip","dateAuthorText":"* null * · Chevy Phillip","response":{"id":"34150130","contents":"Thank you so much for taking the time to review HabitKit and for sharing your experience! I appreciate your support and am grateful that you have chosen to use HabitKit. Thank you for your review, and I hope you continue to find success with the app.","date":"2023-01-08T08:18:03.000Z","dateText":"* null *"},"flowPreviewActionsConfiguration":null},{"impressionMetrics":null,"id":"9474887392","title":"The Ultimate Habit Tracking App!","date":"2023-01-05T18:44:20.000Z","dateText":"* null *","contents":"I absolutely love HabitKit. It is by far the best habit tracking app I have ever used. The tile-based grid charts make it super easy to visualize my progress, and the customization options for the dashboard are a great touch. The ability to choose my own colors, icons, and descriptions really helps me to personalize the app to my own needs and goals.\n\nOne of the things I love most about HabitKit is the motivation it provides. Seeing the tiles on my dashboard fill up with color as I complete my habits is a great way to stay motivated and on track. The app is also very user-friendly and easy to navigate. I highly recommend HabitKit to anyone looking to form new habits or break old ones.\n\nOverall, I would give HabitKit a solid 5 out of 5 stars. It has truly made a difference in my life and I am so grateful to have found it. Thank you, for creating such a wonderful app!","rating":5,"reviewerName":"Chevy Phillip","dateAuthorText":"* null * · Chevy Phillip","flowPreviewActionsConfiguration":null},{"impressionMetrics":null,"id":"9859117108","title":"Effective and Motivating Habit Tracker!","date":"2023-04-25T10:34:34.000Z","dateText":"* null *","contents":"As someone who has always struggled with maintaining consistency in my daily habits, I have tried numerous habit tracking apps in the past. However, none of them have managed to motivate and engage me as much as HabitKit! This app has completely transformed my approach to habit tracking and has helped me build lasting habits that I can finally stick to.\n\nThe daily notifications are a gentle but effective reminder to complete my habits, making it nearly impossible to forget or procrastinate. The best part, though, is the GitHub contribution-style chart that visually represents my progress. This brilliant feature has turned habit tracking into an exciting game, where I eagerly work to maintain my streak and fill in the chart.\n\nThe interface is clean, intuitive, and user-friendly, allowing me to easily add, edit, and manage my habits. The customization options are also impressive, enabling me to tailor the notifications and chart according to my preferences.\n\nHabitKit has not only helped me stay consistent in my daily routines but has also significantly improved my productivity and overall well-being. I am genuinely grateful for this app and highly recommend it to anyone looking to build and maintain healthy habits. Give HabitKit a try, and I promise you won't be disappointed!","rating":5,"reviewerName":"upsetti with this spagetti","dateAuthorText":"* null * · upsetti with this spagetti","response":{"id":"36222346","contents":"Thank you very much! It really means a lot to me that you've taken the time to write such an extensive review of my app. I'm really glad that the app had a positive effect on your life and I hope you'll stick with all the habits you created.\n\nThanks again and all the best, Sebastian","date":"2023-04-28T09:12:29.000Z","dateText":"* null *"},"flowPreviewActionsConfiguration":null},{"impressionMetrics":null,"id":"12458258118","title":"The only habit tracker that makes me feel good!","date":"2025-03-24T11:08:49.000Z","dateText":"* null *","contents":"I have tried many habit trackers but this is the only one that doesn't give me so much anxiety and stress when I miss my streaks. A lot of the other ones try to hold you accountable and stick to goals. While I do wanna do that, some days just make it hard and my busy schedule makes it hard to keep up with everything. HabitKit on the other hand lets you actually just keep tabs on your progress. Yes, maybe you missed a day or week, but you can always see your previous progress and remind yourself that you can still make it up and catch up! It's no surprise that other apps are copying this now! Sebastian's also a really responsive and friendly founder! Really happy to get to support this project!","rating":5,"reviewerName":"aescay","dateAuthorText":"* null * · aescay","response":{"id":"55585720","contents":"Thanks for the awesome review, I really really appreciate it!","date":"2025-09-11T11:57:53.000Z","dateText":"* null *"},"flowPreviewActionsConfiguration":null}],"url":null,"mergeWhenFetched":false,"fetchStrategy":"onPageLoad","batchGroup":null,"seeAllAction":null,"footerTitle":null,"footerAction":null,"eyebrow":null,"eyebrowArtwork":null,"footerStyle":null,"title":null,"titleArtwork":null,"subtitle":null,"isHorizontal":false,"isHidden":false,"rowsPerColumn":null,"background":{"type":"none"},"contentsMetadata":{"type":"none"},"isPersonalized":false,"shouldFilterApps":false,"id":"ReviewsPage.ShelfId.helpful","presentationHints":{"isSortable":true,"isSeeAllContext":true}}],"title":null,"presentationOptions":[],"isIncomplete":false,"pageMetrics":{"instructions":[],"custom":{}},"trailingNavBarAction":null,"adamId":"6443918070","nextPage":{"url":"x-as3-internal:/reviews/shelf/6443918070/helpful","remainingContent":[],"nextHref":